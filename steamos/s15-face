#!/bin/bash
# Face unlock (Biopass, docs/login.md#face-unlock): the PAM gate in front of Biopass and small helpers.
#
# PAM (pam_exec lines that steamos/login-lock.sh adds while face unlock is installed; the runs themselves, when they
# may look and what counts, are in s15-face-run):
#   s15-face pam-empty    SDDM, auth, expose_authtok: face only when Enter is pressed on an empty password field, so
#                         a typed password or PIN never waits for the camera; then the gate
#   s15-face pam-gate     sudo/polkit if turned on (install-face.sh admin on): the gate
#   s15-face pam-scan     SDDM, sudo/polkit, after the gate: one run (s15-face-run scan)
#   s15-face pam-watch    the lock screen (kde-fingerprint): starts with the lock screen's first key press (or
#                         s15-face-wake's), looks whenever the display is on, until a match (s15-face-run watch)
#   s15-face pam-rescan   the lock screen's password service (kde), expose_authtok: Enter on the empty field asks the
#                         watch for a new run and fails at once (no password check, so it never counts towards the
#                         password lockout); anything typed goes on to the PIN and password checks
#   s15-face pam-ok       the lock screen, after a face or password unlock: reset the count of false faces
#   s15-face pam-account  SDDM, account phase (root): a login succeeded; the count of false faces starts again
# The gate lets Biopass run only with an IR camera and a minimum face size in the user's Biopass settings (without
# the IR camera a photo on a phone could pass, without the size a face across the room), not while pam_faillock
# locks the account, and counts false faces (faces seen that did not match, or that anti-spoofing flagged) since the
# last success as the PIN counts wrong PINs: waits after 6, off after 15 until the next password or PIN login or
# unlock (or s15-face reset). The count is root's and survives restarts, so face works at the first login after a
# boot too; the numbers are root's (s15-face lockout). Runs look only while the display is on and the lid open
# (s15-face-run).
#
#   s15-face status [user]
#   s15-face reset [user]               (root) clear the count of false faces and the wait
#   s15-face lockout                    the lockout numbers in effect, as KEY=VALUE lines (/etc/s15-face.conf, else
#                                       the defaults); s15-face lockout keys: KEY DEFAULT MIN MAX UNIT MEANING
#   s15-face lockout set KEY VALUE      (root) set one (whole numbers within MIN..MAX); prints the new values
#   s15-face lockout reset-defaults     (root) all back to the defaults
#   s15-face camera ir|rgb|both [user]  set the cameras in the user's Biopass configuration (Biopass app closed;
#                                       without one yet, Biopass's defaults are written first), with the minimum
#                                       face size and threshold below where the settings have none or a looser one:
#                                       ir: the IR camera recognises, in the dark too (default);
#                                       rgb: the colour camera recognises, the IR camera checks presence;
#                                       both: the colour and the IR camera each recognise, in one moment.
#                                       Enrolled faces stay with their camera: faces/ holds the main camera's (what
#                                       the app lists), faces-ir/ the IR camera's in rgb and both, faces-rgb/ the
#                                       colour camera's in ir; switching moves them
#   s15-face enrol [count]              (as yourself) add your face [count] times (default 5) with the camera set
#                                       above, through Biopass's helper (both: a colour and an IR picture each);
#                                       the app lists the main camera's under Saved Faces. The app's own "add face"
#                                       cannot pick the IR camera (it lists only /dev/video nodes, which both
#                                       cameras share)
#   s15-face antispoof on|off [user]    Biopass's AI anti-spoofing model on the colour picture (rgb and both; never
#                                       in ir: it is trained on colour images). Use this, not the app's settings
#                                       page: saving that page drops the settings above
#   s15-face check                      (as yourself) one face scan as the lock screen runs it, showing each step
#                                       (face size, match scores); not counted, display and lid not checked
#   s15-face snapshot ir|rgb [file]     one frame as Biopass sees it (default /tmp/s15-face-<camera>.png)
#   s15-face cameras                    the cameras as Biopass's libcamera lists them
set -u
export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin   # pam_exec passes only the PAM environment
RUN=/usr/local/sbin/s15-face-run
TOOL=/usr/lib/s15-face/camera_capture_test
CONF=.config/com.ticklab.biopass/config.yaml
DB=.config/com.ticklab.biopass/biopass.db
DATA=.local/share/com.ticklab.biopass
HELPER=/usr/bin/biopass-helper
# Written by `camera` where the settings have none (or a looser one), see docs/login.md#face-unlock: the face box's
# minimum height as a fraction of the picture's height (sitting in front of the laptop: 0.29-0.47 in IR, 0.44-0.60
# in colour; 0.2 is about 1.5 times that distance in IR, a face across a room is about 0.1), and the recognition
# threshold (cosine similarity; Biopass's default 0.5).
MIN_FACE=0.2
MIN_THRESHOLD=0.6
log() { logger -t s15-face -p auth.notice -- "$*" 2>/dev/null || true; }
die() { echo "s15-face: $*" >&2; exit 1; }
valid_user() { [[ $1 =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; }
default_user() {
  local u
  u=$(cat /usr/lib/sddm/sddm.conf.d/*.conf /etc/sddm.conf.d/*.conf 2>/dev/null | sed -n 's/^User=//p' | tail -1)
  echo "${u:-steamos}"
}

cameras() {
  [ -x "$TOOL" ] || die "face unlock is not installed (steamos/install-face.sh install)"
  LD_LIBRARY_PATH=/usr/lib/biopass LIBCAMERA_LOG_LEVELS='*:ERROR' "$TOOL" --list-devices 2>/dev/null
}

# camera id of the IR sensor (HM1092, monochrome) or the colour sensor (OV02C10)
camera_id() {
  local model
  case $1 in ir) model=hm1092 ;; rgb) model=ov02c10 ;; *) die "ir or rgb" ;; esac
  cameras | awk -v m="$model" '/^  \[[0-9]+\] / { hit = index(tolower($0), m) > 0 }
                                hit && /^      id: / { print $2; exit }'
}

status() {
  local u=${1:-$(default_user)}
  valid_user "$u" || die "bad user name"
  "$RUN" state "$u"
  local home; home=$(getent passwd "$u" | cut -d: -f6)
  if [ -r "$home/$CONF" ]; then
    python3 -I - "$home/$CONF" <<'EOF'
import sys, yaml
c = yaml.safe_load(open(sys.argv[1])) or {}
f = (c.get("methods") or {}).get("face") or {}
a = f.get("anti_spoofing") or {}
cam, ir = f.get("camera"), a.get("ir_camera")
if f.get("camera_profiles"):
    mode = "camera profiles from the app (face refused: s15-face camera ir|rgb|both)"
elif not ir:
    mode = "no IR camera (face refused: s15-face camera ir|rgb|both)"
elif cam == ir:
    mode = "ir (the IR camera recognises)"
elif a.get("ir_recognition") is True:
    mode = "both (the colour and the IR camera each recognise)"
else:
    mode = "rgb (the colour camera recognises, the IR camera checks presence)"
size = (f.get("detection") or {}).get("min_face_height")
print(f"Biopass: face {'on' if f.get('enable', True) else 'off'}, mode {mode}")
print(f"  camera {cam or 'auto'}, IR camera {ir or 'none'}")
size = f"{size} of the picture's height" if size else "none (face refused)"
print(f"  minimum face height {size}, recognition threshold {(f.get('recognition') or {}).get('threshold')}, "
      f"AI anti-spoofing {'on' if a.get('enable') else 'off'}, {f.get('retries')} attempts")
EOF
  else
    echo "Biopass: not set up for $u yet (start the Biopass app once)"
  fi
  local d n out=""
  for d in faces faces-ir faces-rgb; do
    n=$(find "$home/$DATA/$d" -maxdepth 1 -type f 2>/dev/null | wc -l)
    [ "$d" = faces ] || [ "$n" -gt 0 ] && out+="${out:+, }$d/ $n"
  done
  echo "enrolled faces: $out"
}

reset() {
  local u=${1:-$(default_user)}
  [ "$(id -u)" = 0 ] || die "run as root (sudo)"
  valid_user "$u" || die "bad user name"
  "$RUN" reset "$u"
}

camera() {
  local mode=${1:-} u=${2:-$(default_user)} ir rgb home
  case $mode in ir|rgb|both) ;; *) die "usage: s15-face camera ir|rgb|both [user]" ;; esac
  valid_user "$u" || die "bad user name"
  ir=$(camera_id ir); rgb=$(camera_id rgb)
  [ -n "$ir" ] && [ -n "$rgb" ] || die "IR or colour camera not found ($(cameras | grep -c ' id: ') cameras listed)"
  home=$(getent passwd "$u" | cut -d: -f6)
  pgrep -u "$u" -x biopass >/dev/null && die "close the Biopass app first (it would write its own settings back)"
  local run=()
  [ "$(id -u)" = 0 ] && [ "$u" != root ] && run=(runuser -u "$u" --)
  "${run[@]}" python3 -I - "$home/$CONF" "$home/$DATA" "$mode" "$ir" "$rgb" "$MIN_FACE" "$MIN_THRESHOLD" \
    <<'EOF' || die "configuration not changed"
import os, sys, yaml
path, data, mode, ir, rgb, min_face, min_threshold = sys.argv[1:]
# The app writes config.yaml only when its settings are saved. Without one: Biopass 1.5.1's defaults
# (auth/test/config/defaults.yaml), which the helper reads as its own.
DEFAULTS = {
    "schema_version": 2,
    "strategy": {"debug": False, "execution_mode": "parallel", "order": ["face", "fingerprint"],
                 "ignore_services": ["polkit-1", "pkexec"]},
    "methods": {
        "face": {
            "enable": True, "retries": 5, "retry_delay": 200, "camera": None, "camera_profiles": [],
            "detection": {"model_id": "yolov8n-face", "threshold": 0.5},
            "recognition": {"model_id": "edgeface-s-gamma-05", "threshold": 0.5},
            "anti_spoofing": {"enable": False, "model": {"model_id": "mobilenetv3-antispoof", "threshold": 0.8},
                              "ir_camera": None, "ir_warmup_delay_ms": 300, "ir_presence_timeout_ms": 1500},
        },
        "fingerprint": {"enable": False, "retries": 1, "timeout": 5000},
    },
    "appearance": "system",
}
def number(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool)
try:
    c = yaml.safe_load(open(path)) or {}
except FileNotFoundError:
    c = DEFAULTS
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
if "schema_version" not in c:   # only "appearance" (the app's theme picker): the helper would ignore the file
    c = {**DEFAULTS, **c}
face = c.setdefault("methods", {}).setdefault("face", {})
# faces/ holds the main camera's faces: the IR camera's if it was the main camera, else the colour camera's (the
# app's own "add face" and auto-select take the colour camera)
profiles = face.get("camera_profiles") or []
was_ir = face.get("camera") == ir or bool(profiles and isinstance(profiles[0], dict) and profiles[0].get("camera") == ir)
if profiles:
    # saving the app's settings page turns these settings into a profile, which would override them
    print("s15-face: camera profiles from the app removed (these settings replace them)")
    face["camera_profiles"] = []
anti = face.setdefault("anti_spoofing", {})
anti["ir_camera"] = ir
if mode == "ir":
    face["camera"] = ir
    # the anti-spoofing models are trained on colour images; on IR frames they only reject real faces at random
    anti["enable"] = False
else:
    face["camera"] = rgb
# both: the IR camera recognises too (faces-ir/), instead of only checking that it sees a face
anti["ir_recognition"] = mode == "both"
det = face.setdefault("detection", {})
size = det.get("min_face_height")
if not (number(size) and 0 < size <= 1):
    det["min_face_height"] = float(min_face)
rec = face.setdefault("recognition", {})
if not (number(rec.get("threshold")) and rec["threshold"] >= float(min_threshold)):
    rec["threshold"] = float(min_threshold)
tmp = path + ".s15-face"
with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
    yaml.safe_dump(c, f, sort_keys=False)
os.replace(tmp, path)

# Enrolled faces stay with their camera: faces/ the main camera's (the app lists these), faces-ir/ the IR camera's
# while the colour camera is the main one, faces-rgb/ the colour camera's while the IR camera is.
def images(d):
    try:
        return sorted(n for n in os.listdir(d) if n.lower().endswith((".jpg", ".jpeg", ".png"))
                      and os.path.isfile(os.path.join(d, n)) and not os.path.islink(os.path.join(d, n)))
    except FileNotFoundError:
        return []
def move_all(src, dst):
    names = images(src)
    if names:
        os.makedirs(dst, mode=0o700, exist_ok=True)
    for n in names:
        stem, ext = os.path.splitext(n)
        to, i = os.path.join(dst, n), 1
        while os.path.exists(to):
            to, i = os.path.join(dst, f"{stem}-{i}{ext}"), i + 1
        os.rename(os.path.join(src, n), to)
    return len(names)
faces, faces_ir, faces_rgb = (os.path.join(data, d) for d in ("faces", "faces-ir", "faces-rgb"))
now_ir = mode == "ir"
if was_ir != now_ir:
    if now_ir:
        a, b = move_all(faces, faces_rgb), move_all(faces_ir, faces)
        moved = f"{a} colour faces faces/ -> faces-rgb/, {b} IR faces faces-ir/ -> faces/"
    else:
        a, b = move_all(faces, faces_ir), move_all(faces_rgb, faces)
        moved = f"{a} IR faces faces/ -> faces-ir/, {b} colour faces faces-rgb/ -> faces/"
    if a or b:
        print(f"moved {moved}")
print(f"mode: {mode}\ncamera: {face['camera']}\nIR camera: {ir}\nminimum face height: "
      f"{det['min_face_height']} of the picture's height\nrecognition threshold: {rec['threshold']}")
n_main, n_ir = len(images(faces)), len(images(faces_ir))
if mode == "ir":
    print(f"enrolled: {n_main} IR faces (faces/)")
elif mode == "rgb":
    print(f"enrolled: {n_main} colour faces (faces/)")
else:
    print(f"enrolled: {n_main} colour faces (faces/), {n_ir} IR faces (faces-ir/); both cameras need theirs")
EOF
  echo "Add faces as $u where none are enrolled for a camera: s15-face enrol (then: s15-face check)."
}

# Biopass's helper as the app runs it for "add face" (preview-session: READY, then CAPTURE <file> -> OK | NO_FACE |
# ERR), with the camera from the user's settings, so a libcamera id (the IR camera) works too. In both mode each
# picture is a pair, the colour camera's into faces/ and the IR camera's into faces-ir/, one camera after the other
# (they cannot stream at the same time).
enrol() {
  local count=${1:-5} home
  [[ $count =~ ^[1-9][0-9]?$ ]] || die "usage: s15-face enrol [count]"
  [ "$(id -u)" != 0 ] || die "run as yourself, not as root"
  [ -x "$HELPER" ] || die "face unlock is not installed (steamos/install-face.sh install)"
  home=$(getent passwd "$(id -un)" | cut -d: -f6)
  [ -f "$home/$CONF" ] || die "no camera set yet: sudo s15-face camera ir"
  python3 -I - "$home/$CONF" "$home/$DB" "$home/$DATA" "$HELPER" "$count" <<'EOF'
import os, select, sqlite3, subprocess, sys, time, yaml
conf, db, data, helper, count = sys.argv[1:]
face = ((yaml.safe_load(open(conf)) or {}).get("methods") or {}).get("face") or {}
cam = face.get("camera")
anti = face.get("anti_spoofing") or {}
if not cam or face.get("camera_profiles"):
    sys.exit("s15-face: no camera set (or camera profiles from the app): sudo s15-face camera ir|rgb|both")
both = anti.get("ir_recognition") is True and anti.get("ir_camera") and anti.get("ir_camera") != cam
cams = [(cam, os.path.join(data, "faces"), "colour camera" if both else "camera")]
if both:
    cams.append((anti["ir_camera"], os.path.join(data, "faces-ir"), "IR camera"))
mid = (face.get("detection") or {}).get("model_id", "yolov8n-face")
try:
    row = sqlite3.connect(f"file:{db}?mode=ro", uri=True).execute("select path from models where id = ?", (mid,)).fetchone()
except sqlite3.Error:
    row = None
if not row or not os.path.isfile(row[0]):
    sys.exit(f"s15-face: detection model {mid} not downloaded yet: open the Biopass app once (Models)")
for _, d, _ in cams:
    os.makedirs(d, mode=0o700, exist_ok=True)

class Session:
    """One preview-session of the helper on one camera."""
    def __init__(self, camera, label):
        self.label, self.buf = label, b""
        self.p = subprocess.Popen([helper, "preview-session", "--model", row[0], "--camera", camera],
                                  stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                  bufsize=0)
        r = self.reply(lambda l: l == "READY" or l.startswith("ERR"), 20)
        if r != "READY":
            self.close()
            sys.exit(f"s15-face: {label}: {r}")
    def reply(self, done, timeout):   # the next line done() accepts; the helper also prints log lines
        end = time.monotonic() + timeout
        while True:
            while b"\n" in self.buf:
                line, self.buf = self.buf.split(b"\n", 1)
                line = line.decode(errors="replace").strip()
                if done(line):
                    return line
            left = end - time.monotonic()
            if left <= 0 or not select.select([self.p.stdout], [], [], left)[0]:
                self.close()
                sys.exit(f"s15-face: {self.label}: the helper did not answer in time")
            chunk = os.read(self.p.stdout.fileno(), 65536)
            if not chunk:
                self.close()
                sys.exit(f"s15-face: {self.label}: the helper ended (camera in use? close the Biopass app)")
            self.buf += chunk
    def capture(self, path):
        self.p.stdin.write(f"CAPTURE {path}\n".encode())
        self.p.stdin.flush()
        return self.reply(lambda l: l in ("OK", "NO_FACE") or l.startswith("ERR"), 15)
    def close(self):
        try:
            self.p.stdin.write(b"QUIT\n"); self.p.stdin.flush()
            self.p.wait(2)
        except Exception:
            self.p.kill()
            self.p.wait()

n = int(count)
print("Opening the camera...")
single = None if both else Session(cams[0][0], cams[0][2])
try:
    if both:
        print(f"Look at the screen as you normally do. {n} pictures, each with the colour and then the IR camera")
    else:
        print(f"Look at the screen as you normally do. {n} pictures, one every 2 seconds")
    print("Between them turn your head a little (left, right, up, down), with and without glasses if you wear them.")
    saved = tries = 0
    while saved < n and tries < n * 3:
        tries += 1
        time.sleep(1 if both else 2)
        stamp = int(time.time() * 1000)
        done = []
        for camera, d, label in cams:
            path = os.path.join(d, f"face_{stamp}.jpg")
            s = single or Session(camera, label)
            try:
                r = s.capture(path)
            finally:
                if s is not single:
                    s.close()
            if r != "OK":
                print(f"  {label}: {'no face seen' if r == 'NO_FACE' else r}, again")
                break
            done.append(path)
        if len(done) < len(cams):
            for path in done:
                os.unlink(path)
            continue
        saved += 1
        print(f"  {saved}/{n} saved")
    total = ", ".join(f"{len(os.listdir(d))} in {os.path.basename(d)}/" for _, d, _ in cams)
    print(f"{saved} faces added ({total}). Try it: s15-face check, or lock the screen (Meta+L) and press Enter.")
finally:
    if single:
        single.close()
EOF
}

# One face scan as the lock screen runs it (Biopass's helper with the user's settings), with its steps on the
# terminal. Not counted; the gate's own checks (lockout, settings) are shown separately.
antispoof() {
  local on=${1:-} u=${2:-$(default_user)} home
  case $on in on|off) ;; *) die "usage: s15-face antispoof on|off [user]" ;; esac
  valid_user "$u" || die "bad user name"
  home=$(getent passwd "$u" | cut -d: -f6)
  [ -f "$home/$CONF" ] || die "no camera set yet: sudo s15-face camera both"
  pgrep -u "$u" -x biopass >/dev/null && die "close the Biopass app first (it would write its own settings back)"
  local run=()
  [ "$(id -u)" = 0 ] && [ "$u" != root ] && run=(runuser -u "$u" --)
  "${run[@]}" python3 -I - "$home/$CONF" "$on" <<'EOF' || die "configuration not changed"
import os, sys, yaml
path, on = sys.argv[1:]
c = yaml.safe_load(open(path)) or {}
face = (c.get("methods") or {}).get("face") or {}
anti = face.setdefault("anti_spoofing", {})
if on == "on" and face.get("camera") and face.get("camera") == anti.get("ir_camera"):
    sys.exit("s15-face: not in ir mode: the model is trained on colour images (s15-face camera both or rgb first)")
anti["enable"] = on == "on"
model = anti.setdefault("model", {})
if on == "on":
    # MiniFASNet V2, not Biopass's default MobileNetV3: on this colour camera's pictures (libcamera's software ISP)
    # MobileNetV3 took the real face for a spoof in 2 of 3 scans (scores 0.90, 0.97 at a threshold of 0.8);
    # MiniFASNet V2 passed it in 4 of 4
    model["model_id"] = "minifas-v2"
    model.setdefault("threshold", 0.8)
tmp = path + ".s15-face"
with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
    yaml.safe_dump(c, f, sort_keys=False)
os.replace(tmp, path)
print(f"AI anti-spoofing {on} ({model.get('model_id')}, threshold {model.get('threshold')})")
EOF
}

check() {
  local u out rc
  u=$(id -un)
  [ "$(id -u)" != 0 ] || die "run as yourself, not as root"
  [ -x "$HELPER" ] || die "face unlock is not installed (steamos/install-face.sh install)"
  "$RUN" state "$u" | sed -n 's/^  face now: refused: /Note: the lock screen refuses face now: /p'
  echo "Scanning (look at the screen; the camera light comes on)..."
  out=$("$HELPER" auth --username "$u" --verbose 2>&1 >/dev/null); rc=$?
  grep -E 'FaceAuth: (Face on|No face|Recognition (PASSED|FAILED)|The .* frame came|Recognised on both|Could not|Both cameras must|No face enrolled|Anti-spoofing failed|AI anti-spoofing (detected spoof|check passed)|IR presence check (PASSED|FAILED))|camera appears covered' \
    <<< "$out" | sed -E "s/^\[[0-9-]+ ([0-9:.]+)\] \[[a-z]+\] \[[a-z]+\] (FaceAuth: )?/\1 /; s/ \(NOTE:.*\)\$//;
                         s#face='[^']*/(faces[^/]*/[^']*)'#\1#"
  case $rc in
    0) echo "Result: recognised (the lock screen would unlock)" ;;
    2) echo "Result: face not tried (no settings, no enrolled faces or no camera; see above)" ;;
    *) echo "Result: not recognised" ;;
  esac
  return $rc
}

snapshot() {
  local which=${1:-} out id
  case $which in ir|rgb) ;; *) die "usage: s15-face snapshot ir|rgb [file]" ;; esac
  out=${2:-/tmp/s15-face-$which.png}
  id=$(camera_id "$which"); [ -n "$id" ] || die "$which camera not found"
  local grey=(); [ "$which" = ir ] && grey=(--grey)
  LD_LIBRARY_PATH=/usr/lib/biopass "$TOOL" "${grey[@]}" -o "$out" "$id" 2>&1 |
    grep -E 'Captured|Saved|rror|ailed|busy|use'
}

case "${1:-}" in
  pam-empty)
    # pam_exec expose_authtok: the field's value and a NUL on stdin; only an empty field may start a scan
    b=$(head -c 1 | od -An -tx1 | tr -d ' \n')
    [ -z "$b" ] || [ "$b" = 00 ] || exit 1
    exec "$RUN" gate ;;
  pam-gate) exec "$RUN" gate ;;
  pam-scan) exec "$RUN" scan ;;
  lockout) shift; exec "$RUN" lockout "$@" ;;
  pam-watch) exec "$RUN" watch ;;
  pam-rescan)
    b=$(head -c 1 | od -An -tx1 | tr -d ' \n')
    [ -z "$b" ] || [ "$b" = 00 ] || exit 1
    exec "$RUN" rescan ;;
  pam-ok) exec "$RUN" ok ;;
  pam-account) exec "$RUN" account ;;
  status) status "${2:-}" ;;
  reset) reset "${2:-}" ;;
  camera) camera "${2:-}" "${3:-}" ;;
  enrol|enroll) enrol "${2:-}" ;;
  antispoof) antispoof "${2:-}" "${3:-}" ;;
  check) check ;;
