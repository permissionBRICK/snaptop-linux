#!/bin/bash
# systemd-sleep hook (/usr/lib/systemd/system-sleep/s15-hibernate): what a hibernation needs on this laptop
# (docs/power.md#hibernation). Acts only on "hibernate" and only after `hibernate.sh enable` (/etc/s15-hibernate.conf).
#
# pre:
# 1. The image has to land where the boot entries' resume=/resume_offset= look for it. systemd-sleep has written
#    /sys/power/resume and resume_offset by now; if they differ from /etc/s15-hibernate.conf, the swap file is switched
#    off, so the kernel finds no swap device to write to and the hibernation is aborted (the system stays up).
# 2. The firmware starts Windows Boot Manager first. BootNext (the firmware's one-time entry; it survives a power-off)
#    is set to the entry this boot came from, and systemd-boot's one-shot entry to the running entry (the same kernel),
#    so the next power-on resumes SteamOS. A one-shot entry that was already set (a staged update) is put back later.
# 3. The image size limit is set to the memory in use (plus 256 MiB), so the page cache is dropped instead of saved.
# 4. The ADSP and CDSP are stopped. Their driver (qcom_q6v5_pas) has no hibernation callbacks, and the boot that
#    restores the image starts its own instances in the initramfs (s15-dsp); s15-hibernate-initrd stops those right
#    before the kernel hands over, so the restored system finds both stopped and starts them again in "post".
#    The CDSP goes first and comes back last: a DSP that changes state notifies the other one, and the CDSP never
#    answers (5 s timeouts each). Stopping the ADSP removes the sound card, which waits until PipeWire closed it, so
#    user sessions must not be frozen during the hooks (systemd-hibernate.service drop-in s15-no-freeze.conf).
#    s15-sleep-hook (running in parallel) reads the battery first: the ADSP provides it.
# 5. Bluetooth is unbound (its controller loses power and firmware; see below).
# post (after a resume, or after an aborted hibernation): after a power-off switch AOSS deep sleep off again, start the
# DSPs, bind Bluetooth again, remove a BootNext and one-shot entry that were not used, put a saved one-shot entry back,
# switch the swap file on again if step 1 switched it off.
[ "$2" = hibernate ] || exit 0
C=/etc/s15-hibernate.conf
[ -r $C ] || exit 0
. $C   # RESUME_DEV, RESUME_OFFSET, SWAPFILE
L=/var/log/s15-sleep.log; R=/run/s15-hibernate
G=4a67b082-0a4c-41cf-b6c7-440b29bb8c4f; V=/sys/firmware/efi/efivars; ONESHOT=$V/LoaderEntryOneShot-$G
log() { echo "$(date -Is) hibernate: $*" >> $L; }
efivars() { mountpoint -q $V || mount -t efivarfs efivarfs $V 2>/dev/null; }
efistr() { [ -r "$1" ] && tail -c +5 "$1" | tr -d '\0'; }    # systemd-boot's variables: UTF-16LE, ASCII here
set_oneshot() {   # one write() of attributes (NV, boot service, runtime) and the UTF-16LE string, like s15-os-update
    chattr -i "$ONESHOT" 2>/dev/null
    python3 -c 'import struct, sys
open(sys.argv[1], "wb").write(struct.pack("<I", 7) + (sys.argv[2] + "\0").encode("utf-16-le"))' "$ONESHOT" "$1"
}
clear_oneshot() { [ -e "$ONESHOT" ] && chattr -i "$ONESHOT" 2>/dev/null; rm -f "$ONESHOT"; }
dsp() { local r; for r in /sys/class/remoteproc/remoteproc*; do [ "$(cat "$r/name" 2>/dev/null)" = "$1" ] && echo "$r"; done; }
dsp_states() { local n s=; for n in adsp cdsp; do s="$s $n=$(cat "$(dsp $n)/state" 2>/dev/null)"; done; echo "${s# }"; }
since() { awk -v a="$1" -v b="$(date +%s.%N)" 'BEGIN { printf "%.1f", b - a }'; }
wait_running() {   # up to 20 s
    local _
    for _ in $(seq 100); do [ "$(cat "$1/state")" = running ] && return 0; sleep 0.2; done
    return 1
}

case "$1" in
  pre)
    t0=$(date +%s)
    rm -f $R.*
    want=$(printf '%d:%d' 0x"$(stat -L -c %t "$RESUME_DEV")" 0x"$(stat -L -c %T "$RESUME_DEV")")
    have=$(cat /sys/power/resume); hoff=$(cat /sys/power/resume_offset)
    if [ "$have" != "$want" ] || [ "$hoff" != "$RESUME_OFFSET" ]; then
        log "the kernel would write the image to $have page $hoff, the boot entries resume from $want page" \
            "$RESUME_OFFSET: aborting (swap file off)"
        swapoff "$SWAPFILE" && touch $R.swapoff
        exit 0
    fi
    efivars
    cur=$(efibootmgr 2>/dev/null | sed -n 's/^BootCurrent: //p')
    for _ in 1 2 3; do   # the write goes through the firmware's TrustZone service: read it back
        [ -n "$cur" ] || break
        efibootmgr -q -n "$cur" 2>/dev/null
        efibootmgr 2>/dev/null | grep -q "^BootNext: $cur" && { echo "$cur" > $R.bootnext; break; }
        sleep 1
    done
    [ -e $R.bootnext ] || log "WARNING: BootNext not set (BootCurrent '$cur'): the next power-on starts Windows"
    sel=$(efistr $V/LoaderEntrySelected-$G)
    # Tests: /run/s15-hibernate-entry names another entry with the same kernel (e.g. one without "quiet").
    [ -s /run/s15-hibernate-entry ] && sel=$(cat /run/s15-hibernate-entry)
    old=$(efistr "$ONESHOT")
    [ -n "$old" ] && echo "$old" > $R.oneshot.saved
    if [ -n "$sel" ] && set_oneshot "$sel" && [ "$(efistr "$ONESHOT")" = "$sel" ]; then echo "$sel" > $R.oneshot
    else log "WARNING: systemd-boot one-shot entry not set (selected '$sel')"; fi
    used=$(awk '/^MemTotal:/ {t = $2} /^MemAvailable:/ {a = $2} END {print (t - a + 262144) * 1024}' /proc/meminfo)
    echo "$used" > /sys/power/image_size
    # A wake alarm left armed (s15-ec-darkwake arms the ADSP's timers) could start the machine from the power-off;
    # the ADSP owns the alarm, so disarm it while the ADSP still runs.
    for w in /sys/class/rtc/rtc*/wakealarm; do [ -w "$w" ] && echo 0 > "$w"; done
    # stop the DSPs once s15-sleep-hook has read the battery (it writes its state file first)
    for _ in $(seq 50); do
        [ "$(stat -c %Y /run/s15-sleep.state 2>/dev/null || echo 0)" -ge $((t0 - 1)) ] && break
        sleep 0.1
    done
    # Bluetooth (WCN7850 over UART): the controller loses power and firmware with the SoC, and its driver has no
    # restore; after the resume it did not answer, and unbinding it then hung in hci_unregister_dev() (a command
    # job waiting for the dead controller). Unbind it here, while it works, and bind it again in "post": the probe
    # powers it up and loads the firmware (systemd-rfkill restores the radio state of the new device).
    for d in /sys/bus/serial/drivers/hci_uart_qca/serial*; do
        [ -e "$d" ] || continue
        n=${d##*/}
        echo "$n" > /sys/bus/serial/drivers/hci_uart_qca/unbind 2>/dev/null && echo "$n" >> $R.bt
    done
    ts=$(date +%s.%N)
    for n in cdsp adsp; do
        r=$(dsp $n)
        [ "$(cat "$r/state")" = running ] && echo stop > "$r/state" 2>/dev/null && echo "$n" >> $R.dsps
    done
    log "image to $have page $hoff (limit $((used >> 20)) MiB); BootNext ${cur:-?}, one-shot ${sel:-?}${old:+ (was $old)};" \
        "DSPs stopped in $(since "$ts") s: $(dsp_states)" ;;
  post)
    [ -e $R.swapoff ] && { swapon "$SWAPFILE"; rm -f $R.swapoff; exit 0; }
    log "restored, hooks running at $(date +%T.%N | cut -c1-12)"
    efivars
    how="restored after a power-off (BootNext used)"; off=1
    bn=$(efibootmgr 2>/dev/null | sed -n 's/^BootNext: //p')
    if [ -e $R.bootnext ] && [ "$bn" = "$(cat $R.bootnext)" ]; then
        efibootmgr -q -N 2>/dev/null
        how="no power-off (mode $(sed 's/.*\[\(.*\)\].*/\1/' /sys/power/disk), or the hibernation was aborted)"; off=
    fi
    # AOSS deep sleep (AOSD): aoss_cxsd_only switches it off with one QMP message when it loads. The power-off reset
    # the AOSS, so AOSD was allowed again in the restored system, and the first long standby after a restore ended
    # in a hard reset after 6 minutes (2026-11-17). Load the module again (unloading sends "enable", loading "disable").
    if [ -n "$off" ] && [ -d /sys/module/aoss_cxsd_only ]; then
        if rmmod aoss_cxsd_only && modprobe aoss_cxsd_only; then how="$how; AOSD off again"
        else how="$how; WARNING: aoss_cxsd_only not loaded again, AOSD allowed"; fi
    fi
    # Both DSPs start again. The kernel that loaded the image rewrote the SMP2P handshake state in SMEM (and never
    # started the CDSP); kernel patch 0032 sets the restored kernel's SMP2P edges up again from SMEM, otherwise the
    # restart acknowledgement was out of step and every start timed out.
    ts=$(date +%s.%N)
    for n in adsp cdsp; do
        grep -qx "$n" $R.dsps 2>/dev/null || continue
        r=$(dsp $n)
        [ "$(cat "$r/state")" = running ] || echo start > "$r/state" 2>/dev/null
        wait_running "$r"
    done
    dt=$(since "$ts")
    # Bluetooth, unbound in "pre": bind it again (the probe loads the firmware; in the background)
    for n in $(cat $R.bt 2>/dev/null); do
        systemd-run --quiet --collect --no-block /bin/sh -c "echo $n > /sys/bus/serial/drivers/hci_uart_qca/bind"
    done
    if [ -e $R.oneshot ] && [ "$(efistr "$ONESHOT")" = "$(cat $R.oneshot)" ]; then clear_oneshot; fi
    if [ -e $R.oneshot.saved ]; then set_oneshot "$(cat $R.oneshot.saved)"; fi
    log "back: $how; DSPs started in $dt s: $(dsp_states)"
    rm -f $R.* ;;
esac
exit 0
