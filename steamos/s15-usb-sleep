#!/bin/bash
# systemd-sleep hook: before a suspend all four USB controllers switch to runtime PM (the state the standby
# measurements in docs/power.md were made in); after resume the awake policy of s15-usb-pm applies again (USB-C
# controllers runtime-suspended while their Type-C port has no partner, the others on).
# Not for hibernation: s15-hibernate takes the controllers down and up itself.
# Install as /usr/lib/systemd/system-sleep/s15-usb-sleep.
[ "${2:-suspend}" = suspend ] || exit 0
case "$1" in
  pre)
    for f in /sys/bus/platform/drivers/dwc3-qcom/*/power/control /sys/bus/platform/drivers/xhci-hcd/*/power/control; do
      [ -w "$f" ] && echo auto > "$f"
    done ;;
  post)
    if [ -x /usr/local/sbin/s15-usb-pm ]; then /usr/local/sbin/s15-usb-pm
    else
      for f in /sys/bus/platform/drivers/dwc3-qcom/*/power/control /sys/bus/platform/drivers/xhci-hcd/*/power/control; do
        [ -w "$f" ] && echo on > "$f"
      done
    fi ;;
esac
exit 0
