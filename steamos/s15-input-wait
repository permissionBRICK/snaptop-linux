#!/usr/bin/env python3
"""s15-input-wait SECONDS: exit 0 as soon as a key or button is pressed (EV_KEY with value 1) on the keyboard,
touchpad or power key, exit 1 if nothing was pressed within SECONDS. Used by s15-ec-darkwake to tell a person at
the laptop from a dark wake; interrupt counts were not enough, the I2C HID touchpad raises interrupts by itself after
a resume."""
import os
import select
import struct
import sys
import time

EV_KEY = 1
FMT = "llHHi"
SIZE = struct.calcsize(FMT)
WANTED = ("pmic_pwrkey", "hid-over-i2c", "keyboard", "touchpad", "asus")


def devices():
    out = []
    for block in open("/proc/bus/input/devices").read().split("\n\n"):
        name = next((l.split("=", 1)[1].strip('"') for l in block.splitlines() if l.startswith("N: Name=")), "")
        handlers = next((l.split("=", 1)[1].split() for l in block.splitlines() if l.startswith("H: Handlers=")), [])
        if any(w in name.lower() for w in WANTED):
            out += ["/dev/input/" + h for h in handlers if h.startswith("event")]
    return out


def main():
    timeout = float(sys.argv[1]) if len(sys.argv) > 1 else 4
    fds = []
    for d in devices():
        try:
            fds.append(os.open(d, os.O_RDONLY | os.O_NONBLOCK))
        except OSError:
            pass
    end = time.monotonic() + timeout
    while fds and (left := end - time.monotonic()) > 0:
        for fd in select.select(fds, [], [], left)[0]:
            try:
                data = os.read(fd, SIZE * 64)
            except OSError:
                continue
            for i in range(0, len(data) - SIZE + 1, SIZE):
                _, _, typ, _, value = struct.unpack_from(FMT, data, i)
                if typ == EV_KEY and value == 1:
                    sys.exit(0)
    sys.exit(1)


if __name__ == "__main__":
    main()
