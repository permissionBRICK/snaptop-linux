#!/usr/bin/env python3
"""Keep the TPM unlock of the encrypted SteamOS partition working across kernel and initramfs updates.

The root partition (LUKS2) has TPM2 tokens (systemd-cryptenroll) bound to PCR 0, 2, 4, 9 and 15 (docs/encryption.md):
  PCR 0  the firmware's own code, as the firmware measures it up to the separator (changes with a BIOS update)
  PCR 2  firmware events up to the separator; nothing after it (an EFI driver loaded by the boot path changes it)
  PCR 4  firmware events up to the separator, then the Authenticode hashes of systemd-boot and of the kernel
  PCR 9  sha256 of the kernel's load options (UTF-16LE, with NUL), then sha256 of the initrd file
  PCR 15 zero: systemd-cryptsetup measures the volume key into it right after opening the volume
         (tpm2-measure-pcr=yes), so the TPM releases the key only once per boot, before anything from the disk runs
This tool predicts the values for every SteamOS boot entry on S15BOOT that unlocks this partition, for every
firmware variant (the PCR 0, 2 and 4 events before the separator) seen at boot within the last 180 days with the
installed firmware, and makes the TPM2 tokens match: missing ones are enrolled with the predicted values, tokens for
values that no entry produces any more are removed. After a boot that needed the passphrase because the firmware
changed (BIOS update, a new firmware variant), the next boot unlocks with the TPM again, as with BitLocker; variants
of the previous BIOS are dropped then, so going back to it needs the passphrase. Boot paths that are not one of the
entries (edited kernel command line, other kernels or initrds, an extra EFI driver) are never sealed: they always need
the passphrase. Neither are kernels without our two boot fixes: kernel/patches/0012 (otherwise a changed devicetree
could replace the measured initrd) and 0013 (otherwise the SystemdOptions EFI variable could change the boot), nor
initramfs images without the drop-in that makes systemd-cryptsetup measure the volume key (it does so only for a UKI
booted through systemd-stub, otherwise; the initcpio hook sd-s15-etc-overlay adds SYSTEMD_FORCE_MEASURE=1).

New key slots are added with the re-seal key /var/lib/s15-luks/reseal.key (a key slot of its own, readable only by
root on the unlocked system). Only systemd-tpm2 tokens bound to exactly PCR 0+2+4+9+15 (or the older PCR 4+9) are
changed; the passphrase and any other token stay. Nothing in the TPM changes: sealing creates transient objects under
the existing storage key.

usage: s15-luks-reseal [--dry-run]
Runs at every boot (s15-luks-reseal.service; it records the boot's firmware variant) and after every change of
kernel, initramfs, systemd-boot or boot entries (s15-update-esp calls it).
"""
import glob
import gzip
import hashlib
import json
import lzma
import os
import re
import struct
import subprocess
import sys
import tempfile
import time

STATE = "/var/lib/s15-luks"
KEY = f"{STATE}/reseal.key"
VARIANTS = f"{STATE}/firmware-variants.json"
LOG = "/sys/kernel/security/tpm0/binary_bios_measurements"
LOADER = "EFI/S15/systemd-bootaa64.efi"   # what firmware entry "SteamOS (S15)" starts
KEEP_DAYS = 180
PCRS = [0, 2, 4, 9, 15]
FW_PCRS = [0, 2, 4]     # predicted from the firmware's events up to the separator (firmware variants)
OURS = (PCRS, [4, 9])   # token PCR sets this tool manages; [4, 9] = before 2026-11-04, replaced and removed
# kernel/patches/0012: string in the EFI stub; 0013: the variable name (UTF-16) in efivarfs (module or kernel)
STUB_FIX = b"Ignoring the initrd named by the devicetree"
EFIVARFS_FIX = "SystemdOptions".encode("utf-16-le")
# initcpio hook sd-s15-etc-overlay: makes systemd-cryptsetup measure the volume key into PCR 15 without a UKI
MEASURE_DROPIN = "etc/systemd/system/systemd-cryptsetup@.service.d/s15-measure.conf"


def die(msg):
    print(f"s15-luks-reseal: {msg}", file=sys.stderr)
    sys.exit(1)


def run(*cmd, check=True):
    r = subprocess.run(cmd, capture_output=True, text=True)
    if check and r.returncode:
        die(f"{' '.join(cmd)}: {r.stderr.strip() or r.stdout.strip()}")
    return r


def extend(digests):
    v = bytes(32)
    for d in digests:
        v = hashlib.sha256(v + d).digest()
    return v


def authenticode_sha256(path):
    d = open(path, "rb").read()
    pe = struct.unpack_from("<I", d, 0x3C)[0]
    if d[pe:pe + 4] != b"PE\0\0":
        die(f"{path} is not a PE file")
    nsec, optsz = struct.unpack_from("<H", d, pe + 6)[0], struct.unpack_from("<H", d, pe + 20)[0]
    opt = pe + 24
    dd = opt + (96 if struct.unpack_from("<H", d, opt)[0] == 0x10B else 112)
    cksum, cert_dir = opt + 64, dd + 4 * 8
    hdr = struct.unpack_from("<I", d, opt + 60)[0]
    cert_size = struct.unpack_from("<II", d, cert_dir)[1]
    h = hashlib.sha256(d[:cksum] + d[cksum + 4:cert_dir] + d[cert_dir + 8:hdr])
    hashed = hdr
    for ptr, size in sorted((struct.unpack_from("<II", d, opt + optsz + 40 * i + 16)[::-1]) for i in range(nsec)):
        if size:
            h.update(d[ptr:ptr + size])
            hashed += size
    if len(d) - cert_size > hashed:
        h.update(d[hashed:len(d) - cert_size])
    return h.digest()


def firmware_events():
    """{pcr: sha256 digests of its events up to and including the separator} for PCR 0, 2 and 4, from this boot's
    event log."""
    data = open(LOG, "rb").read()
    size = struct.unpack_from("<I", data, 28)[0]
    spec = data[32:32 + size]
    sizes = dict(struct.unpack_from("<HH", spec, 28 + 4 * i) for i in range(struct.unpack_from("<I", spec, 24)[0]))
    off, ev = 32 + size, []
    while off + 12 <= len(data):
        pcr, et, cnt = struct.unpack_from("<III", data, off)
        if not (pcr or et or cnt):
            break
        p, sha = off + 12, None
        for _ in range(cnt):
            a = struct.unpack_from("<H", data, p)[0]
            if a == 0x0B:
                sha = data[p + 2:p + 34]
            p += 2 + sizes[a]
        off = p + 4 + struct.unpack_from("<I", data, p)[0]
        if pcr in FW_PCRS and et != 3:   # EV_NO_ACTION is not extended
            ev.append((pcr, et, sha))
    out = {}
    for n in FW_PCRS:
        e = [(et, sha) for pcr, et, sha in ev if pcr == n]
        seps = [i for i, (et, _) in enumerate(e) if et == 4]
        if not seps:
            die(f"no separator in PCR {n} of the event log")
        out[n] = [sha.hex() for _, sha in e[:seps[0] + 1]]
    return out


def pcr_values():
    out = {}
    for line in run("systemd-analyze", "pcrs", *map(str, PCRS)).stdout.splitlines()[1:]:
        f = line.split()
        out[int(f[0])] = bytes.fromhex(f[-1])
    if sorted(out) != PCRS:
        die(f"cannot read PCR {', '.join(map(str, PCRS))} from the TPM")
    return out


def policy(pcrs):
    """TPM2_PolicyPCR digest for the sha256 bank: systemd's tpm2-policy-hash of a PCR-only token."""
    sel = bytearray(3)
    for i in pcrs:
        sel[i // 8] |= 1 << (i % 8)
    tpml = struct.pack(">IHB", 1, 0x000B, 3) + bytes(sel)
    digest = hashlib.sha256(b"".join(pcrs[i] for i in sorted(pcrs))).digest()
    return hashlib.sha256(bytes(32) + struct.pack(">I", 0x17F) + tpml + digest).hexdigest()


def entries(esp, uuid):
    """(name, kernel, initrd, load options) of every boot entry that unlocks this partition."""
    out = []
    d = f"{esp}/loader/entries"
    for name in sorted(os.listdir(d)):
        if not name.endswith(".conf"):
            continue
        kv = {"initrd": [], "options": []}
        for line in open(f"{d}/{name}", encoding="utf-8"):
            k, _, v = line.strip().partition(" ")
            if k in ("initrd", "options"):
                kv[k].append(v.strip())
            elif k:
                kv[k] = v.strip()
        opts = " ".join(kv["options"])
        if "linux" not in kv or f"rd.luks.name={uuid}=" not in opts:
            continue
        if len(kv["initrd"]) != 1:
            print(f"  {name}: {len(kv['initrd'])} initrds, not predictable - skipped")
            continue
        # systemd-boot passes "initrd=<path with backslashes> " in front of the entry's options
        lo = " ".join(["initrd=" + kv["initrd"][0].replace("/", "\\")] + ([opts] if opts else []))
        out.append((name, f"{esp}{kv['linux']}", f"{esp}{kv['initrd'][0]}", lo))
    return out


def kernel_fixes(kernel):
    """Problems of a kernel image (with its efivarfs module from /usr/lib/modules) with our two boot fixes."""
    data = open(kernel, "rb").read()
    bad = [] if STUB_FIX in data else ["devicetree initrd fix (kernel/patches/0012)"]
    if EFIVARFS_FIX not in data:   # efivarfs not built in: its module
        m = re.search(rb"Linux version (\S+)", data)
        mods = glob.glob(f"/usr/lib/modules/{m.group(1).decode()}/kernel/fs/efivarfs/efivarfs.ko*") if m else []
        ok = False
        for f in mods:
            d = open(f, "rb").read()
            if f.endswith(".xz"):
                d = lzma.decompress(d)
            elif f.endswith(".gz"):
                d = gzip.decompress(d)
            elif f.endswith(".zst"):
                d = subprocess.run(["zstd", "-dc", f], capture_output=True, check=True).stdout
            ok = ok or EFIVARFS_FIX in d
        if not ok:
            bad.append("SystemdOptions fix (kernel/patches/0013)")
    return bad


def initrd_measures(initrd):
    """The initramfs makes systemd-cryptsetup measure the volume key (else PCR 15 stays zero all boot long)."""
    r = subprocess.run(["lsinitcpio", initrd], capture_output=True, text=True)
    return r.returncode == 0 and MEASURE_DROPIN in {line.strip().lstrip("./") for line in r.stdout.splitlines()}


def predict(fw, loader, kernel, initrd, options):
    pcr0 = extend([bytes.fromhex(h) for h in fw["pcr0"]])
    pcr2 = extend([bytes.fromhex(h) for h in fw["pcr2"]])
    pcr4 = extend([bytes.fromhex(h) for h in fw["events"]] + [authenticode_sha256(loader), authenticode_sha256(kernel)])
    pcr9 = extend([hashlib.sha256((options + "\0").encode("utf-16-le")).digest(),
                   hashlib.sha256(open(initrd, "rb").read()).digest()])
    return {0: pcr0, 2: pcr2, 4: pcr4, 9: pcr9, 15: bytes(32)}


def tpm2_tokens(dev):
    meta = json.loads(run("cryptsetup", "luksDump", "--dump-json-metadata", dev).stdout)
    out = []
    for tid, t in meta["tokens"].items():
        if t.get("type") == "systemd-tpm2" and sorted(t.get("tpm2-pcrs", [])) in OURS and "tpm2-policy-hash" in t:
            out.append((int(tid), t["keyslots"], t["tpm2-policy-hash"]))
    return out


def main():
    dry = "--dry-run" in sys.argv
    if os.geteuid():
        die("run as root")
    info = dict(line.strip().split("=", 1) for line in open(f"{STATE}/info") if "=" in line)
    uuid = info["uuid"]
    dev = f"/dev/disk/by-uuid/{uuid}"
    if not os.path.exists(KEY) or not os.path.exists(dev):
        die(f"{KEY} or {dev} missing")
    now = time.time()

    variants = json.load(open(VARIANTS)) if os.path.exists(VARIANTS) else {}
    fw = firmware_events()
    for v in variants.values():   # variants recorded before PCR 0/2 were bound: same firmware as now
        v.setdefault("pcr0", fw[0])
        v.setdefault("pcr2", fw[2])
    fid = hashlib.sha256("|".join("".join(fw[n]) for n in (4, 2, 0)).encode()).hexdigest()[:16]
    variants.setdefault(fid, {"events": fw[4], "pcr2": fw[2], "pcr0": fw[0], "first_seen": now})["last_seen"] = now
    # Only the installed firmware (PCR 0 as in this boot): after a BIOS update, the previous BIOS needs the passphrase.
    variants = {k: v for k, v in variants.items()
                if k == fid or (v["pcr0"] == fw[0] and now - v["last_seen"] < KEEP_DAYS * 86400)}

    esp = tempfile.mkdtemp(prefix="s15-reseal-")
    run("mount", "-o", "ro", "/dev/disk/by-partlabel/S15BOOT", esp)
    try:
        ents = []
        for name, kernel, initrd, lo in entries(esp, uuid):
            bad = kernel_fixes(kernel)
            if bad:
                print(f"  {name}: kernel without the {' and '.join(bad)} - not sealed")
            elif "tpm2-measure-pcr=yes" not in lo:
                print(f"  {name}: no tpm2-measure-pcr=yes in rd.luks.options - not sealed")
            elif not initrd_measures(initrd):
                print(f"  {name}: initramfs without the PCR 15 measurement (initcpio hook sd-s15-etc-overlay) - not sealed")
            else:
                ents.append((name, kernel, initrd, lo))
        if not ents:
            die("no boot entry on S15BOOT can be sealed - nothing changed")
        want = {}
        for vid, v in variants.items():
            for name, kernel, initrd, lo in ents:
                p = predict(v, f"{esp}/{LOADER}", kernel, initrd, lo)
                want.setdefault(policy(p), (p, f"{name} (firmware variant {vid})"))
    finally:
        run("umount", esp)
        os.rmdir(esp)

    # The running boot is checked, never sealed as such: a boot that is not one of the entries (an edited command
    # line, a debug option, an extra EFI driver) must keep asking for the passphrase.
    cur = pcr_values()
    # Nothing extends PCR 0 or 2 after the separator on a normal boot, so the TPM must hold what the event log up to
    # the separator gives; otherwise every prediction would be wrong and the next boots would need the passphrase.
    for n in (0, 2):
        if extend(bytes.fromhex(h) for h in fw[n]) != cur[n]:
            die(f"PCR {n} in the TPM is not its event log up to the separator (an extra EFI driver in this boot?)"
                " - no token changed")
    cur[15] = bytes(32)   # the value at unlock time; the volume key has been measured into it since
    cur_pol = policy(cur)
    if cur_pol in want:
        print(f"running boot: PCR 0/2/4/9 = prediction for {want[cur_pol][1]}")
    else:
        print("running boot: PCR 0/2/4/9 match no boot entry (passphrase boot or a different boot path) - not sealed")

    have = tpm2_tokens(dev)
    seen, drop = set(), []
    for tid, slots, pol in have:
        if pol in want and pol not in seen:
            seen.add(pol)
        else:
            drop.append((tid, slots, pol))
    add = [(pol, p, why) for pol, (p, why) in want.items() if pol not in seen]
    for pol, (p, why) in want.items():
        print(f"{'keep' if pol in seen else 'ADD '} {pol[:16]}  {why}")
    for tid, slots, pol in drop:
        print(f"DROP {pol[:16]}  token {tid}, key slot {','.join(slots)} (no sealed entry produces these values)")
    if dry:
        return
    for pol, p, why in add:
        spec = "+".join(f"{i}:sha256={p[i].hex()}" for i in PCRS)
        run("systemd-cryptenroll", f"--unlock-key-file={KEY}", "--tpm2-device=auto", f"--tpm2-pcrs={spec}", dev)
        if pol not in {t[2] for t in tpm2_tokens(dev)}:
            die(f"enrolled token for {why} has an unexpected policy - stopping before removing anything")
        print(f"enrolled {pol[:16]} for {why}")
    for tid, slots, pol in drop:
        for s in slots:
            run("systemd-cryptenroll", f"--unlock-key-file={KEY}", f"--wipe-slot={s}", dev)
        print(f"removed {pol[:16]} (key slot {','.join(slots)})")
    tmp = VARIANTS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(variants, f, indent=1)
    os.replace(tmp, VARIANTS)
    # A test unlock is not possible here: PCR 15 no longer is zero after the volume was opened.
    if cur_pol in {t[2] for t in tpm2_tokens(dev)}:
        print("the running boot path unlocks with the TPM")


if __name__ == "__main__":
    main()
