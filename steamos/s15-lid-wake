#!/bin/bash
# systemd-sleep hook: the EC pulses the lid GPIO (gpio-keys) ~5 min into suspend even with the lid open, which
# wakes the laptop. Suspending with the lid open: drop lid wakeup for this sleep (keyboard/power key still wake).
# (from justririll/x1e-sleep)
W=/sys/bus/platform/devices/gpio-keys/power/wakeup
case "$1" in
  pre) [ "$(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager LidClosed 2>/dev/null)" = "b false" ] && echo disabled > $W ;;
  post) echo enabled > $W ;;
esac
exit 0
