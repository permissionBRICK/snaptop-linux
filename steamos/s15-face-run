#!/usr/bin/python3 -I
"""Face unlock runs (docs/login.md#face-unlock): when Biopass may look, what counts, and when a match unlocks.

s15-face (the PAM entry points) runs this; Biopass's helper does the looking (biopass-helper auth --keep-looking,
face/patches/0007): it keeps looking while it sees no face, and the first face it compares decides (exit 0 match,
1 a face that did not match or that anti-spoofing flagged, 3 no face within the time, 2 nothing to try).

Rules for every run:
- Only while a display is on (a connected, enabled DRM connector with DPMS on) and the lid is open (logind). A
  helper that is looking when that changes, or when the laptop wakes from sleep, is stopped within 0.2 s; a match
  counts only if the display is still on and the lid open 0.4 s after it (Escape on the lock screen turns the
  display off a moment after the key: a match from just before must not unlock a laptop the user is leaving).
- A run ends after run_false_faces (3) false faces: faces seen that did not match, or that anti-spoofing flagged,
  about a second apart. No face does not count.
- Every false face and every match is logged with the helper's steps (its --verbose lines, as s15-face check shows
  them: the light, anti-spoofing's score, each camera's recognition score), kept in memory, never on disk.
- Lockout, as the PIN's (counted since the last success: face, password, PIN, login): after free_false_faces (6)
  false faces face waits first_wait (60 s), after each further one twice as long, up to max_wait (3600 s); after
  off_after (15) it is off until a password or PIN login or unlock. The numbers: /etc/s15-face.conf (root's; the
  user's Biopass settings are writable by any program running as the user), s15-face lockout. The count: root's
  /var/lib/s15-face/lockout/<user>, kept across restarts (a restart must not give new tries) and SteamOS updates;
  the user's processes reach it only through the s15-face socket service. Also refused: no IR camera or minimum
  face size in the settings, an account locked by wrong passwords (pam_faillock).

  s15-face-run watch       (pam_exec, kde-fingerprint, as the user) the lock screen: a run starts when the display
                           is on, keeps looking (up to 60 s without a face), and the conversation stays open
                           with the camera off while the display is off, lid closed or asleep; when it is on again
                           a new run starts by itself. After a run that ended (3 false faces, 60 s without a face)
                           Enter on the empty password field starts the next (rescan). Ends with a match (unlock)
                           or when face is refused (lockout)
  s15-face-run scan        (pam_exec) sudo/polkit when turned on: one run that looks for up to 6 s. SDDM after an
                           empty field: takes the background scan's match, else asks it for a new run and fails
                           at once (the field never waits for the camera)
  s15-face-run gate        (pam_exec) exit 0 if face may be tried now; logs why not
  s15-face-run rescan      (pam_exec in kde, the field is known empty) ask the lock screen's watch for a new run
  s15-face-run ok          (pam_exec, auth, after a success) reset the count of false faces
  s15-face-run account     (pam_exec, SDDM account phase, root) a login: reset the count, fresh runtime file
  s15-face-run reset USER  (root) reset the count (s15-face reset)
  s15-face-run serve       (s15-face@.service, root, one request per connection from s15-face.socket) "get|false|ok
                           USER": a user's process only for itself (SO_PEERCRED); answers "fails=N until=T"
  s15-face-run wake [--dry-run] [--simulate-resume]   (s15-face-wake.service, root) face unlock by itself: the
                           lock screen after a wake from sleep (one F24 tap), the login screen while it is up
  s15-face-run greeter USER  (root, the wake service's child) the login screen's background scan: on a match a
                           token for SDDM's PAM stack and SDDM's own Login message
  s15-face-run state [user]  display, lid and the user's face state (for s15-face status)
  s15-face-run lockout [keys | set KEY VALUE [KEY VALUE ...] | reset-defaults]   the lockout numbers (s15-face lockout)
"""
import ctypes
import fcntl
import os
import pwd
import re
import signal
import struct
import subprocess
import sys
import syslog
import time

STATE_DIR = "/run/s15-face"                 # runtime: the lock screen's watch, Enter presses (user's files)
LOCKOUT_DIR = "/var/lib/s15-face/lockout"   # the count of false faces (root's)
SOCK = "/run/s15-face.sock"
HELPER = "/usr/bin/biopass-helper"
CONF = ".config/com.ticklab.biopass/config.yaml"
DRM = "/sys/class/drm"
FAILLOCK_CONF = "/etc/security/faillock.conf"
LOCKOUT_CONF = "/etc/s15-face.conf"
# The lockout's numbers: key -> (default, min, max, unit, meaning). A stable interface (s15-face lockout; the Biopass
# app's settings call it through pkexec): keep the keys and their meaning.
LOCKOUT_KEYS = {
    "run_false_faces": (3, 1, 10, "faces", "false faces after which a run ends (the next on Enter or when the "
                                           "display comes on again)"),
    "free_false_faces": (6, 0, 100, "faces", "false faces since the last success before the first wait"),
    "first_wait": (60, 0, 86400, "seconds", "the first wait, doubled with every further false face; 0: no waits"),
    "max_wait": (3600, 0, 86400, "seconds", "the longest wait"),
    "off_after": (15, 1, 100, "faces", "false faces since the last success after which face is off until a "
                                       "password or PIN login or unlock"),
}
WATCH_LOOK_MS = 20000   # one helper on the lock screen; then a new one (the camera stays on in between)
WATCH_NO_FACE_S = 60    # a lock screen run without any face ends (the camera goes off) after this
SCAN_LOOK_MS = 6000     # login screen, sudo, polkit: their field waits for the run
FALSE_PAUSE_S = 0.3     # after a false face; the helper's restart adds about 0.7 s
CONFIRM_S = 0.4         # a match counts if the display is still on and the lid open after this
SETTLE_S = 0.5          # the display must be on this long before a run starts
POLL_S = 0.2            # while the helper looks
IDLE_S = 0.5            # while waiting
HELPER_ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin"}
STEPS_READ = 256 * 1024 # the end of a helper's --verbose output that is read (frames without a face come first)
STEPS_MAX = 1500        # characters of steps in one journal line (the last ones: the attempt that decided)
GREETER = "greeter"     # /run/s15-face/greeter (root's): the login screen's scan (its pid, Enter presses)
TOKEN = "token"         # /run/s15-face/token (root's): a face recognised at the login screen, for SDDM's PAM stack
TOKEN_LIFE_MS = 15000
LOGIN_SETTLE_S = 5      # a login screen match waits this long for a failing Enter attempt to end, then logs in
SDDM_STATE = "/var/lib/sddm/state.conf"
RESUME_WINDOW_S = 60    # after a wake from sleep: how long the lock screen may take to show with the display on

# Exit codes of biopass-helper auth (face/patches/0007)
MATCH, FALSE_FACE, NOTHING, NO_FACE = 0, 1, 2, 3


def log(msg):
    syslog.openlog("s15-face", 0, syslog.LOG_AUTH)
    syslog.syslog(syslog.LOG_NOTICE, msg)


# The helper's --verbose lines worth logging (the ones s15-face check shows), without the frames that showed no face
STEP_RE = re.compile(r"FaceAuth: ((?:Face on|No face|Recognition (?:PASSED|FAILED)|The .* frame came|Recognised on "
                     r"both|One face on both|The faces on the colour|Could not|Both cameras must|No face enrolled|"
                     r"Anti-spoofing failed|AI anti-spoofing (?:detected spoof|check passed)|IR presence check "
                     r"(?:PASSED|FAILED)|Low light on|Enough light on|Recognised on the IR camera alone).*)"
                     r"|(the camera appears covered.*)")


def helper_steps(text):
    """The steps of the attempt that decided, from a helper's --verbose output, for one journal line. A frame
    without a face (--keep-looking) is left out with the light line that came before it (the light of a picture
    that led to nothing)."""
    steps = []
    for line in text.splitlines():
        m = STEP_RE.search(line)
        if not m:
            continue
        s = m.group(1) or m.group(2)
        if s.startswith("No face detected"):
            while steps and steps[-1].startswith(("Low light on", "Enough light on")):
                steps.pop()
            continue
        s = re.sub(r" \(NOTE:.*\)$", "", s)
        s = re.sub(r"face='[^']*/(faces[^/]*/[^']*)'", r"\1", s)
        steps.append(s)
    out = "; ".join(steps)
    return out if len(out) <= STEPS_MAX else "..." + out[-STEPS_MAX:]


def read_steps(fd):
    """helper_steps of what the helper wrote to the memfd fd."""
    size = os.fstat(fd).st_size
    os.lseek(fd, max(0, size - STEPS_READ), os.SEEK_SET)
    chunks = []
    while True:
        b = os.read(fd, 65536)
        if not b:
            break
        chunks.append(b)
    return helper_steps(b"".join(chunks).decode(errors="replace"))


def valid_user(u):
    import re
    return bool(u) and re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", u) is not None


def set_pdeathsig(sig):
    try:
        ctypes.CDLL(None, use_errno=True).prctl(1, int(sig), 0, 0, 0)   # PR_SET_PDEATHSIG
    except (OSError, AttributeError):
        pass


# --- the display and the lid ------------------------------------------------------------------------------------

def display_on(drm=DRM):
    """A connected, enabled connector with DPMS on (disconnected ones report "On" too)."""
    try:
        names = os.listdir(drm)
    except OSError:
        return False
    for name in names:
        if "-" not in name:
            continue
        try:
            vals = [open(f"{drm}/{name}/{a}").read().strip() for a in ("status", "enabled", "dpms")]
        except OSError:
            continue
        if vals == ["connected", "enabled", "On"]:
            return True
    return False


_lid = None


def lid_closed():
    """logind's LidClosed; closed when it cannot be read (fail closed). One proxy, made once without introspection:
    each call is a single Get."""
    global _lid
    try:
        import dbus
        if _lid is None:
            _lid = dbus.Interface(dbus.SystemBus().get_object("org.freedesktop.login1", "/org/freedesktop/login1",
                                                              introspect=False), "org.freedesktop.DBus.Properties")
        return bool(_lid.Get("org.freedesktop.login1.Manager", "LidClosed", timeout=2))
    except Exception:   # no dbus module or no answer
        _lid = None
    try:
        out = subprocess.run(["busctl", "get-property", "org.freedesktop.login1", "/org/freedesktop/login1",
                              "org.freedesktop.login1.Manager", "LidClosed"], capture_output=True, text=True,
                             timeout=3, env=HELPER_ENV).stdout.strip()
        return out != "b false"
    except (OSError, subprocess.SubprocessError):
        return True


class Sleep:
    """Notices a suspend or hibernation in between: CLOCK_BOOTTIME runs on through it, CLOCK_MONOTONIC does not."""
    def __init__(self):
        self.mark()

    def mark(self):
        self.boot, self.mono = time.clock_gettime(time.CLOCK_BOOTTIME), time.monotonic()

    def slept(self):
        boot, mono = time.clock_gettime(time.CLOCK_BOOTTIME), time.monotonic()
        gap = (boot - self.boot) - (mono - self.mono)
        self.boot, self.mono = boot, mono
        return gap > 2


# --- the user's state, settings and password lockout -------------------------------------------------------------

def parse_kv(text):
    d = {}
    for line in text.split():
        k, _, v = line.partition("=")
        if k and v.isdigit():
            d[k] = int(v)
    return d


class Runtime:
    """/run/s15-face/<user>: watch = the lock screen's watch, rescan = Enter presses on the lock screen's empty field.
    The file is the user's (created by root: at a login, or by the service); the directory is root's, so a user can
    change it but not create, replace or link it. Nothing in it counts for the lockout."""
    def __init__(self, user, state_dir=STATE_DIR, name=None, owner=None):
        """name, owner: another file of the directory and its owner's uid (the login screen's scan: "greeter",
        root's)."""
        self.user, self.path, self.owner = user, f"{state_dir}/{name or user}", owner

    def _open(self):
        fd = os.open(self.path, os.O_RDWR | os.O_NOFOLLOW)
        st = os.fstat(fd)
        import stat as st_
        owner = self.owner if self.owner is not None else pwd.getpwnam(self.user).pw_uid
        if not st_.S_ISREG(st.st_mode) or st.st_uid != owner:
            os.close(fd)
            raise OSError("not the user's runtime file")
        return fd

    def read(self):
        try:
            fd = self._open()
        except (OSError, KeyError):
            return None
        try:
            fcntl.flock(fd, fcntl.LOCK_SH)
            return parse_kv(os.read(fd, 4096).decode(errors="replace"))
        finally:
            os.close(fd)

    def update(self, change):
        """change(dict) edits the values in place; returns the new values (None without the file)."""
        try:
            fd = self._open()
        except (OSError, KeyError):
            return None
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            d = parse_kv(os.read(fd, 4096).decode(errors="replace"))
            change(d)
            data = "".join(f"{k}={v}\n" for k, v in d.items()).encode()
            os.lseek(fd, 0, os.SEEK_SET)
            os.ftruncate(fd, 0)
            os.write(fd, data)
            return d
        finally:
            os.close(fd)


def make_runtime(user, state_dir=STATE_DIR, fresh=False):
    """(root) The user's runtime file, owned by the user; fresh: emptied."""
    pw = pwd.getpwnam(user)
    os.makedirs(state_dir, mode=0o755, exist_ok=True)
    path = f"{state_dir}/{user}"
    if os.path.islink(path):
        os.unlink(path)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        os.fchown(fd, pw.pw_uid, pw.pw_gid)
        os.fchmod(fd, 0o600)
        if fresh:
            os.ftruncate(fd, 0)
    finally:
        os.close(fd)


def count_false_face(d, conf, now):
    """One more false face in d (fails, until), and the wait the count asks for (as s15-pin counts wrong PINs)."""
    d["fails"] = n = d.get("fails", 0) + 1
    if n < conf["off_after"] and conf["first_wait"] and n >= conf["free_false_faces"]:
        wait = min(conf["max_wait"], conf["first_wait"] * 2 ** min(n - conf["free_false_faces"], 30))
        d["until"] = int(now + wait)


class Lockout:
    """The user's count of false faces since the last success and the wait (fails, until: wall clock), root's file
    /var/lib/s15-face/lockout/<user>. Root reads and changes it directly; a user's process through the s15-face
    socket service, only its own: read it, count one false face (the service applies root's lockout numbers),
    reset it after a success. OSError when it cannot be reached (face is then refused)."""
    def __init__(self, user, directory=LOCKOUT_DIR, sock=SOCK, direct=None):
        self.user, self.dir, self.sock = user, directory, sock
        self.direct = os.geteuid() == 0 if direct is None else direct

    def _file(self, change=None):
        """The values; with change, changed under a lock. Reading needs no write access (the wake service reads it in
        a read-only file system) and creates nothing: no file yet is a count of 0."""
        import stat as st_
        path = f"{self.dir}/{self.user}"
        if change is None:
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
            except FileNotFoundError:
                return {"fails": 0, "until": 0}
        else:
            os.makedirs(self.dir, mode=0o700, exist_ok=True)
            fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        try:
            st = os.fstat(fd)
            if not st_.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_mode & 0o077:
                raise OSError("lockout file not root's alone")
            fcntl.flock(fd, fcntl.LOCK_EX if change else fcntl.LOCK_SH)
            d = parse_kv(os.read(fd, 4096).decode(errors="replace"))
            if change:
                change(d)
                data = f"fails={d.get('fails', 0)}\nuntil={d.get('until', 0)}\n".encode()
                os.lseek(fd, 0, os.SEEK_SET)
                os.ftruncate(fd, 0)
                os.write(fd, data)
                os.fsync(fd)
            return {"fails": d.get("fails", 0), "until": d.get("until", 0)}
        finally:
            os.close(fd)

    def _ask(self, op):
        import socket
        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            c.settimeout(10)
            c.connect(self.sock)
            c.sendall(f"{op} {self.user}\n".encode())
            line = c.makefile().readline().strip()
        finally:
            c.close()
        if not line.startswith("fails="):
            raise OSError(f"s15-face service: {line or 'no answer'}")
        d = parse_kv(line)
        return {"fails": d.get("fails", 0), "until": d.get("until", 0)}

    def get(self):
        return self._file() if self.direct else self._ask("get")

    def false_face(self, conf=None):
        if not self.direct:
            return self._ask("false")
        conf = conf or lockout_conf()
        return self._file(lambda d: count_false_face(d, conf, time.time()))

    def reset(self):
        if not self.direct:
            return self._ask("ok")
        return self._file(lambda d: d.update(fails=0, until=0))


def lockout_conf(path=LOCKOUT_CONF):
    """The lockout numbers: the defaults, with the valid values of a root-owned file not writable by others."""
    import stat as st_
    conf = {k: v[0] for k, v in LOCKOUT_KEYS.items()}
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return conf
    with os.fdopen(fd) as f:
        st = os.fstat(f.fileno())
        if not st_.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
            log(f"{path}: not root's or writable by others, the defaults apply")
            return conf
        for line in f.read(65536).splitlines():
            k, _, v = line.split("#", 1)[0].partition("=")
            k, v = k.strip(), v.strip()
            if k in LOCKOUT_KEYS and v.isdigit() and LOCKOUT_KEYS[k][1] <= int(v) <= LOCKOUT_KEYS[k][2]:
                conf[k] = int(v)
    return conf


def configured(user):
    """The user's Biopass settings name an IR camera, a minimum face size, and use no camera profiles (they would
    override them; saving the app's settings page writes profiles and drops the keys the app does not know). Read
    without following links and only if the user owns the file, also when run as root (login screen)."""
    import yaml
    try:
        pw = pwd.getpwnam(user)
        fd = os.open(os.path.join(pw.pw_dir, CONF), os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd) as f:
            st = os.fstat(f.fileno())
            if st.st_uid != pw.pw_uid or st.st_size > 1 << 20:
                return False
            face = ((yaml.safe_load(f.read()) or {}).get("methods") or {}).get("face") or {}
    except (OSError, KeyError, yaml.YAMLError, AttributeError):
        return False
    ir = (face.get("anti_spoofing") or {}).get("ir_camera")
    size = (face.get("detection") or {}).get("min_face_height")
    sized = isinstance(size, (int, float)) and not isinstance(size, bool) and 0 < size <= 1
    return isinstance(ir, str) and bool(ir.strip()) and sized and not face.get("camera_profiles")


def faillocked(user, conf=FAILLOCK_CONF, now=None):
    """pam_faillock's verdict from its tally file: deny failures within fail_interval, until unlock_time after the
    last one (the settings as pam_faillock reads them: the last value in faillock.conf wins)."""
    opts = {"deny": 3, "fail_interval": 900, "unlock_time": 600, "dir": "/var/run/faillock"}
    try:
        for line in open(conf):
            k, _, v = line.split("#", 1)[0].partition("=")
            k, v = k.strip(), v.strip()
            if k in opts and v:
                opts[k] = v if k == "dir" else int(v)
    except (OSError, ValueError):
        pass
    if not opts["deny"]:
        return False
    try:
        data = open(f"{opts['dir']}/{user}", "rb").read()
    except OSError:
        return False
    now = time.time() if now is None else now
    times = [t for _, _, status, t in struct.iter_unpack("<52sHHQ", data[:len(data) // 64 * 64]) if status & 1]
    fails = sum(1 for t in times if now - t < opts["fail_interval"])
    if fails < opts["deny"]:
        return False
    return not (opts["unlock_time"] and max(times) + opts["unlock_time"] < now)


def refusal(user, lockout, conf):
    """(off, why) if face may not be tried now: off = only a password or PIN turns it on again; else None."""
    try:
        d = lockout.get()
    except OSError as e:
        return False, f"the count of false faces cannot be read ({e})"
    if d["fails"] >= conf["off_after"]:
        return True, f"{d['fails']} false faces since the last success; the password or PIN turns it on again"
    left = d["until"] - time.time()
    if left > 0:
        return False, f"wait {int(left) + 1} s after {d['fails']} false faces"
    if not configured(user):
        return False, "no IR camera or minimum face size in the Biopass settings (s15-face camera ir|rgb|both)"
    if faillocked(user):
        return False, "account locked by wrong passwords (pam_faillock)"
    return None


# --- one run ------------------------------------------------------------------------------------------------------

def descendants(pid):
    """The processes below pid (children, grandchildren, ...), from /proc."""
    kids = {}
    for p in os.listdir("/proc"):
        if not p.isdigit():
            continue
        try:
            stat = open(f"/proc/{p}/stat").read()
            ppid = int(stat[stat.rindex(")") + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            continue
        kids.setdefault(ppid, []).append(int(p))
    out, todo = [], [pid]
    while todo:
        for c in kids.get(todo.pop(), []):
            out.append(c)
            todo.append(c)
    return out


def kill_tree(proc):
    """Kills a helper and everything it started, and reaps it. libcamera's IPA workers (softisp_ipa_proxy) run in
    process groups of their own and outlived a killed helper (four held a shutdown up for 90 s); face/patches/0012
    makes them die with it, this kills them anyway. The helper is stopped first, so it starts nothing new meanwhile."""
    if proc.poll() is None:
        try:
            os.kill(proc.pid, signal.SIGSTOP)
            below = descendants(proc.pid)
        except OSError:
            below = []
        for p in below:
            try:
                os.kill(p, signal.SIGKILL)
            except OSError:
                pass
        proc.kill()
    proc.wait()


class Runner:
    def __init__(self, user, service, lockout, conf, parent=None, helper=HELPER, display=display_on, lid=lid_closed):
        self.user, self.service, self.lockout, self.conf, self.parent = user, service, lockout, conf, parent
        self.helper, self.display, self.lid = helper, display, lid
        self.sleep = Sleep()
        self.proc = None
        self.steps = ""   # the last helper's steps (helper_steps)
        self.last_lid = (0.0, False)

    def lid_closed(self, fresh=False):
        # one D-Bus call a second while looking: closing the lid also suspends or turns the display off
        if fresh or time.monotonic() - self.last_lid[0] >= 1:
            self.last_lid = (time.monotonic(), self.lid())
        return self.last_lid[1]

    def parent_gone(self):
        return self.parent is not None and os.getppid() != self.parent

    def stop_reason(self, fresh=False):
        """Why no helper may look now, or None."""
        if self.parent_gone():
            return "the lock screen ended"
        if self.sleep.slept():
            return "woke from sleep"
        if not self.display():
            return "display off"
        if self.lid_closed(fresh):
            return "lid closed"
        return None

    def kill(self):
        if self.proc:
            kill_tree(self.proc)
        self.proc = None

    def run_helper(self, look_ms):
        """(exit code, None) or (None, why it was stopped). self.steps: what the helper saw (helper_steps)."""
        self.steps = ""
        try:
            out = os.memfd_create("s15-face-steps", os.MFD_CLOEXEC)   # its --verbose lines, in memory only
        except (AttributeError, OSError):
            out = None
        try:
            self.proc = subprocess.Popen(
                [self.helper, "auth", "--username", self.user, "--service", self.service, "--keep-looking",
                 str(look_ms)] + (["--verbose"] if out is not None else []),
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                stderr=out if out is not None else subprocess.DEVNULL, env=HELPER_ENV, cwd="/",
                preexec_fn=lambda: set_pdeathsig(signal.SIGKILL))
        except BaseException:
            if out is not None:
                os.close(out)
            raise
        deadline = time.monotonic() + look_ms / 1000 + 25
        try:
            while True:
                try:
                    return self.proc.wait(timeout=POLL_S), None
                except subprocess.TimeoutExpired:
                    pass
                why = self.stop_reason()
                if why is None and time.monotonic() > deadline:
                    why = "the helper did not end"
                if why:
                    return None, why
        finally:
            self.kill()
            if out is not None:
                try:
                    self.steps = read_steps(out)
                except OSError:
                    pass
                finally:
                    os.close(out)

    def wait(self, seconds, fresh=False):
        """Waits; why a helper may no longer look, or None. fresh: the lid read anew at the end."""
        end = time.monotonic() + seconds
        while time.monotonic() < end:
            time.sleep(min(POLL_S, max(0.0, end - time.monotonic())))
            why = self.stop_reason()
            if why:
                return why
        return self.stop_reason(fresh=True) if fresh else None

    def run(self, look_ms, no_face_s):
        """One run: ("match"|"ended"|"stopped", why) or ("refused", (off, why))."""
        false_faces, looked = 0, 0.0
        while True:
            why = refusal(self.user, self.lockout, self.conf)
            if why:
                return "refused", why
            why = self.stop_reason()
            if why:
                return "stopped", why
            t0 = time.monotonic()
            rc, why = self.run_helper(look_ms)
            if why:
                return "stopped", why
            if rc == MATCH:
                log(f"{self.user}: match: {self.steps or 'no steps'} ({self.service})")
                why = self.wait(CONFIRM_S, fresh=True)
                if why:
                    log(f"{self.user}: match not used: {why} ({self.service})")
                    return "stopped", why
                try:
                    self.lockout.reset()
                except OSError as e:
                    log(f"{self.user}: count of false faces not reset: {e}")
                return "match", ""
            if rc == FALSE_FACE:
                try:
                    d = self.lockout.false_face(self.conf)
                except OSError as e:   # never look on without counting
                    return "refused", (False, f"the false face could not be counted ({e})")
                false_faces += 1
                wait = d["until"] - time.time()
                log(f"{self.user}: false face {false_faces} of this run, {d.get('fails', '?')} since the last "
                    f"success{f', face waits {int(wait) + 1} s' if wait > 0 else ''} ({self.service}): "
                    f"{self.steps or 'no steps'}")
                if false_faces >= self.conf["run_false_faces"]:
                    return "ended", f"{false_faces} false faces"
                why = self.wait(FALSE_PAUSE_S)
                if why:
                    return "stopped", why
                continue
            if rc == NO_FACE:
                looked += time.monotonic() - t0
                if looked >= no_face_s:
                    return "ended", f"no face for {round(looked)} s"
                continue
            return "ended", "nothing to try (no faces enrolled, no camera or models)" if rc == NOTHING \
                else f"the helper failed ({rc})"


def pam_user():
    u = os.environ.get("PAM_USER", "")
    if os.environ.get("PAM_TYPE") != "auth" or not valid_user(u):
        sys.exit(1)
    try:
        uid = pwd.getpwnam(u).pw_uid
    except KeyError:
        sys.exit(1)
    if os.getuid() not in (0, uid):
        sys.exit(1)
    return u


def cmd_gate():
    u = pam_user()
    why = refusal(u, Lockout(u), lockout_conf())
    if why:
        log(f"{u}: face refused: {why[1]} ({os.environ.get('PAM_SERVICE', '?')})")
        sys.exit(1)
    sys.exit(0)


def cmd_scan():
    u = pam_user()
    service = os.environ.get("PAM_SERVICE", "")
    set_pdeathsig(signal.SIGTERM)
    if service == "sddm":
        # The login screen never waits for the camera. Its background scan (s15-face-wake) owns the camera: its
        # match leaves a token and sends SDDM a Login, which ends here. Enter on the empty field takes a token that is
        # there, else asks the background scan for a new run and fails at once; that run's match logs in by itself
        # once this attempt is over (cmd_greeter's on_match). Without a background scan there is no face login.
        if take_token(u):
            log(f"{u}: face recognised at the login screen ({service})")
            sys.exit(0)
        g = Runtime(u, name=GREETER, owner=0)
        if watch_alive(g, "greeter"):
            g.update(lambda d: d.__setitem__("rescan", d.get("rescan", 0) + 1))
        sys.exit(1)
    r = Runner(u, service, Lockout(u), lockout_conf())
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(1))
    try:
        why = r.stop_reason(fresh=True)
        if why:
            log(f"{u}: face not tried: {why} ({service})")
            sys.exit(1)
        result, detail = r.run(SCAN_LOOK_MS, SCAN_LOOK_MS / 1000)
    finally:
        r.kill()
    if result == "match":
        sys.exit(0)
    if result == "refused":
        log(f"{u}: face refused: {detail[1]} ({service})")
    sys.exit(1)


def cmd_watch():
    u = pam_user()
    service = os.environ.get("PAM_SERVICE", "")
    parent = os.getppid()
    set_pdeathsig(signal.SIGTERM)
    if parent == 1 or os.getppid() != parent:
        sys.exit(1)
    r = Runner(u, service, Lockout(u), lockout_conf(), parent=parent)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(1))
    signal.signal(signal.SIGHUP, lambda *_: sys.exit(1))
    why = refusal(u, r.lockout, r.conf)   # also asks the service, which makes the runtime file if missing
    if why and why[0]:
        log(f"{u}: face refused: {why[1]} ({service})")
        sys.exit(1)
    runtime = Runtime(u)
    me = os.getpid()
    runtime.update(lambda d: d.__setitem__("watch", me))
    try:
        sys.exit(watch_loop(r, runtime))
    finally:
        r.kill()
        runtime.update(lambda d: d.pop("watch", None) if d.get("watch") == me else None)


def watch_loop(r, runtime, on_match=None, start_waiting=False):
    """0: a match (unlock); 1: face off until a password or PIN, or the lock screen ended. Ending makes kscreenlocker
    hide its face hint; it starts the watch again only after a failed password (then it is checked again). Refused
    for a while (a wait, pam_faillock, the settings): the watch stays and tries at the next start of a run."""
    u, service = r.user, r.service
    # waiting: a run ended (or none may start by itself yet): the next one starts when the display comes back on, or
    # on Enter (rescan)
    waiting = start_waiting
    seen = (runtime.read() or {}).get("rescan", 0)
    while True:
        if r.parent_gone():
            return 1
        d = runtime.read() or {}
        if r.stop_reason():
            waiting = False   # off and on again: a new run, as when the lock screen appears
            time.sleep(IDLE_S)
            continue
        rescan = d.get("rescan", 0)
        if waiting:
            if rescan == seen:
                time.sleep(IDLE_S)
                continue
            log(f"{u}: Enter on the empty field: a new run ({service})")
        seen, waiting = rescan, False
        if r.wait(SETTLE_S):
            continue
        result, detail = r.run(WATCH_LOOK_MS, WATCH_NO_FACE_S)
        if result == "match":
            log(f"{u}: face recognised ({service})")
            if on_match is None or on_match():
                return 0
            seen, waiting = (runtime.read() or {}).get("rescan", 0), True
        if result == "refused":
            log(f"{u}: face refused: {detail[1]} ({service})")
            if detail[0]:
                return 1
            seen, waiting = (runtime.read() or {}).get("rescan", 0), True
        if result == "ended":
            log(f"{u}: run ended: {detail}; the next when the display is on again or on Enter ({service})")
            seen, waiting = (runtime.read() or {}).get("rescan", 0), True
        # stopped (display off, lid closed, woke from sleep): a new run once the display is on again


def cmd_rescan():
    """The field is empty (s15-face checked it): one more Enter for the lock screen's watch."""
    u = pam_user()
    Runtime(u).update(lambda d: d.__setitem__("rescan", d.get("rescan", 0) + 1))
    sys.exit(0)


def cmd_ok():
    """After a success in an auth stack (lock screen: face or password/PIN unlock): the count starts again."""
    u = pam_user()
    try:
        Lockout(u).reset()
    except OSError as e:
        log(f"{u}: count of false faces not reset: {e}")
    sys.exit(0)


def cmd_account():
    """SDDM's account phase (root): a login succeeded (password, PIN or face): the count starts again."""
    u = os.environ.get("PAM_USER", "")
    if os.environ.get("PAM_TYPE") != "account" or os.geteuid() != 0 or not valid_user(u):
        sys.exit(0)
    try:
        make_runtime(u, fresh=True)
        Lockout(u).reset()
    except (OSError, KeyError) as e:
        log(f"{u}: login: count of false faces not reset: {e}")
    sys.exit(0)


def serve_request(peer_uid, line, lockout_dir=LOCKOUT_DIR, conf_path=LOCKOUT_CONF, state_dir=STATE_DIR):
    """One request of the service: "get|false|ok USER" -> "fails=N until=T", or "denied"."""
    op, _, user = line.strip().partition(" ")
    if op not in ("get", "false", "ok") or not valid_user(user):
        return "denied"
    try:
        target = pwd.getpwnam(user).pw_uid
    except KeyError:
        return "denied"
    if peer_uid not in (0, target):
        return "denied"
    lk = Lockout(user, directory=lockout_dir, direct=True)
    try:
        if op == "get":
            d = lk.get()
            if not os.path.exists(f"{state_dir}/{user}"):
                make_runtime(user, state_dir)
        elif op == "false":
            d = lk.false_face(lockout_conf(conf_path))
        else:
            d = lk.reset()
    except OSError as e:
        log(f"service: {user}: {e}")
        return "error"
    return f"fails={d['fails']} until={d['until']}"


def cmd_serve():
    import socket
    conn = socket.socket(fileno=0)
    uid = struct.unpack("3i", conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))[1]
    conn.settimeout(5)
    data = b""
    try:
        while len(data) < 256 and b"\n" not in data:
            b = conn.recv(256)
            if not b:
                break
            data += b
        conn.sendall(serve_request(uid, data.decode(errors="replace").split("\n")[0]).encode() + b"\n")
    except OSError:
        pass


def cmd_reset(user):
    if os.geteuid() != 0:
        sys.exit("s15-face reset: run as root (sudo)")
    Lockout(user).reset()
    print(f"{user}: false faces cleared")


# --- the lock screen starts face unlock by itself (root) ---------------------------------------------------------
# kscreenlocker starts its authenticators (and with them kde-fingerprint, our watch) only when its UI is shown or
# hidden (a key, a mouse move or click, Escape, the fade-out) or 3 s after a failed password; never on its own when
# it appears or after a wake. This taps F24 (no key has it) on a virtual keyboard once, as a first key press would.
# Never while kscreenlocker's grace time may run: input then unlocks without a password (an idle lock: the greeter
# runs without --immediateLock, with --graceTime <ms>; the first <ms> after it locked), never if the lock needs no
# password (--nolock), only with the display on, the lid open, face allowed for the user and no watch running.

UI_SET_EVBIT, UI_SET_KEYBIT, UI_DEV_SETUP, UI_DEV_CREATE, UI_DEV_DESTROY = 0x40045564, 0x40045565, 0x405C5503, \
    0x5501, 0x5502
EV_SYN, EV_KEY, KEY_F24 = 0, 1, 194


def tap_f24():
    fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
    try:
        fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
        fcntl.ioctl(fd, UI_SET_KEYBIT, KEY_F24)
        fcntl.ioctl(fd, UI_DEV_SETUP, struct.pack("HHHH80sI", 0x06, 0x1209, 0x5153, 1, b"s15-face wake", 0))
        fcntl.ioctl(fd, UI_DEV_CREATE)
        time.sleep(0.8)   # the compositor adds the new keyboard
        for value in (1, 0):
            os.write(fd, struct.pack("llHHi", 0, 0, EV_KEY, KEY_F24, value))
            os.write(fd, struct.pack("llHHi", 0, 0, EV_SYN, 0, 0))
            time.sleep(0.05)
        time.sleep(0.3)
        fcntl.ioctl(fd, UI_DEV_DESTROY)
    finally:
        os.close(fd)


def greeter_args(uid):
    """The command line of the user's kscreenlocker greeter, or None."""
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            if os.stat(f"/proc/{pid}").st_uid != uid:
                continue
            if open(f"/proc/{pid}/comm").read().strip() != "kscreenlocker_g":
                continue
            return open(f"/proc/{pid}/cmdline", "rb").read().decode(errors="replace").split("\0")
        except OSError:
            continue
    return None


def grace_s(args):
    """Seconds after the lock during which input unlocks without a password; None: never inject (no password)."""
    if "--nolock" in args:
        return None
    if "--immediateLock" in args:
        return 0.0
    if "--graceTime" in args:
        try:
            return int(args[args.index("--graceTime") + 1]) / 1000
        except (IndexError, ValueError):
            return None
    return 0.0


def watch_alive(runtime, mode="watch"):
    pid = (runtime.read() or {}).get("watch")
    if not pid:
        return False
    try:
        return f"s15-face-run\0{mode}".encode() in open(f"/proc/{pid}/cmdline", "rb").read()
    except OSError:
        return False


# --- the login screen (SDDM) without Enter ------------------------------------------------------------------------
# SDDM runs PAM only when a login is submitted. While its greeter is up, s15-face-wake runs `s15-face-run greeter`:
# the lock screen's watch loop, as root, for the login screen's user. A match leaves a token (root's, single use, 15 s,
# bound to the user) and sends SDDM's own greeter message Login(user, empty password, last session) to its greeter
# socket, as the greeter does when Enter is pressed: SDDM runs its PAM stack, where `pam-scan` takes the token
# instead of looking (the face path whose pam_setcred is checked). SDDM 0.21 (src/daemon/SocketServer.cpp,
# Display.cpp) takes Login from any connection to that socket, answers LoginSucceeded/LoginFailed on it and deletes
# it when it closes; Display::login keeps the sender before it checks for a running login. So Login is sent only
# while no login is being checked (no sddm-helper without --greeter), and the connection stays open until SDDM
# answered.

def boottime_ms():
    return int(time.clock_gettime(time.CLOCK_BOOTTIME) * 1000)


def make_token(user, state_dir=STATE_DIR):
    uid = pwd.getpwnam(user).pw_uid
    tmp = f"{state_dir}/.{TOKEN}.{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        os.write(fd, f"uid={uid}\nat={boottime_ms()}\n".encode())
    finally:
        os.close(fd)
    os.rename(tmp, f"{state_dir}/{TOKEN}")


def take_token(user, state_dir=STATE_DIR, life_ms=TOKEN_LIFE_MS):
    """True, once, if a fresh token for user is there. Any token found is used up (renamed first: only one taker)."""
    import stat as st_
    path = f"{state_dir}/{TOKEN}"
    claim = f"{path}.{os.getpid()}"
    try:
        os.rename(path, claim)
    except OSError:
        return False
    try:
        fd = os.open(claim, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            st = os.fstat(fd)
            ours = st_.S_ISREG(st.st_mode) and st.st_uid == 0 and not st.st_mode & 0o077
            d = parse_kv(os.read(fd, 256).decode(errors="replace"))
        finally:
            os.close(fd)
    except OSError:
        return False
    finally:
        try:
            os.unlink(claim)
        except OSError:
            pass
    try:
        uid = pwd.getpwnam(user).pw_uid
    except KeyError:
        return False
    return ours and d.get("uid") == uid and "at" in d and 0 <= boottime_ms() - d["at"] <= life_ms


def proc_procs(comm):
    """(pid, uid, argv) of the processes named comm (as /proc/*/comm shows it, at most 15 characters)."""
    out = []
    for p in os.listdir("/proc"):
        if not p.isdigit():
            continue
        try:
            if open(f"/proc/{p}/comm").read().strip() != comm:
                continue
            argv = open(f"/proc/{p}/cmdline", "rb").read().decode(errors="replace").split("\0")
            out.append((int(p), os.stat(f"/proc/{p}").st_uid, argv))
        except OSError:
            continue
    return out


def sddm_login_running():
    """SDDM checks a login or runs a session: an sddm-helper that is not the greeter's."""
    return any("--greeter" not in argv for _, uid, argv in proc_procs("sddm-helper") if uid == 0)


def sddm_idle(timeout_s):
    """Wait up to timeout_s for SDDM to check no login; True when it checks none."""
    end = time.monotonic() + timeout_s
    while sddm_login_running():
        if time.monotonic() >= end:
            return False
        time.sleep(0.2)
    return True


def sddm_greeter_socket():
    """The socket the SDDM daemon listens on for its greeter, as a path root can connect to (through the daemon's
    root), or None without a running greeter. From the greeter's command line (SDDM starts it with --socket <path>,
    src/daemon/Greeter.cpp): Qt's QLocalServer binds the socket under a temporary name and renames it, so
    /proc/net/unix does not show the real path."""
    daemons = [pid for pid, uid, _ in proc_procs("sddm") if uid == 0]
    for _pid, _uid, argv in proc_procs("sddm-greeter-qt") + proc_procs("sddm-greeter"):
        path = socket_from_argv(argv)
        if path and daemons:
            return f"/proc/{daemons[0]}/root{path}"
    return None


def socket_from_argv(argv):
    """The greeter's --socket argument, if it is one of SDDM's (/tmp/sddm-<display>-<random>, not sddm-auth-*)."""
    if "--socket" in argv:
        i = argv.index("--socket")
        path = argv[i + 1] if i + 1 < len(argv) else ""
        if path.startswith("/tmp/sddm-") and not path.startswith("/tmp/sddm-auth-") and "/.." not in path \
                and path.count("/") == 2:
            return path
    return None


def sddm_last(key, path=SDDM_STATE):
    """[Last] User or Session from SDDM's state file (the user and session the greeter preselects)."""
    try:
        section = ""
        for line in open(path):
            line = line.strip()
            if line.startswith("["):
                section = line
            elif section == "[Last]" and line.startswith(key + "="):
                return line.split("=", 1)[1].strip() or None
    except OSError:
        pass
    return None


def qstring(text):
    b = text.encode("utf-16-be")
    return struct.pack(">I", len(b)) + b


def sddm_login_message(user, session):
    """SDDM's GreeterMessages::Login (src/common/Messages.h) as its greeter sends it (QDataStream): quint32 1,
    QString user, QString password (empty), Session (quint32 type: 1 X11, 2 Wayland; QString its desktop file)."""
    kind = 2 if "/wayland-sessions/" in session else 1
    return struct.pack(">I", 1) + qstring(user) + qstring("") + struct.pack(">I", kind) + qstring(session)


def sddm_login(user, session, sock_path, timeout=30):
    """Sends Login and waits for SDDM's answer: True LoginSucceeded, False LoginFailed (or no answer)."""
    import socket
    c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    c.settimeout(timeout)
    try:
        c.connect(sock_path)
        c.sendall(sddm_login_message(user, session))
        f = c.makefile("rb")

        def u32():
            b = f.read(4)
            if len(b) < 4:
                raise EOFError
            return struct.unpack(">I", b)[0]

        while True:
            msg = u32()
            if msg in (2, 3):              # DaemonMessages::LoginSucceeded, LoginFailed
                return msg == 2
            if msg in (0, 4):              # HostName, InformationMessage: a QString
                n = u32()
                if n != 0xFFFFFFFF:
                    f.read(n)
            elif msg == 1:                 # Capabilities: a quint32
                u32()
            else:
                return False
    except (OSError, EOFError):
        return False
    finally:
        c.close()


def cmd_greeter(user, after_logout=False):
    """(root, s15-face-wake's child while SDDM's greeter is up) the login screen's background scan. after_logout: the
    user's session ended a moment ago (a logout): they are still in front, so the first run waits for Enter or the
    display going off and on, as the lock screen does after Meta+L."""
    if os.geteuid() != 0 or not valid_user(user):
        sys.exit(2)
    parent = os.getppid()
    set_pdeathsig(signal.SIGTERM)
    if parent == 1 or os.getppid() != parent:
        sys.exit(1)
    os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
    fd = os.open(f"{STATE_DIR}/{GREETER}", os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    os.close(fd)
    rt = Runtime(user, name=GREETER, owner=0)
    r = Runner(user, "sddm", Lockout(user), lockout_conf(), parent=parent)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(1))
    me = os.getpid()
    rt.update(lambda d: d.__setitem__("watch", me))

    def on_match():
        make_token(user)
        # A login being checked is usually the Enter on the empty field that asked for this run: it fails at once
        # (cmd_scan), so give it a moment to end, then log in.
        if not sddm_idle(LOGIN_SETTLE_S):
            log(f"{user}: login screen: a login is being checked; the face is there for it for "
                f"{TOKEN_LIFE_MS // 1000} s (Enter on the empty field)")
            return False
        sock, session = sddm_greeter_socket(), sddm_last("Session")
        if not sock or not session:
            log(f"{user}: login screen: SDDM's greeter socket or last session not found; Enter logs in for "
                f"{TOKEN_LIFE_MS // 1000} s")
            return False
        ok = sddm_login(user, session, sock)
        log(f"{user}: login screen: SDDM {'logs in' if ok else 'refused the login'} ({session})")
        return ok

    if after_logout:
        log(f"{user}: login screen right after a logout: face unlock on Enter or when the display was off")
    try:
        sys.exit(watch_loop(r, rt, on_match, start_waiting=after_logout))
    finally:
        r.kill()
        rt.update(lambda d: d.pop("watch", None) if d.get("watch") == me else None)


# --- s15-face-wake: face unlock by itself (root) ---------------------------------------------------------------
# On logind's signals, no polling:
# - after a wake from sleep or hibernation (PrepareForSleep false), the lock screen gets one F24 tap if it shows with
#   the display on within RESUME_WINDOW_S; never after Meta+L or an idle lock (the user is usually in front then);
# - while SDDM's greeter session is active, `s15-face-run greeter` runs (above).

def tap_reason(args, locked_for, watch_running, refused):
    """Why the lock screen gets no tap now, or None. args: the kscreenlocker greeter's command line (None: none
    runs); locked_for: seconds (monotonic) since the session's LockedHint turned on."""
    if args is None:
        return "no lock screen"
    if watch_running:
        return "face unlock runs already"
    grace = grace_s(args)
    if grace is None:
        return "the lock needs no password"
    if locked_for < (grace + 3 if grace else 1):
        return "grace time"
    if refused:
        return f"face refused: {refused[1]}"
    return None


LOGIN1, LOGIN1_PATH = "org.freedesktop.login1", "/org/freedesktop/login1"
MANAGER, SESSION, PROPS = "org.freedesktop.login1.Manager", "org.freedesktop.login1.Session", \
    "org.freedesktop.DBus.Properties"


class Waker:
    def __init__(self, bus, dry_run=False, greeter_cmd=None):
        import dbus
        self.dbus, self.bus, self.dry = dbus, bus, dry_run
        # no introspection: a proxy is made once and calls go straight out
        self.mgr = dbus.Interface(bus.get_object(LOGIN1, LOGIN1_PATH, introspect=False), MANAGER)
        self.proxies = {}
        self.started = time.monotonic()
        self.locked_since = {}      # session path -> monotonic time LockedHint turned on
        self.resume_until = 0.0
        self.taps, self.last_tap, self.told = 0, 0.0, set()
        self.ticking = False
        self.greeter, self.greeter_session = None, None
        self.user_sessions, self.user_ended = set(), -1e9   # user sessions seen; when one ended (monotonic)
        self.greeter_after_logout = False
        self.greeter_cmd = greeter_cmd or [sys.executable, "-I", os.path.abspath(__file__), "greeter"]

    def props(self, path):
        p = self.proxies.get(path)
        if p is None:
            p = self.proxies[path] = self.dbus.Interface(self.bus.get_object(LOGIN1, path, introspect=False), PROPS)
        return p.GetAll(SESSION)

    def sessions(self):
        out = []
        for _sid, _uid, _user, _seat, path in self.mgr.ListSessions():
            try:
                out.append((str(path), self.props(path)))
            except self.dbus.DBusException:
                self.proxies.pop(str(path), None)
        self.user_sessions |= {p for p, s in out if s["Class"] == "user"}
        return out

    # logind's signals
    def on_sleep(self, going):
        if going:
            self.resume_until = 0.0
            return
        self.resume_until = time.monotonic() + RESUME_WINDOW_S
        self.taps, self.told = 0, set()
        log(f"wake: woke from sleep: face unlock on the lock screen once it shows{' (dry run)' if self.dry else ''}")
        self.tick_start()

    def on_props(self, iface, changed, _invalidated, path=None):
        if iface != SESSION or path is None:
            return
        if "LockedHint" in changed:
            if changed["LockedHint"]:
                self.locked_since.setdefault(path, time.monotonic())
            else:
                self.locked_since.pop(path, None)
        if "Active" in changed or "State" in changed:
            self.check_greeter()

    def on_sessions(self, _sid, path):
        path = str(path)
        self.proxies.pop(path, None)
        if path in self.user_sessions:          # SessionRemoved of a user's session: a logout (or a crash)
            self.user_sessions.discard(path)
            self.user_ended = time.monotonic()
        self.check_greeter()

    # the lock screen after a wake
    def tick_start(self):
        if not self.ticking:
            from gi.repository import GLib
            self.ticking = True
            GLib.timeout_add(500, self.tick)

    def tick(self):
        now = time.monotonic()
        if now > self.resume_until or self.taps >= 2:
            self.ticking = False
            return False
        if now - self.last_tap < 5 or not display_on() or lid_closed():
            return True
        try:
            sessions = self.sessions()
        except self.dbus.DBusException as e:
            log(f"wake: logind: {e}")
            return True
        for path, s in sessions:
            user = str(s["Name"])
            if not (s["Class"] == "user" and s["Type"] in ("wayland", "x11") and s["Active"] and not s["Remote"]
                    and s["LockedHint"] and valid_user(user)):
                continue
            since = self.locked_since.setdefault(path, self.started)
            why = tap_reason(greeter_args(int(s["User"][0])), now - since,
                             watch_alive(Runtime(user)), refusal(user, Lockout(user), lockout_conf()))
            if why:
                if why not in self.told:
                    self.told.add(why)
                    log(f"wake: {user}: no tap: {why}")
                if why == "face unlock runs already":
                    self.taps = 2
                continue
            self.taps += 1
            self.last_tap = now
            log(f"wake: {user}: lock screen after a wake, no face unlock running: F24 to start it"
                f"{' (dry run)' if self.dry else ''}")
            if not self.dry:
                try:
                    tap_f24()
                except OSError as e:
                    log(f"wake: /dev/uinput: {e}")
        return True

    # the login screen
    def check_greeter(self):
        try:
            sessions = self.sessions()
        except self.dbus.DBusException as e:
            log(f"wake: logind: {e}")
            return
        active = [path for path, s in sessions
                  if s["Class"] == "greeter" and s["Active"] and str(s["Seat"][0]) == "seat0"]
        if active and self.greeter is None and active[0] != self.greeter_session:
            user = sddm_last("User") or default_user()
            self.greeter_session = active[0]
            if not valid_user(user):
                return
            after_logout = time.monotonic() - self.user_ended < 60
            log(f"wake: login screen up: face unlock for {user}"
                f"{' on Enter (just logged out)' if after_logout else ' without Enter'}{' (dry run)' if self.dry else ''}")
            self.greeter_after_logout = after_logout
            if not self.dry:
                self.greeter = subprocess.Popen(self.greeter_cmd + [user] + (["after-logout"] if after_logout else []),
                                                stdin=subprocess.DEVNULL,
                                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                                preexec_fn=lambda: set_pdeathsig(signal.SIGTERM))
                from gi.repository import GLib
                GLib.timeout_add(2000, self.greeter_poll)
        elif not active:
            self.greeter_session = None
            self.stop_greeter()

    def greeter_poll(self):
        if self.greeter is None:
            return False
        if self.greeter.poll() is not None:
            self.greeter = None
            return False
        return True

    def stop_greeter(self):
        g, self.greeter = self.greeter, None
        if g is None or g.poll() is not None:
            return
        log("wake: login screen gone: its face unlock stops")
        g.terminate()
        try:
            g.wait(3)
        except subprocess.TimeoutExpired:
            kill_tree(g)


def default_user():
    for d in ("/etc/sddm.conf.d", "/usr/lib/sddm/sddm.conf.d"):
        try:
            for f in sorted(os.listdir(d), reverse=True):
                for line in open(os.path.join(d, f), errors="replace"):
                    if line.startswith("User=") and line.strip()[5:]:
                        return line.strip()[5:]
        except OSError:
            continue
    return "steamos"


def cmd_wake(dry_run=False, simulate_resume=False):
    import dbus
    from dbus.mainloop.glib import DBusGMainLoop
    from gi.repository import GLib
    DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()
    w = Waker(bus, dry_run)
    bus.add_signal_receiver(w.on_sleep, "PrepareForSleep", MANAGER, LOGIN1, LOGIN1_PATH)
    bus.add_signal_receiver(w.on_props, "PropertiesChanged", PROPS, LOGIN1, path_keyword="path")
    bus.add_signal_receiver(w.on_sessions, "SessionNew", MANAGER, LOGIN1, LOGIN1_PATH)
    bus.add_signal_receiver(w.on_sessions, "SessionRemoved", MANAGER, LOGIN1, LOGIN1_PATH)
    for path, s in w.sessions():
        if s["LockedHint"]:
            w.locked_since[path] = w.started
    w.check_greeter()
    if simulate_resume:
        w.on_sleep(False)
    loop = GLib.MainLoop()

    def stop():
        w.stop_greeter()
        loop.quit()
        return False
    for sig in (signal.SIGTERM, signal.SIGINT):
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, sig, stop)
    loop.run()


def cmd_state(user):
    print(f"display: {'on' if display_on() else 'off'}, lid: {'closed' if lid_closed() else 'open'}")
    if user:
        conf, lk = lockout_conf(), Lockout(user)
        try:
            d = lk.get()
            wait = d["until"] - time.time()
            count = (f"{d['fails']} false faces since the last success (off after {conf['off_after']})"
                     f"{f', face waits {int(wait) + 1} s' if wait > 0 else ''}")
        except OSError as e:
            count = f"count of false faces unreadable ({e})"
        print(f"{user}: {count}; lock screen face unlock "
              f"{'running' if watch_alive(Runtime(user)) else 'not running'}")
        why = refusal(user, lk, conf)
        print(f"  face now: {'refused: ' + why[1] if why else 'allowed'}")


def write_lockout(conf, path=LOCKOUT_CONF):
    """The values that differ from the defaults (a default changed later applies then), root's, renamed into place."""
    lines = ["# Face unlock lockout (docs/login.md#face-unlock). Set with: sudo s15-face lockout set KEY VALUE",
             "# Missing, invalid or out-of-range values: the defaults (s15-face lockout keys)."]
    lines += [f"{k}={conf[k]}" for k in LOCKOUT_KEYS if conf[k] != LOCKOUT_KEYS[k][0]]
    tmp = f"{path}.new"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
    try:
        os.fchown(fd, 0, 0)
        os.fchmod(fd, 0o644)
        os.write(fd, ("\n".join(lines) + "\n").encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    os.rename(tmp, path)


def cmd_lockout(args, path=LOCKOUT_CONF):
    """s15-face lockout: key=value lines (in effect); keys: KEY DEFAULT MIN MAX UNIT MEANING lines; set KEY VALUE
    [KEY VALUE ...] (all checked first, then written at once; the Biopass app sends its changes so) and
    reset-defaults (root): the new values as key=value lines. Exit 0; 2 for a bad key, value or usage (nothing
    written); 1 not root or not written."""
    def show(conf):
        for k in LOCKOUT_KEYS:
            print(f"{k}={conf[k]}")
    if not args:
        show(lockout_conf(path))
        return 0
    if args == ["keys"]:
        for k, (default, lo, hi, unit, what) in LOCKOUT_KEYS.items():
            print(f"{k} {default} {lo} {hi} {unit} {what}")
        return 0
    if args[0] not in ("set", "reset-defaults") or \
            (args[0] == "set" and (len(args) < 3 or len(args) % 2 == 0)) or \
            (args[0] == "reset-defaults" and len(args) != 1):
        print("usage: s15-face lockout [keys | set KEY VALUE [KEY VALUE ...] | reset-defaults]", file=sys.stderr)
        return 2
    conf = lockout_conf(path)
    if args[0] == "set":
        for k, v in zip(args[1::2], args[2::2]):
            if k not in LOCKOUT_KEYS:
                print(f"s15-face lockout: unknown key {k} (s15-face lockout keys)", file=sys.stderr)
                return 2
            lo, hi = LOCKOUT_KEYS[k][1:3]
            if not (v.isdigit() and lo <= int(v) <= hi):
                print(f"s15-face lockout: {k} must be a whole number from {lo} to {hi}", file=sys.stderr)
                return 2
            conf[k] = int(v)
    else:
        conf = {k: d[0] for k, d in LOCKOUT_KEYS.items()}
    if os.geteuid() != 0:
        print("s15-face lockout: run as root (sudo, or pkexec)", file=sys.stderr)
        return 1
    try:
        if args[0] == "reset-defaults":
            if os.path.lexists(path):
                os.unlink(path)
        else:
            write_lockout(conf, path)
    except OSError as e:
        print(f"s15-face lockout: {path}: {e}", file=sys.stderr)
        return 1
    log(f"lockout: {' '.join(args)} (by uid {os.getuid()})")
    show(lockout_conf(path))
    return 0


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "watch":
        cmd_watch()
    elif cmd == "scan":
        cmd_scan()
    elif cmd == "gate":
        cmd_gate()
    elif cmd == "rescan":
        cmd_rescan()
    elif cmd == "ok":
        cmd_ok()
    elif cmd == "account":
        cmd_account()
    elif cmd == "serve":
        cmd_serve()
    elif cmd == "reset" and len(sys.argv) > 2 and valid_user(sys.argv[2]):
        cmd_reset(sys.argv[2])
    elif cmd == "wake":
        if os.getuid() != 0:
            sys.exit("s15-face-run wake: run as root")
        cmd_wake(dry_run="--dry-run" in sys.argv, simulate_resume="--simulate-resume" in sys.argv)
    elif cmd == "greeter" and len(sys.argv) > 2:
        cmd_greeter(sys.argv[2], after_logout="after-logout" in sys.argv[3:])
    elif cmd == "lockout":
        sys.exit(cmd_lockout(sys.argv[2:]))
    elif cmd == "state":
        cmd_state(sys.argv[2] if len(sys.argv) > 2 and valid_user(sys.argv[2]) else "")
    else:
        print(__doc__.strip())
        sys.exit(2)


if __name__ == "__main__":
    main()
