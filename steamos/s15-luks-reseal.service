[Unit]
Description=Keep the TPM unlock of the encrypted SteamOS partition matching the boot entries
Documentation=file:///usr/local/sbin/s15-luks-reseal
ConditionPathExists=/var/lib/s15-luks/reseal.key
After=local-fs.target tpm2.target

[Service]
# In the background: enrolling a token takes a few seconds of CPU; the desktop must not wait for it.
Type=exec
Nice=19
IOSchedulingClass=idle
ExecStart=/usr/local/sbin/s15-luks-reseal

[Install]
WantedBy=multi-user.target
