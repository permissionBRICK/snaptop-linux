#!/bin/sh
# Start or check the internal display (docs/known-issues.md, "Display takeover").
# In about 1 boot in 10 the first frame after the display driver (msm) takes over from the firmware fails on the
# eDP path ("[dpu error]enc42 intf5 ctl 1 reset failure", frame done and vblank timeouts). Further frames then fail
# too: the console waits a second per frame, the screen keeps its last image (blue), and the system crawls until a
# full mode set (the desktop's) restarts the display. Here the console's framebuffer is blanked and unblanked once,
# which disables and re-enables the display path.
#   s15-display-check load   (initramfs, before a passphrase prompt) load msm first, then check
#   s15-display-check        (SteamOS, udev when fb0 appears) check only
FB=/sys/class/graphics/fb0
DONE=/run/s15-display-checked   # /run survives the switch to SteamOS: check once per boot
log() { echo "s15-display-check: $*" > /dev/kmsg; }
[ -e "$DONE" ] && exit 0
if [ "$1" = load ]; then
  modprobe msm
fi
i=0
while [ ! -e "$FB" ] && [ $i -lt 100 ]; do sleep 0.1; i=$((i + 1)); done
[ -e "$FB" ] || { log "no framebuffer after 10 s"; exit 0; }
sleep 1
: > "$DONE"
if dmesg | grep -q -E "ctl [0-9]+ reset failure|frame done timeout"; then
  log "display start failed - blanking and unblanking the console to restart the display path"
  echo 1 > "$FB/blank"; sleep 0.5; echo 0 > "$FB/blank"
  sleep 1
  n=$(dmesg | grep -c -E "ctl [0-9]+ reset failure|frame done timeout")
  sleep 2
  if [ "$(dmesg | grep -c -E "ctl [0-9]+ reset failure|frame done timeout")" = "$n" ]; then
    log "display restarted"
  else
    log "display still failing"
  fi
fi
exit 0
