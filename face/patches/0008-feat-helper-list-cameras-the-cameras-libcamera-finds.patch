diff --git a/auth/face/common/camera_list.h b/auth/face/common/camera_list.h
new file mode 100644
index 0000000..0305b73
--- /dev/null
+++ b/auth/face/common/camera_list.h
@@ -0,0 +1,40 @@
+#pragma once
+
+#include <string>
+#include <vector>
+
+#include "camera_capture.h"
+
+namespace biopass {
+
+// One line per camera for `biopass-helper list-cameras`, read by the app:
+//   <id> TAB <mono|colour> TAB <video paths, space-separated> TAB <model> NL
+// The id is what config.yaml's `camera` and `anti_spoofing.ir_camera` take
+// (findCameraByPath accepts it): platform cameras behind one CSI-2 receiver
+// can share all their video nodes, so only the id names one of them. Tabs
+// and line breaks inside a field become spaces, so every line has 4 fields.
+inline std::string formatCameraList(const std::vector<CameraDeviceInfo>& cameras) {
+  const auto clean = [](std::string text) {
+    for (char& c : text) {
+      if (c == '\t' || c == '\n' || c == '\r') {
+        c = ' ';
+      }
+    }
+    return text;
+  };
+  std::string out;
+  for (const auto& camera : cameras) {
+    std::string paths;
+    for (const auto& path : camera.video_paths) {
+      if (!paths.empty()) {
+        paths += ' ';
+      }
+      paths += clean(path);
+    }
+    out += clean(camera.id) + '\t' + (camera.mono ? "mono" : "colour") + '\t' + paths + '\t' +
+           clean(camera.model) + '\n';
+  }
+  return out;
+}
+
+}  // namespace biopass
