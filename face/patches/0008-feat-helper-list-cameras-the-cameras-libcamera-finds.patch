diff --git a/auth/test/camera_list/main.cpp b/auth/test/camera_list/main.cpp
new file mode 100644
index 0000000..70f6292
--- /dev/null
+++ b/auth/test/camera_list/main.cpp
@@ -0,0 +1,49 @@
+// Checks the line format of `biopass-helper list-cameras`
+// (face/common/camera_list.h), which the app parses (cameras.rs). Exits
+// non-zero on any failure.
+
+#include <cstdio>
+#include <string>
+
+#include "common/camera_list.h"
+
+namespace {
+
+int g_failures = 0;
+
+void expect(bool cond, const char* what) {
+  std::printf("[%s] %s\n", cond ? "PASS" : "FAIL", what);
+  if (!cond) {
+    g_failures++;
+  }
+}
+
+}  // namespace
+
+int main() {
+  using biopass::CameraDeviceInfo;
+  using biopass::formatCameraList;
+
+  expect(formatCameraList({}).empty(), "no cameras: no lines");
+
+  CameraDeviceInfo ir{"/base/soc@0/cci@ac15000/i2c-bus@0/camera@24",
+                      "hm1092",
+                      {"/dev/video0", "/dev/video1"},
+                      true};
+  CameraDeviceInfo colour{"/base/soc@0/cci@ac16000/i2c-bus@1/camera@36", "ov02c10", {}, false};
+  expect(formatCameraList({ir, colour}) ==
+             "/base/soc@0/cci@ac15000/i2c-bus@0/camera@24\tmono\t/dev/video0 /dev/video1\thm1092\n"
+             "/base/soc@0/cci@ac16000/i2c-bus@1/camera@36\tcolour\t\tov02c10\n",
+         "id, mono or colour, video paths, model");
+
+  CameraDeviceInfo odd{"usb\tcam", "Integrated\nCamera", {"/dev/video\t2"}, false};
+  expect(formatCameraList({odd}) == "usb cam\tcolour\t/dev/video 2\tIntegrated Camera\n",
+         "tabs and line breaks in fields become spaces");
+
+  if (g_failures != 0) {
+    std::printf("%d FAILED\n", g_failures);
+    return 1;
+  }
+  std::printf("ALL PASS\n");
+  return 0;
+}
