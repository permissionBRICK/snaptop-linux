@@ -0,0 +1,80 @@
+import { useEffect, useState } from "react";
+import { cmd } from "@/commands";
+import type { CameraInfo, VideoDeviceInfo } from "@/types/config";
+
+export interface CameraChoice {
+  /** What config.yaml saves: a libcamera id or a video device path. */
+  value: string;
+  label: string;
+  /** IR, colour or a video device, and the id. */
+  details: string;
+  mono: boolean;
+}
+
+/**
+ * The cameras to choose from: libcamera's (by id; cameras behind one CSI-2
+ * receiver share their video nodes, so only the id tells them apart), then
+ * the video devices that belong to none of them (e.g. a USB camera libcamera
+ * does not drive). Listed once on mount.
+ */
+export function cameraChoices(
+  cameras: readonly CameraInfo[],
+  devices: readonly VideoDeviceInfo[],
+): CameraChoice[] {
+  const owned = new Set(cameras.flatMap((c) => c.video_paths));
+  return [
+    ...cameras.map((c) => ({
+      value: c.id,
+      label: c.model,
+      details: `${c.mono ? "IR (monochrome)" : "Colour"} · ${c.id}`,
+      mono: c.mono,
+    })),
+    ...devices
+      .filter((d) => !d.aliases.some((a) => owned.has(a)))
+      .map((d) => ({
+        value: d.path,
+        label: d.label,
+        details: d.details || d.path,
+        mono: false,
+      })),
+  ];
+}
+
+export function useCameras(): {
+  cameras: CameraInfo[];
+  choices: CameraChoice[];
+  loaded: boolean;
+  error: string | null;
+} {
+  const [state, setState] = useState<{
+    cameras: CameraInfo[];
+    devices: VideoDeviceInfo[];
+    loaded: boolean;
+    error: string | null;
+  }>({ cameras: [], devices: [], loaded: false, error: null });
+
+  useEffect(() => {
+    let cancelled = false;
+    Promise.allSettled([cmd.face.listCameras(), cmd.face.listVideoDevices()])
+      .then(([cameras, devices]) => {
+        if (cancelled) return;
+        setState({
+          cameras: cameras.status === "fulfilled" ? cameras.value : [],
+          devices: devices.status === "fulfilled" ? devices.value : [],
+          loaded: true,
+          error: cameras.status === "rejected" ? String(cameras.reason) : null,
+        });
+      })
+      .catch(() => {});
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  return {
+    cameras: state.cameras,
+    choices: cameraChoices(state.cameras, state.devices),
+    loaded: state.loaded,
+    error: state.error,
+  };
+}
