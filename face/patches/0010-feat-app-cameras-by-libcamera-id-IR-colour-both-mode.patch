index 0000000..1b43cbe
--- /dev/null
+++ b/app/src/app/configuration/-components/face/FaceEnrolment.tsx
@@ -0,0 +1,199 @@
+import { listen, type UnlistenFn } from "@tauri-apps/api/event";
+import { Camera, Circle, Loader2, Repeat, Square } from "lucide-react";
+import { useEffect, useRef, useState } from "react";
+import { toast } from "sonner";
+import { cmd } from "@/commands";
+import { Button } from "@/components/ui/button";
+import { enrolmentCameras } from "./faceMode";
+import { usePreviewSession } from "./usePreviewSession";
+
+/** Pictures the guided enrolment takes, as `s15-face enrol` does. */
+export const GUIDED_COUNT = 5;
+
+interface Props {
+  face: Parameters<typeof enrolmentCameras>[0];
+  /** Why enrolment is not possible now (unsaved camera settings), or null. */
+  blocked: string | null;
+  /** After faces were added. */
+  onAdded: () => void;
+}
+
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+/**
+ * Adds faces with the saved settings' cameras: the main camera's into
+ * faces/, and in both mode a pair per picture, the IR camera's into
+ * faces-ir/ (the preview switches to the IR camera and back: the cameras
+ * stream one at a time).
+ */
+export function FaceEnrolment({ face, blocked, onAdded }: Props) {
+  const previewRef = useRef<HTMLImageElement>(null);
+  const { main, pairIr } = enrolmentCameras(face);
+  const [busy, setBusy] = useState(false);
+  const [progress, setProgress] = useState<string | null>(null);
+  const cancelRef = useRef(false);
+  const {
+    active: capturing,
+    start,
+    stop,
+  } = usePreviewSession(
+    main,
+    (err) => toast.error(`Failed to start the camera: ${err}`),
+    () => previewRef.current?.removeAttribute("src"),
+  );
+
+  useEffect(() => {
+    if (!capturing) return;
+    let unlisten: UnlistenFn | undefined;
+    let cancelled = false;
+    listen<string>("face-preview-frame", (event) => {
+      if (previewRef.current) {
+        previewRef.current.src = `data:image/jpeg;base64,${event.payload}`;
+      }
+    }).then((u) => {
+      if (cancelled) u();
+      else unlisten = u;
+    });
+    return () => {
+      cancelled = true;
+      unlisten?.();
+    };
+  }, [capturing]);
+
+  // Leaving a blocked state (e.g. unsaved cameras) stops the preview.
+  useEffect(() => {
+    if (blocked) stop();
+  }, [blocked, stop]);
+
+  async function captureOnce(): Promise<boolean> {
+    try {
+      await cmd.face.captureInSession(pairIr);
+      return true;
+    } catch (err) {
+      setProgress(`${err}`);
+      return false;
+    }
+  }
+
+  async function single() {
+    setBusy(true);
+    setProgress(pairIr ? "Colour and IR picture..." : null);
+    if (await captureOnce()) {
+      toast.success(pairIr ? "Face pair saved" : "Face saved");
+      setProgress(null);
+      onAdded();
+    }
+    setBusy(false);
+  }
+
+  async function guided() {
+    setBusy(true);
+    cancelRef.current = false;
+    let saved = 0;
+    let tries = 0;
+    while (saved < GUIDED_COUNT && tries < GUIDED_COUNT * 3) {
+      if (cancelRef.current) break;
+      tries++;
+      setProgress(
+        `${saved}/${GUIDED_COUNT} saved. Look at the screen as you usually do; turn your head a little between pictures.`,
+      );
+      await sleep(pairIr ? 1000 : 2000);
+      if (cancelRef.current) break;
+      if (await captureOnce()) saved++;
+    }
+    setProgress(
+      `${saved} of ${GUIDED_COUNT} ${pairIr ? "face pairs" : "faces"} added.`,
+    );
+    if (saved > 0) onAdded();
+    setBusy(false);
+  }
+
+  const cameraText = pairIr
+    ? "the colour camera, each with an IR picture"
+    : face.camera === face.anti_spoofing.ir_camera
+      ? "the IR camera"
+      : "the colour camera";
+
+  return (
+    <div className="grid gap-3">
+      <div>
+        <h4 className="font-medium text-sm flex items-center gap-2">
+          <Camera className="w-4 h-4" />
+          Add faces
+        </h4>
+        <p className="text-xs text-muted-foreground">
+          {blocked ??
+            `With ${cameraText}. Sit as you usually do; add a few with and without glasses.`}
+        </p>
+      </div>
+
+      <div className="relative aspect-video bg-black rounded-lg overflow-hidden">
+        <img
+          ref={previewRef}
+          alt="Camera preview"
+          className={`w-full h-full object-contain ${capturing ? "" : "hidden"}`}
+        />
+        {!capturing && (
+          <div className="absolute inset-0 flex items-center justify-center text-muted-foreground">
+            <Camera className="w-12 h-12 opacity-50" />
+          </div>
+        )}
+      </div>
+
+      <div className="flex gap-2">
+        {!capturing ? (
+          <Button
+            type="button"
+            onClick={start}
+            disabled={!!blocked || !main}
+            className="flex-1"
+          >
+            <Camera className="w-4 h-4 mr-2" />
+            Start camera
+          </Button>
+        ) : (
+          <>
+            <Button
+              type="button"
+              onClick={guided}
+              disabled={busy}
+              className="flex-1"
+            >
+              {busy ? (
+                <Loader2 className="w-4 h-4 mr-2 animate-spin" />
+              ) : (
+                <Repeat className="w-4 h-4 mr-2" />
+              )}
+              Add {GUIDED_COUNT}
+            </Button>
+            <Button
+              type="button"
+              variant="outline"
+              onClick={single}
+              disabled={busy}
+            >
+              <Circle className="w-4 h-4 mr-2" />
+              Capture one
+            </Button>
+            <Button
+              type="button"
+              variant="outline"
+              onClick={() => {
+                cancelRef.current = true;
+                if (!busy) stop();
+              }}
+            >
+              <Square className="w-4 h-4 mr-2" />
+              {busy ? "Cancel" : "Stop"}
+            </Button>
+          </>
+        )}
+      </div>
+      {progress && (
+        <p className="text-xs text-muted-foreground" aria-live="polite">
+          {progress}
+        </p>
+      )}
+    </div>
+  );
+}
