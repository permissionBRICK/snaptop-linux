+import { useCallback, useEffect, useState } from "react";
+import { cmd } from "@/commands";
+import type { FaceSet } from "@/types/config";
+
+/** The enrolled faces of every face directory, reloaded on `reload()`. */
+export function useFaceSets(version: number) {
+  const [sets, setSets] = useState<FaceSet[]>([]);
+
+  const reload = useCallback(async () => {
+    try {
+      setSets(await cmd.face.listSets());
+    } catch (err) {
+      console.error("Failed to list the enrolled faces:", err);
+    }
+  }, []);
+
+  // `version` changes on every save, which may move the faces.
+  useEffect(() => {
+    void reload();
+  }, [reload, version]);
+
+  return { sets, reload };
+}
