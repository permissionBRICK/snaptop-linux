+
+/// A directory of enrolled faces in the data dir. Faces match only the
+/// camera that took them, so each camera keeps its own:
+#[derive(Debug, Serialize, Deserialize, Clone, Copy, PartialEq, Eq, specta::Type)]
+pub enum FaceDir {
+    /// faces/: the main camera's (`camera`), which the helper matches.
+    #[serde(rename = "faces")]
+    Main,
+    /// faces-ir/: the IR camera's while another camera is the main one; the
+    /// helper matches them with `anti_spoofing.ir_recognition`.
+    #[serde(rename = "faces-ir")]
+    Ir,
+    /// faces-rgb/: the colour camera's, kept aside while the IR camera is the
+    /// main one; the helper never reads them.
+    #[serde(rename = "faces-rgb")]
+    Colour,
+}
+
+impl FaceDir {
+    pub const ALL: [FaceDir; 3] = [FaceDir::Main, FaceDir::Ir, FaceDir::Colour];
+
+    pub fn name(self) -> &'static str {
+        match self {
+            FaceDir::Main => "faces",
+            FaceDir::Ir => "faces-ir",
+            FaceDir::Colour => "faces-rgb",
+        }
+    }
+
+    pub fn path_in(self, data_dir: &Path) -> PathBuf {
+        data_dir.join(self.name())
+    }
+}
+
+/// The face images in one face directory.
+#[derive(Debug, Serialize, Clone, PartialEq, specta::Type)]
+pub struct FaceSet {
+    pub dir: FaceDir,
+    pub paths: Vec<String>,
+}
+
+/// Every face directory with its images (empty when it is missing), in
+/// FaceDir::ALL's order.
+#[tauri::command]
+#[specta::specta]
+pub fn list_face_sets(app: AppHandle) -> Result<Vec<FaceSet>, String> {
+    face_sets_in(&get_data_dir(&app)?)
+}
+
+fn face_sets_in(data_dir: &Path) -> Result<Vec<FaceSet>, String> {
+    FaceDir::ALL
+        .into_iter()
+        .map(|dir| {
+            let path = dir.path_in(data_dir);
+            let paths = if path.exists() {
+                face_files_in(&path)?
+            } else {
+                Vec::new()
+            };
+            Ok(FaceSet { dir, paths })
+        })
+        .collect()
+}
 
