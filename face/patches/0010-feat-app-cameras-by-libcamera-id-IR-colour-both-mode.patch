+import { createContext, useContext } from "react";
+import type { BiopassConfig } from "@/types/config";
+
+export interface SavedSettings {
+  /**
+   * config.yaml as last loaded or saved (camera profiles of an older save
+   * read as the camera settings): the helper and the face directories follow
+   * it, so enrolment and the test scan use it, not the form.
+   */
+  config: BiopassConfig;
+  /** Bumped on every save: a save may move the enrolled faces. */
+  version: number;
+  /** The file had camera profiles, which the next save replaces. */
+  hadProfiles: boolean;
+}
+
+export const SavedSettingsContext = createContext<SavedSettings | null>(null);
+
+export function useSavedSettings(): SavedSettings {
+  const saved = useContext(SavedSettingsContext);
+  if (!saved) throw new Error("useSavedSettings outside SavedSettingsContext");
+  return saved;
+}
