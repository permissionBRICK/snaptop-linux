+/// Whether `face`'s main camera is its IR camera (the IR camera recognises):
+/// then faces/ holds IR faces. With camera profiles, the first one's cameras
+/// (an older save of the app).
+pub fn main_camera_is_ir(face: &FaceMethodConfig) -> bool {
+    let (main, ir) = match face.camera_profiles.first() {
+        Some(profile) => (
+            profile.camera.as_deref(),
+            profile
+                .ir_camera
+                .as_deref()
+                .or(face.anti_spoofing.ir_camera.as_deref()),
+        ),
+        None => (
+            face.camera.as_deref(),
+            face.anti_spoofing.ir_camera.as_deref(),
+        ),
+    };
+    matches!((main, ir), (Some(main), Some(ir)) if !main.is_empty() && main == ir)
+}
