diff --git a/app/src/app/configuration/-components/face/faceMode.test.ts b/app/src/app/configuration/-components/face/faceMode.test.ts
new file mode 100644
index 0000000..5965358
--- /dev/null
+++ b/app/src/app/configuration/-components/face/faceMode.test.ts
@@ -0,0 +1,240 @@
+import { describe, expect, test } from "bun:test";
+import type { BiopassConfig, CameraInfo, FaceSet } from "@/types/config";
+import {
+  colourCameraOf,
+  defaultCameras,
+  enrolledPerCamera,
+  enrolmentCameras,
+  faceDirRole,
+  faceModeOf,
+  mainIsIr,
+  missingFaces,
+  RECOMMENDED_MIN_FACE_HEIGHT,
+  RECOMMENDED_THRESHOLD,
+  withFaceMode,
+  withoutCameraProfiles,
+} from "./faceMode";
+
+const IR = "/base/soc@0/cci@ac15000/i2c-bus@0/camera@24";
+const RGB = "/base/soc@0/cci@ac16000/i2c-bus@1/camera@36";
+
+function config(): BiopassConfig {
+  return {
+    schema_version: 2,
+    strategy: {
+      debug: false,
+      execution_mode: "parallel",
+      order: ["face", "fingerprint"],
+      ignore_services: ["polkit-1", "pkexec"],
+    },
+    methods: {
+      face: {
+        enable: true,
+        retries: 5,
+        retry_delay: 200,
+        camera: null,
+        camera_profiles: [],
+        detection: {
+          model_id: "yolov8n-face",
+          threshold: 0.5,
+          min_face_height: 0,
+        },
+        recognition: { model_id: "edgeface-s-gamma-05", threshold: 0.5 },
+        anti_spoofing: {
+          enable: false,
+          model: { model_id: "mobilenetv3-antispoof", threshold: 0.8 },
+          ir_camera: null,
+          ir_warmup_delay_ms: 300,
+          ir_presence_timeout_ms: 1500,
+          ir_recognition: false,
+        },
+      },
+      fingerprint: { enable: false, retries: 1, timeout: 5000 },
+    },
+    appearance: "system",
+  };
+}
+
+const face = () => config().methods.face;
+
+describe("faceModeOf", () => {
+  test("no camera or no IR camera: no mode", () => {
+    expect(faceModeOf(face())).toBeNull();
+    expect(faceModeOf({ ...face(), camera: RGB })).toBeNull();
+  });
+
+  test("the IR camera as the main camera is ir", () => {
+    const f = withFaceMode(face(), "ir", { ir: IR, colour: RGB });
+    expect(f.camera).toBe(IR);
+    expect(faceModeOf(f)).toBe("ir");
+    expect(mainIsIr(f)).toBe(true);
+  });
+
+  test("the colour camera recognises in rgb and both", () => {
+    const rgb = withFaceMode(face(), "rgb", { ir: IR, colour: RGB });
+    const both = withFaceMode(face(), "both", { ir: IR, colour: RGB });
+    expect(faceModeOf(rgb)).toBe("rgb");
+    expect(faceModeOf(both)).toBe("both");
+    expect(rgb.anti_spoofing.ir_recognition).toBe(false);
+    expect(both.anti_spoofing.ir_recognition).toBe(true);
+    expect(mainIsIr(both)).toBe(false);
+  });
+
+  test("camera profiles: no mode (face unlock refuses them)", () => {
+    const f = withFaceMode(face(), "ir", { ir: IR, colour: RGB });
+    expect(
+      faceModeOf({
+        ...f,
+        camera_profiles: [
+          { camera: IR, ir_camera: IR, allow_without_ir: false },
+        ],
+      }),
+    ).toBeNull();
+  });
+});
+
+describe("withFaceMode", () => {
+  test("writes the recommended minimum face height and threshold", () => {
+    const f = withFaceMode(face(), "ir", { ir: IR, colour: RGB });
+    expect(f.detection.min_face_height).toBe(RECOMMENDED_MIN_FACE_HEIGHT);
+    expect(f.recognition.threshold).toBe(RECOMMENDED_THRESHOLD);
+    expect(f.camera_profiles).toEqual([]);
+  });
+
+  test("keeps stricter values the user chose", () => {
+    const strict = face();
+    strict.detection.min_face_height = 0.3;
+    strict.recognition.threshold = 0.7;
+    const f = withFaceMode(strict, "both", { ir: IR, colour: RGB });
+    expect(f.detection.min_face_height).toBe(0.3);
+    expect(f.recognition.threshold).toBe(0.7);
+  });
+
+  test("anti-spoofing goes off in ir and stays as it was otherwise", () => {
+    const on = face();
+    on.anti_spoofing.enable = true;
+    expect(
+      withFaceMode(on, "ir", { ir: IR, colour: RGB }).anti_spoofing.enable,
+    ).toBe(false);
+    expect(
+      withFaceMode(on, "rgb", { ir: IR, colour: RGB }).anti_spoofing.enable,
+    ).toBe(true);
+  });
+
+  test("other settings are kept", () => {
+    const f = face();
+    f.retries = 3;
+    f.anti_spoofing.ir_presence_timeout_ms = 900;
+    const out = withFaceMode(f, "rgb", { ir: IR, colour: RGB });
+    expect(out.retries).toBe(3);
+    expect(out.anti_spoofing.ir_presence_timeout_ms).toBe(900);
+    expect(out.detection.model_id).toBe("yolov8n-face");
+  });
+});
+
+describe("withoutCameraProfiles", () => {
+  test("the first profile's cameras become the camera settings", () => {
+    const c = config();
+    c.methods.face.camera_profiles = [
+      { camera: IR, ir_camera: IR, allow_without_ir: false },
+      { camera: RGB, ir_camera: null, allow_without_ir: true },
+    ];
+    const { config: out, hadProfiles } = withoutCameraProfiles(c);
+    expect(hadProfiles).toBe(true);
+    expect(out.methods.face.camera_profiles).toEqual([]);
+    expect(out.methods.face.camera).toBe(IR);
+    expect(out.methods.face.anti_spoofing.ir_camera).toBe(IR);
+    expect(faceModeOf(out.methods.face)).toBe("ir");
+  });
+
+  test("a profile without an IR camera keeps the fallback one", () => {
+    const c = config();
+    c.methods.face.anti_spoofing.ir_camera = IR;
+    c.methods.face.camera_profiles = [
+      { camera: RGB, ir_camera: null, allow_without_ir: false },
+    ];
+    const out = withoutCameraProfiles(c).config.methods.face;
+    expect(out.camera).toBe(RGB);
+    expect(out.anti_spoofing.ir_camera).toBe(IR);
+  });
+
+  test("no profiles: unchanged", () => {
+    const c = config();
+    expect(withoutCameraProfiles(c)).toEqual({ config: c, hadProfiles: false });
+  });
+});
+
+function cam(id: string, mono: boolean): CameraInfo {
+  return { id, model: id, mono, video_paths: [] };
+}
+
+describe("defaultCameras", () => {
+  test("the first mono camera is the IR camera", () => {
+    expect(defaultCameras([cam(RGB, false), cam(IR, true)])).toEqual({
+      ir: IR,
+      colour: RGB,
+    });
+    expect(defaultCameras([])).toEqual({ ir: null, colour: null });
+  });
+});
+
+describe("cameras per mode", () => {
+  const both = withFaceMode(face(), "both", { ir: IR, colour: RGB });
+  const ir = withFaceMode(face(), "ir", { ir: IR, colour: RGB });
+  const rgb = withFaceMode(face(), "rgb", { ir: IR, colour: RGB });
+
+  test("enrolment pairs the IR camera only in both", () => {
+    expect(enrolmentCameras(both)).toEqual({ main: RGB, pairIr: IR });
+    expect(enrolmentCameras(ir)).toEqual({ main: IR, pairIr: null });
+    expect(enrolmentCameras(rgb)).toEqual({ main: RGB, pairIr: null });
+  });
+
+  test("the colour camera of a mode", () => {
+    expect(colourCameraOf(both)).toBe(RGB);
+    expect(colourCameraOf(ir)).toBeNull();
+  });
+});
+
+describe("face directories", () => {
+  test("faces/ is the main camera's", () => {
+    expect(faceDirRole("faces", "ir")).toEqual({
+      camera: "IR camera",
+      used: true,
+    });
+    expect(faceDirRole("faces", "both")).toEqual({
+      camera: "Colour camera",
+      used: true,
+    });
+    expect(faceDirRole("faces", null).used).toBe(false);
+  });
+
+  test("faces-ir/ counts only in both, faces-rgb/ never", () => {
+    expect(faceDirRole("faces-ir", "both").used).toBe(true);
+    expect(faceDirRole("faces-ir", "rgb").used).toBe(false);
+    expect(faceDirRole("faces-rgb", "ir")).toEqual({
+      camera: "Colour camera",
+      used: false,
+    });
+  });
+
+  const sets: FaceSet[] = [
+    { dir: "faces", paths: ["a", "b"] },
+    { dir: "faces-ir", paths: ["c"] },
+    { dir: "faces-rgb", paths: [] },
+  ];
+
+  test("faces per camera follow the saved mode", () => {
+    expect(enrolledPerCamera(sets, "both")).toEqual({ ir: 1, colour: 2 });
+    expect(enrolledPerCamera(sets, "ir")).toEqual({ ir: 2, colour: 0 });
+  });
+
+  test("missing faces per mode", () => {
+    expect(missingFaces("ir", { ir: 0, colour: 3 })).toEqual(["IR camera"]);
+    expect(missingFaces("both", { ir: 0, colour: 0 })).toEqual([
+      "IR camera",
+      "Colour camera",
+    ]);
+    expect(missingFaces("rgb", { ir: 0, colour: 1 })).toEqual([]);
+    expect(missingFaces(null, { ir: 0, colour: 0 })).toEqual([]);
+  });
+});
diff --git a/app/src/app/configuration/-components/face/faceMode.ts b/app/src/app/configuration/-components/face/faceMode.ts
new file mode 100644
index 0000000..77b83f7
--- /dev/null
+++ b/app/src/app/configuration/-components/face/faceMode.ts
@@ -0,0 +1,199 @@
+import type {
+  BiopassConfig,
+  CameraInfo,
+  FaceDir,
+  FaceSet,
+} from "@/types/config";
+
+type FaceConfig = BiopassConfig["methods"]["face"];
+
+/**
+ * Which camera recognises:
+ * - ir: the IR camera (`camera` = `anti_spoofing.ir_camera`); works in the
+ *   dark. The AI anti-spoofing models are trained on colour pictures, so
+ *   they stay off.
+ * - rgb: the colour camera; the IR camera only checks that it sees a face.
+ * - both: the colour and the IR camera each recognise, against their own
+ *   faces (`anti_spoofing.ir_recognition`).
+ */
+export type FaceMode = "ir" | "rgb" | "both";
+
+export const FACE_MODES: readonly FaceMode[] = ["ir", "both", "rgb"];
+
+/**
+ * Written where a mode is chosen and the settings have none, or a looser
+ * one: a face must fill a fifth of the picture's height (in front of the
+ * screen, not across the room), and a match must score above 0.6.
+ */
+export const RECOMMENDED_MIN_FACE_HEIGHT = 0.2;
+export const RECOMMENDED_THRESHOLD = 0.6;
+
+/** The mode `face` is in, or null when it names no IR camera or no camera. */
+export function faceModeOf(face: FaceConfig): FaceMode | null {
+  const camera = face.camera || null;
+  const ir = face.anti_spoofing.ir_camera || null;
+  if (!camera || !ir || face.camera_profiles.length > 0) return null;
+  if (camera === ir) return "ir";
+  return face.anti_spoofing.ir_recognition ? "both" : "rgb";
+}
+
+/** Whether `face`'s main camera is its IR camera: faces/ holds IR faces. */
+export function mainIsIr(face: FaceConfig): boolean {
+  return faceModeOf(face) === "ir";
+}
+
+/**
+ * `face` set to `mode` with these cameras: `camera`, `anti_spoofing.ir_camera`
+ * and `ir_recognition`; no camera profiles; anti-spoofing off in ir; the
+ * recommended minimum face height and threshold where the settings have none
+ * or a looser one.
+ */
+export function withFaceMode(
+  face: FaceConfig,
+  mode: FaceMode,
+  cameras: { ir: string; colour: string | null },
+): FaceConfig {
+  const camera = mode === "ir" ? cameras.ir : cameras.colour;
+  const minHeight = face.detection.min_face_height;
+  return {
+    ...face,
+    camera,
+    camera_profiles: [],
+    detection: {
+      ...face.detection,
+      min_face_height:
+        minHeight > 0 && minHeight <= 1
+          ? minHeight
+          : RECOMMENDED_MIN_FACE_HEIGHT,
+    },
+    recognition: {
+      ...face.recognition,
+      threshold: Math.max(face.recognition.threshold, RECOMMENDED_THRESHOLD),
+    },
+    anti_spoofing: {
+      ...face.anti_spoofing,
+      ir_camera: cameras.ir,
+      ir_recognition: mode === "both",
+      enable: mode === "ir" ? false : face.anti_spoofing.enable,
+    },
+  };
+}
+
+/**
+ * `config` without camera profiles: the first profile's cameras go into
+ * `camera` and `anti_spoofing.ir_camera` (an older save of this app turned
+ * them into a profile; face unlock here refuses profiles). `hadProfiles`
+ * says whether anything changed.
+ */
+export function withoutCameraProfiles(config: BiopassConfig): {
+  config: BiopassConfig;
+  hadProfiles: boolean;
+} {
+  const face = config.methods.face;
+  const first = face.camera_profiles[0];
+  if (!first) return { config, hadProfiles: false };
+  return {
+    hadProfiles: true,
+    config: {
+      ...config,
+      methods: {
+        ...config.methods,
+        face: {
+          ...face,
+          camera: first.camera || face.camera,
+          camera_profiles: [],
+          anti_spoofing: {
+            ...face.anti_spoofing,
+            ir_camera: first.ir_camera || face.anti_spoofing.ir_camera,
+          },
+        },
+      },
+    },
+  };
+}
+
+/** The first IR (mono) and the first colour camera libcamera lists. */
+export function defaultCameras(cameras: readonly CameraInfo[]): {
+  ir: string | null;
+  colour: string | null;
+} {
+  return {
+    ir: cameras.find((c) => c.mono)?.id ?? null,
+    colour: cameras.find((c) => !c.mono)?.id ?? null,
+  };
+}
+
+/** The colour camera of `face`, if its mode has one. */
+export function colourCameraOf(face: FaceConfig): string | null {
+  const mode = faceModeOf(face);
+  return mode === "rgb" || mode === "both" ? face.camera : null;
+}
+
+/**
+ * The cameras enrolment takes pictures with: `camera` into faces/, and in
+ * both mode the IR camera too, into faces-ir/ (a pair per picture).
+ */
+export function enrolmentCameras(face: FaceConfig): {
+  main: string | null;
+  pairIr: string | null;
+} {
+  return {
+    main: face.camera || null,
+    pairIr: faceModeOf(face) === "both" ? face.anti_spoofing.ir_camera : null,
+  };
+}
+
+export interface FaceDirRole {
+  camera: "IR camera" | "Colour camera";
+  /** Whether face unlock matches these in this mode. */
+  used: boolean;
+}
+
+/**
+ * Whose faces each face directory holds in `mode` (the saved settings: the
+ * directories follow them), and whether face unlock uses them. Without a
+ * mode, faces/ is the colour camera's (the app's default camera).
+ */
+export function faceDirRole(dir: FaceDir, mode: FaceMode | null): FaceDirRole {
+  switch (dir) {
+    case "faces":
+      return mode === "ir"
+        ? { camera: "IR camera", used: true }
+        : { camera: "Colour camera", used: mode !== null };
+    case "faces-ir":
+      return { camera: "IR camera", used: mode === "both" };
+    case "faces-rgb":
+      return { camera: "Colour camera", used: false };
+  }
+}
+
+/**
+ * How many faces each camera has, with the directories as `saved` (the
+ * mode on disk) left them. Saving another mode moves the directories but
+ * keeps each camera's faces, so the counts hold for any mode.
+ */
+export function enrolledPerCamera(
+  sets: readonly FaceSet[],
+  saved: FaceMode | null,
+): { ir: number; colour: number } {
+  const count = (dir: FaceDir) =>
+    sets.find((s) => s.dir === dir)?.paths.length ?? 0;
+  return saved === "ir"
+    ? { ir: count("faces"), colour: count("faces-rgb") }
+    : { ir: count("faces-ir"), colour: count("faces") };
+}
+
+/** What face unlock is missing in `mode` with these enrolled faces. */
+export function missingFaces(
+  mode: FaceMode | null,
+  enrolled: { ir: number; colour: number },
+): ("IR camera" | "Colour camera")[] {
+  const missing: ("IR camera" | "Colour camera")[] = [];
+  if ((mode === "ir" || mode === "both") && enrolled.ir === 0) {
+    missing.push("IR camera");
+  }
+  if ((mode === "rgb" || mode === "both") && enrolled.colour === 0) {
+    missing.push("Colour camera");
+  }
+  return missing;
+}
