diff --git a/app/src/app/configuration/-components/face/FaceSets.tsx b/app/src/app/configuration/-components/face/FaceSets.tsx
new file mode 100644
index 0000000..8fcc270
--- /dev/null
+++ b/app/src/app/configuration/-components/face/FaceSets.tsx
@@ -0,0 +1,188 @@
+import { convertFileSrc } from "@tauri-apps/api/core";
+import { Trash2 } from "lucide-react";
+import { useState } from "react";
+import { toast } from "sonner";
+import { cmd } from "@/commands";
+import { Button } from "@/components/ui/button";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog";
+import { cn } from "@/lib/utils";
+import type { FaceDir, FaceSet } from "@/types/config";
+import { type FaceMode, faceDirRole } from "./faceMode";
+
+interface Props {
+  sets: readonly FaceSet[];
+  /** The saved mode: the directories follow it. */
+  mode: FaceMode | null;
+  /** The last test scan's score per face, and its threshold. */
+  scores: ReadonlyMap<string, number>;
+  threshold: number | null;
+  onChanged: () => void;
+}
+
+/** File name of a face path. */
+export function faceName(path: string): string {
+  return path.slice(path.lastIndexOf("/") + 1);
+}
+
+/**
+ * The enrolled faces of every camera, labelled by camera and whether face
+ * unlock uses them now, each with its score in the last test scan.
+ */
+export function FaceSets({ sets, mode, scores, threshold, onChanged }: Props) {
+  const [confirmDir, setConfirmDir] = useState<FaceDir | null>(null);
+  const shown = sets.filter((s) => s.dir === "faces" || s.paths.length > 0);
+
+  async function remove(paths: readonly string[]) {
+    let failed = 0;
+    for (const path of paths) {
+      try {
+        await cmd.face.deleteImage(path);
+      } catch (err) {
+        failed++;
+        console.error("Failed to delete", path, err);
+      }
+    }
+    if (failed > 0) toast.error(`${failed} could not be deleted`);
+    else toast.success(paths.length === 1 ? "Face deleted" : "Faces deleted");
+    onChanged();
+  }
+
+  const confirmSet = sets.find((s) => s.dir === confirmDir);
+
+  return (
+    <div className="grid gap-4">
+      {shown.map((set) => {
+        const role = faceDirRole(set.dir, mode);
+        return (
+          <div key={set.dir} className="grid gap-2">
+            <div className="flex items-center justify-between gap-2">
+              <p className="text-sm">
+                <span className="font-medium">{role.camera}</span>{" "}
+                <span className="text-muted-foreground">
+                  ({set.paths.length}, {set.dir}/)
+                  {role.used ? "" : " · not used in this mode, kept"}
+                </span>
+              </p>
+              {set.paths.length > 0 && (
+                <Button
+                  type="button"
+                  variant="ghost"
+                  size="sm"
+                  onClick={() => setConfirmDir(set.dir)}
+                >
+                  <Trash2 />
+                  Delete all
+                </Button>
+              )}
+            </div>
+            {set.paths.length === 0 ? (
+              <p className="text-xs text-muted-foreground">None yet.</p>
+            ) : (
+              <div className="grid grid-cols-5 gap-2">
+                {set.paths.map((path) => (
+                  <FaceThumb
+                    key={path}
+                    path={path}
+                    score={scores.get(path)}
+                    threshold={threshold}
+                    onDelete={() => remove([path])}
+                  />
+                ))}
+              </div>
+            )}
+          </div>
+        );
+      })}
+
+      <Dialog
+        open={confirmDir !== null}
+        onOpenChange={(open) => {
+          if (!open) setConfirmDir(null);
+        }}
+      >
+        <DialogContent>
+          <DialogHeader>
+            <DialogTitle>
+              Delete all {confirmSet?.paths.length} faces in {confirmDir}/?
+            </DialogTitle>
+            <DialogDescription>
+              To enrol again: delete them, then add new ones with Add faces.
+            </DialogDescription>
+          </DialogHeader>
+          <DialogFooter>
+            <Button
+              type="button"
+              variant="outline"
+              onClick={() => setConfirmDir(null)}
+            >
+              Cancel
+            </Button>
+            <Button
+              type="button"
+              variant="destructive"
+              onClick={() => {
+                if (confirmSet) void remove(confirmSet.paths);
+                setConfirmDir(null);
+              }}
+            >
+              Delete all
+            </Button>
+          </DialogFooter>
+        </DialogContent>
+      </Dialog>
+    </div>
+  );
+}
+
+/** A face image with its last score (red below the threshold) and delete. */
+export function FaceThumb({
+  path,
+  score,
+  threshold,
+  onDelete,
+}: {
+  path: string;
+  score: number | undefined;
+  threshold: number | null;
+  onDelete: () => void;
+}) {
+  const low = score !== undefined && threshold !== null && score <= threshold;
+  return (
+    <div className="relative group">
+      <div className="aspect-square bg-muted rounded-lg overflow-hidden">
+        <img
+          src={convertFileSrc(path)}
+          alt={faceName(path)}
+          title={faceName(path)}
+          className="w-full h-full object-cover"
+        />
+      </div>
+      {score !== undefined && (
+        <span
+          className={cn(
+            "absolute bottom-1 left-1 rounded px-1 text-[10px] font-mono text-white",
+            low ? "bg-destructive/90" : "bg-emerald-600/90",
+          )}
+          title="Score in the last test scan"
+        >
+          {score.toFixed(2)}
+        </span>
+      )}
+      <button
+        type="button"
+        onClick={onDelete}
+        aria-label={`Delete ${faceName(path)}`}
+        className="absolute top-1 right-1 p-1 rounded bg-destructive/80 cursor-pointer"
+      >
+        <Trash2 className="w-3 h-3 text-white" />
+      </button>
+    </div>
+  );
+}
