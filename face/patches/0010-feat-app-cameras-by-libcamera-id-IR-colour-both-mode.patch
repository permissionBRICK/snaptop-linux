+/// What move_faces_for_main_camera moved.
+#[derive(Debug, Serialize, Clone, PartialEq, specta::Type)]
+pub struct FacesMoved {
+    /// faces/ now holds the IR camera's faces (else the colour camera's).
+    pub main_is_ir: bool,
+    /// Moved out of faces/: into faces-rgb/ when the IR camera became the
+    /// main camera, else into faces-ir/.
+    pub set_aside: u32,
+    /// Moved into faces/: from faces-ir/ when the IR camera became the main
+    /// camera, else from faces-rgb/.
+    pub restored: u32,
+}
+
+/// Keeps every camera's faces with it when the main camera changes between
+/// the IR camera and the colour camera: faces/ holds the main camera's,
+/// faces-ir/ the IR camera's otherwise, faces-rgb/ the colour camera's
+/// otherwise. A name already taken in the target gets a -1, -2, ... suffix.
+/// Only face images move (see is_face_file); anything else stays.
+pub fn move_faces_for_main_camera(
+    data_dir: &Path,
+    now_ir_main: bool,
+) -> Result<FacesMoved, String> {
+    let (aside, from) = if now_ir_main {
+        (FaceDir::Colour, FaceDir::Ir)
+    } else {
+        (FaceDir::Ir, FaceDir::Colour)
+    };
+    let main = FaceDir::Main.path_in(data_dir);
+    let set_aside = move_face_files(&main, &aside.path_in(data_dir))?;
+    let restored = move_face_files(&from.path_in(data_dir), &main)?;
+    Ok(FacesMoved {
+        main_is_ir: now_ir_main,
+        set_aside,
+        restored,
+    })
+}
+
+fn move_face_files(from: &Path, to: &Path) -> Result<u32, String> {
+    if !from.exists() {
+        return Ok(0);
+    }
+    let files = face_files_in(from)?;
+    if files.is_empty() {
+        return Ok(0);
+    }
+    ensure_private_dir(to).map_err(|e| format!("Failed to create {}: {}", to.display(), e))?;
+    for file in &files {
+        let file = Path::new(file);
+        let target = free_name(to, file);
+        fs::rename(file, &target).map_err(|e| {
+            format!(
+                "Failed to move {} to {}: {}",
+                file.display(),
+                target.display(),
+                e
+            )
+        })?;
+    }
+    Ok(files.len() as u32)
+}
+
+/// `file`'s name in `dir`, or with a -1, -2, ... suffix while that is taken.
+fn free_name(dir: &Path, file: &Path) -> PathBuf {
