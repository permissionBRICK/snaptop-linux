+import { TriangleAlert } from "lucide-react";
+import { useEffect, useState } from "react";
+import { useFormContext, useWatch } from "react-hook-form";
+import { Label } from "@/components/ui/label";
+import { RadioGroup, RadioGroupItem } from "@/components/ui/radio-group";
+import { Slider } from "@/components/ui/slider";
+import type { BiopassConfig, CameraInfo } from "@/types/config";
+import { CameraSelect } from "./CameraSelect";
+import {
+  colourCameraOf,
+  defaultCameras,
+  FACE_MODES,
+  type FaceMode,
+  faceModeOf,
+  RECOMMENDED_MIN_FACE_HEIGHT,
+  withFaceMode,
+} from "./faceMode";
+import { useSavedSettings } from "./savedSettings";
+import type { CameraChoice } from "./useCameras";
+
+const OPTIONS = { shouldDirty: true, shouldValidate: true } as const;
+
+const MODE_TEXT: Record<FaceMode, { title: string; text: string }> = {
+  ir: {
+    title: "IR camera",
+    text: "The IR camera recognises you, in any light and in the dark (its own infrared light). A phone or monitor shows nothing in infrared. AI anti-spoofing stays off: its models are trained on colour pictures.",
+  },
+  both: {
+    title: "Both cameras (strictest)",
+    text: "The colour and the IR camera each recognise you, against their own faces, within 2.5 seconds. Needs room light; never falls back to one camera.",
+  },
+  rgb: {
+    title: "Colour camera",
+    text: "The colour camera recognises you; the IR camera only checks that it sees a face, which a printed photo can pass. Needs room light.",
+  },
+};
+
+interface Props {
+  cameras: readonly CameraInfo[];
+  choices: readonly CameraChoice[];
+  camerasError: string | null;
+}
+
+/**
+ * Which camera recognises (methods.face.camera, anti_spoofing.ir_camera and
+ * anti_spoofing.ir_recognition, by libcamera id) and the minimum face size.
+ * Never camera profiles: face unlock here refuses them.
+ */
+export function CamerasSection({ cameras, choices, camerasError }: Props) {
+  const {
+    setValue,
+    formState: { errors },
+  } = useFormContext<BiopassConfig>();
+  const face = useWatch<BiopassConfig, "methods.face">({
+    name: "methods.face",
+  });
+  const saved = useSavedSettings();
+  const mode = faceModeOf(face);
+  const detected = defaultCameras(cameras);
+  const ir = face.anti_spoofing.ir_camera || detected.ir;
+  // The colour camera to use when a mode with one is chosen; in ir mode the
+  // settings have none, so it is kept here.
+  const [colour, setColour] = useState<string | null>(
+    colourCameraOf(face) ?? detected.colour,
+  );
+  useEffect(() => {
+    setColour((c) => c ?? colourCameraOf(face) ?? detected.colour);
+  }, [face, detected.colour]);
+
+  function choose(next: FaceMode) {
+    if (!ir) return;
+    setValue(
+      "methods.face",
+      withFaceMode(face, next, { ir, colour: colour ?? detected.colour }),
+      OPTIONS,
+    );
+  }
+
+  function chooseIr(next: string) {
+    if (mode === "ir") setValue("methods.face.camera", next, OPTIONS);
+    setValue("methods.face.anti_spoofing.ir_camera", next, OPTIONS);
+  }
+
+  function chooseColour(next: string) {
+    setColour(next);
+    if (mode === "rgb" || mode === "both") {
+      setValue("methods.face.camera", next, OPTIONS);
+    }
+  }
+
+  const minHeight = face.detection.min_face_height;
+  const cameraError =
+    errors.methods?.face?.camera?.message ??
+    errors.methods?.face?.anti_spoofing?.ir_camera?.message;
+
+  return (
+    <div className="p-4 rounded-lg bg-muted/50 border border-border/50 space-y-4">
+      <div>
+        <h4 className="font-medium text-sm">Cameras</h4>
+        <p className="text-xs text-muted-foreground">
+          Which camera recognises you. Faces stay with the camera that took
+          them: switching keeps them for when you switch back.
+        </p>
+      </div>
+
+      {saved.hadProfiles && (
+        <p className="flex gap-2 text-xs text-amber-600 dark:text-amber-400">
+          <TriangleAlert className="w-4 h-4 shrink-0" />
+          Your settings have camera profiles from an earlier save, which face
+          unlock refuses. Saving replaces them with the cameras below.
+        </p>
+      )}
+      {camerasError && (
+        <p className="text-xs text-destructive">
+          Could not list the cameras: {camerasError}
+        </p>
+      )}
+
+      <RadioGroup
+        value={mode ?? ""}
+        onValueChange={(v) => choose(v as FaceMode)}
+        className="gap-2"
+      >
+        {FACE_MODES.map((m) => (
+          <Label
+            key={m}
+            htmlFor={`face-mode-${m}`}
+            className="flex items-start gap-3 rounded-md border border-border p-3 cursor-pointer has-[button[data-state=checked]]:border-primary"
+          >
+            <RadioGroupItem
+              id={`face-mode-${m}`}
+              value={m}
+              disabled={!ir}
+              className="mt-0.5"
+            />
+            <span className="grid gap-0.5">
+              <span className="text-sm font-medium">
+                {MODE_TEXT[m].title}
+                {m === "ir" && (
+                  <span className="ml-2 text-xs font-normal text-muted-foreground">
+                    recommended
+                  </span>
+                )}
+              </span>
+              <span className="text-xs font-normal text-muted-foreground">
+                {MODE_TEXT[m].text}
+              </span>
+            </span>
+          </Label>
+        ))}
+      </RadioGroup>
+      {!mode && (
+        <p className="text-xs text-destructive">
+          {ir
+            ? "Choose a mode: face unlock needs an IR camera."
+            : "No IR camera found."}
+        </p>
+      )}
+
+      <div className="grid grid-cols-2 gap-4">
+        <div className="grid min-w-0 gap-1">
+          <Label
+            htmlFor="face-ir-camera"
+            className="text-xs text-muted-foreground"
+          >
+            IR camera
+          </Label>
+          <CameraSelect
+            id="face-ir-camera"
+            value={ir}
+            onChange={chooseIr}
+            choices={choices}
+            placeholder="Select the IR camera"
+          />
+        </div>
+        <div className="grid min-w-0 gap-1">
+          <Label
+            htmlFor="face-colour-camera"
+            className="text-xs text-muted-foreground"
+          >
+            Colour camera
+          </Label>
+          <CameraSelect
+            id="face-colour-camera"
+            value={colour}
+            onChange={chooseColour}
+            choices={choices}
+            placeholder="Select the colour camera"
+            disabled={mode === "ir"}
+          />
+        </div>
+      </div>
+      {cameraError && <p className="text-xs text-destructive">{cameraError}</p>}
+
+      <div className="grid gap-2">
+        <div className="flex items-center justify-between">
+          <Label className="text-xs text-muted-foreground">
+            Minimum face size
+          </Label>
+          <span className="text-xs font-mono font-medium">
+            {minHeight > 0
+              ? `${Math.round(minHeight * 100)}% of the picture's height`
+              : "off"}
+          </span>
+        </div>
+        <Slider
+          value={[minHeight]}
+          min={0}
+          max={0.6}
+          step={0.01}
+          onValueChange={([v]) =>
+            setValue("methods.face.detection.min_face_height", v, OPTIONS)
+          }
+          className="cursor-pointer"
+        />
+        <p className="text-xs text-muted-foreground">
+          Only a face this big (and wholly in the picture) is compared: someone
+          in front of the screen, not across the room. Sitting at the laptop
+          your face fills about 30-45% in IR and 45-60% in colour; a face across
+          a room about 10%. Recommended: {RECOMMENDED_MIN_FACE_HEIGHT * 100}%.
+          {minHeight === 0 && " Off: face unlock refuses to run."}
+        </p>
+      </div>
+    </div>
+  );
+}
