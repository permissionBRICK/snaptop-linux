index 0000000..44b9503
--- /dev/null
+++ b/app/src/app/configuration/-components/face/TestScan.tsx
@@ -0,0 +1,96 @@
+import { Loader2, ScanFace } from "lucide-react";
+import { useState } from "react";
+import { toast } from "sonner";
+import { cmd } from "@/commands";
+import { Button } from "@/components/ui/button";
+import { cn } from "@/lib/utils";
+import type { ScanOutcome, ScanResult } from "@/types/config";
+
+const OUTCOME_TEXT: Record<ScanOutcome, string> = {
+  match: "Recognised: face unlock would unlock.",
+  no_match:
+    "Not recognised: a face was seen but did not match (or anti-spoofing flagged it). On the lock screen this counts as a false face.",
+  no_face: "No face seen in time (does not count on the lock screen).",
+  not_tried:
+    "Face not tried: no settings saved, no faces enrolled for a camera, or no camera.",
+  failed: "The scan failed.",
+};
+
+interface Props {
+  /** Why the scan may differ from the form (unsaved changes), or null. */
+  unsaved: boolean;
+  result: ScanResult | null;
+  onResult: (result: ScanResult) => void;
+}
+
+/** One face scan with the saved settings, as login runs it, step by step. */
+export function TestScan({ unsaved, result, onResult }: Props) {
+  const [busy, setBusy] = useState(false);
+
+  async function run() {
+    setBusy(true);
+    try {
+      onResult(await cmd.face.testScan());
+    } catch (err) {
+      toast.error(`Face scan failed: ${err}`);
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <div className="grid gap-3">
+      <div className="flex items-center justify-between gap-4">
+        <div>
+          <h4 className="font-medium text-sm flex items-center gap-2">
+            <ScanFace className="w-4 h-4" />
+            Test face unlock
+          </h4>
+          <p className="text-xs text-muted-foreground">
+            One scan with the saved settings, as the lock screen runs it: the
+            face's size, each enrolled face's score. It counts nowhere.
+            {unsaved && " Save first: unsaved changes are not used."}
+          </p>
+        </div>
+        <Button type="button" onClick={run} disabled={busy}>
+          {busy ? (
+            <Loader2 className="w-4 h-4 mr-2 animate-spin" />
+          ) : (
+            <ScanFace className="w-4 h-4 mr-2" />
+          )}
+          {busy ? "Look at the screen..." : "Test"}
+        </Button>
+      </div>
+
+      {result && (
+        <div className="grid gap-2 rounded-md border border-border p-3">
+          <p
+            className={cn(
+              "text-sm font-medium",
+              result.outcome === "match"
+                ? "text-emerald-600 dark:text-emerald-400"
+                : "text-destructive",
+            )}
+          >
+            {OUTCOME_TEXT[result.outcome]}{" "}
+            <span className="font-normal text-muted-foreground">
+              ({(result.duration_ms / 1000).toFixed(1)} s)
+            </span>
+          </p>
+          {result.threshold !== null && result.scores.length > 0 && (
+            <p className="text-xs text-muted-foreground">
+              Each compared face shows its best score above (it matches above{" "}
+              {result.threshold.toFixed(2)}; red: not above). Faces that stay
+              red when you test are worth deleting and adding again.
+            </p>
+          )}
+          {result.steps.length > 0 && (
+            <pre className="max-h-48 overflow-auto rounded bg-muted p-2 text-[11px] leading-relaxed whitespace-pre-wrap">
+              {result.steps.join("\n")}
+            </pre>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
