+/// `path` when it names a face image directly inside one of the face
+/// directories (see resolve_face_file).
+fn resolve_in_face_dirs(data_dir: &Path, path: &Path) -> Result<PathBuf, String> {
+    let mut last = Err(format!("Not a face image: {}", path.display()));
+    for dir in FaceDir::ALL {
+        last = resolve_face_file(&dir.path_in(data_dir), path);
+        if last.is_ok() {
+            break;
