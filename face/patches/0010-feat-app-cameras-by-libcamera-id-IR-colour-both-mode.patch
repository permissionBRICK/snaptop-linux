+//! The cameras libcamera finds, by id (`biopass-helper list-cameras`). Platform
+//! cameras behind one CSI-2 receiver (e.g. Qualcomm CAMSS on Snapdragon
+//! laptops) share all their /dev/video nodes, so only libcamera's id tells
+//! them apart; config.yaml's `camera` and `anti_spoofing.ir_camera` take it.
+
+use std::io::Read;
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant};
+
+use serde::Serialize;
+
+use crate::blocking::run_blocking;
+use crate::face_session::helper_path;
+
+const TASK: &str = "Cameras";
+// Starting libcamera's camera manager takes well under a second; a stuck
+// helper must not hang the settings page.
+const LIST_TIMEOUT: Duration = Duration::from_secs(15);
+const MAX_OUTPUT: u64 = 64 * 1024;
+
+#[derive(Debug, Serialize, Clone, PartialEq, specta::Type)]
+pub struct CameraInfo {
+    /// What config.yaml saves, e.g. "/base/soc@0/cci@ac15000/i2c-bus@0/camera@24".
+    pub id: String,
+    /// The sensor's model, e.g. "hm1092"; the id when libcamera has none.
+    pub model: String,
+    /// A sensor without colour filters: an IR camera.
+    pub mono: bool,
+    /// The /dev/video nodes it streams through (several cameras may share them).
+    pub video_paths: Vec<String>,
+}
+
+/// Lines of `biopass-helper list-cameras` (auth/face/common/camera_list.h):
+/// id TAB mono|colour TAB video paths TAB model. Other lines are skipped.
+fn parse_camera_list(text: &str) -> Vec<CameraInfo> {
+    text.lines()
+        .filter_map(|line| {
+            let mut fields = line.splitn(4, '\t');
+            let id = fields.next()?.trim();
+            let kind = fields.next()?;
+            let paths = fields.next()?;
+            let model = fields.next()?.trim();
+            let mono = match kind {
+                "mono" => true,
+                "colour" => false,
+                _ => return None,
+            };
+            (!id.is_empty()).then(|| CameraInfo {
+                id: id.to_string(),
+                model: if model.is_empty() { id } else { model }.to_string(),
+                mono,
+                video_paths: paths.split_whitespace().map(String::from).collect(),
+            })
+        })
+        .collect()
+}
+
+fn run_list(helper: &str) -> Result<String, String> {
+    let mut child = Command::new(helper)
+        .arg("list-cameras")
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .map_err(|e| format!("Failed to start {helper}: {e}"))?;
+    let stdout = child.stdout.take().ok_or("missing stdout")?;
+    let reader = std::thread::spawn(move || {
+        let mut text = String::new();
+        let _ = stdout.take(MAX_OUTPUT).read_to_string(&mut text);
+        text
+    });
+    let deadline = Instant::now() + LIST_TIMEOUT;
+    let status = loop {
+        if let Some(status) = child.try_wait().map_err(|e| e.to_string())? {
+            break status;
+        }
+        if Instant::now() >= deadline {
+            let _ = child.kill();
+            let _ = child.wait();
+            return Err("Listing the cameras timed out".to_string());
+        }
+        std::thread::sleep(Duration::from_millis(50));
+    };
+    let text = reader.join().unwrap_or_default();
+    if !status.success() {
+        return Err(format!("biopass-helper list-cameras failed ({status})"));
+    }
+    Ok(text)
+}
+
+#[tauri::command]
+#[specta::specta]
+pub async fn list_cameras() -> Result<Vec<CameraInfo>, String> {
+    run_blocking(TASK, || Ok(parse_camera_list(&run_list(&helper_path())?))).await
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_the_helpers_lines() {
+        let text = "/base/cam@24\tmono\t/dev/video0 /dev/video1\thm1092\n\
+                    /base/cam@36\tcolour\t\tov02c10\n";
+        assert_eq!(
+            parse_camera_list(text),
+            vec![
+                CameraInfo {
+                    id: "/base/cam@24".into(),
+                    model: "hm1092".into(),
+                    mono: true,
+                    video_paths: vec!["/dev/video0".into(), "/dev/video1".into()],
+                },
+                CameraInfo {
+                    id: "/base/cam@36".into(),
+                    model: "ov02c10".into(),
+                    mono: false,
+                    video_paths: vec![],
+                },
+            ]
+        );
+    }
+
+    #[test]
+    fn skips_lines_that_are_not_cameras() {
+        let text = "[0:00:01] ERROR V4L2 noise\n\
+                    id-only\n\
+                    cam\tgrey\t\tmodel\n\
+                    \tcolour\t\tno id\n\
+                    usb-cam\tcolour\t/dev/video4\t\n";
+        let cams = parse_camera_list(text);
+        assert_eq!(cams.len(), 1);
+        // No model: the id stands in.
+        assert_eq!(cams[0].model, "usb-cam");
+        // A model may contain tabs after the third field.
+        assert_eq!(parse_camera_list("a\tmono\t\tX\tY\n")[0].model, "X\tY");
+    }
+
+    #[test]
+    fn a_helper_that_fails_is_an_error() {
+        assert!(run_list("/bin/false").is_err());
+        assert!(run_list("/nonexistent/biopass-helper").is_err());
+    }
+}
