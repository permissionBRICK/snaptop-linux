+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from "@/components/ui/select";
+import type { CameraChoice } from "./useCameras";
+
+const UNAVAILABLE = "__unavailable_camera__";
+
+interface Props {
+  id: string;
+  value: string | null;
+  onChange: (value: string) => void;
+  choices: readonly CameraChoice[];
+  placeholder: string;
+  disabled?: boolean;
+}
+
+/** A camera picker over libcamera's cameras and other video devices. */
+export function CameraSelect({
+  id,
+  value,
+  onChange,
+  choices,
+  placeholder,
+  disabled,
+}: Props) {
+  const listed = value !== null && choices.some((c) => c.value === value);
+  const selectValue = value === null ? "" : listed ? value : UNAVAILABLE;
+  const selected = choices.find((c) => c.value === value);
+
+  return (
+    <Select
+      value={selectValue}
+      disabled={disabled}
+      onValueChange={(next) => {
+        if (next !== UNAVAILABLE) onChange(next);
+      }}
+    >
+      <SelectTrigger id={id} className="h-10 w-full min-w-0">
+        <SelectValue
+          className="min-w-0 flex-1 overflow-hidden text-left"
+          placeholder={placeholder}
+        >
+          {selected ? (
+            <span className="truncate">{selected.label}</span>
+          ) : (
+            value !== null && (
+              <span className="truncate text-muted-foreground">
+                Not found: {value}
+              </span>
+            )
+          )}
+        </SelectValue>
+      </SelectTrigger>
+      <SelectContent>
+        {!listed && value !== null && (
+          <SelectItem value={UNAVAILABLE} disabled>
+            Not found: {value}
+          </SelectItem>
+        )}
+        {choices.length > 0 ? (
+          choices.map((c) => (
+            <SelectItem key={c.value} value={c.value}>
+              <span className="flex min-w-0 flex-col">
+                <span className="truncate">{c.label}</span>
+                <span className="truncate text-xs text-muted-foreground">
+                  {c.details}
+                </span>
+              </span>
+            </SelectItem>
+          ))
+        ) : (
+          <SelectItem value="__no_cameras__" disabled>
+            No cameras found
+          </SelectItem>
+        )}
+      </SelectContent>
+    </Select>
+  );
+}
