+//! One face scan with the saved settings, as login runs it, with each step
+//! shown: `biopass-helper auth --verbose` (face found or not, its size
+//! against the minimum, match scores, anti-spoofing), for trying the
+//! settings without locking the screen.
+
+use std::io::Read;
+use std::os::unix::fs::MetadataExt;
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant};
+
+use serde::Serialize;
+use tauri::State;
+
+use crate::blocking::run_blocking;
+use crate::face_session::{helper_path, stop_preview_now, PreviewState};
+
+const TASK: &str = "Face scan";
+/// Frames without a face use up no try for this long (auth --keep-looking):
+/// the first face compared decides, as on the login screen.
+const KEEP_LOOKING_MS: u32 = 6000;
+/// The helper ends itself within its time budget (kAuthBudget, 40 s).
+const SCAN_TIMEOUT: Duration = Duration::from_secs(50);
+const MAX_LOG: u64 = 1 << 20;
+
+#[derive(Debug, Serialize, Clone, Copy, PartialEq, Eq, specta::Type)]
+#[serde(rename_all = "snake_case")]
+pub enum ScanOutcome {
+    /// Recognised: login would succeed (exit 0).
+    Match,
+    /// A face was compared and did not match, or anti-spoofing flagged it (1).
+    NoMatch,
+    /// Nothing to try: no settings, no enrolled faces or no camera (2).
+    NotTried,
+    /// No face was seen in time (3).
+    NoFace,
+    /// Killed, timed out or an unknown exit code.
+    Failed,
+}
+
+#[derive(Debug, Serialize, Clone, PartialEq, specta::Type)]
+pub struct ScanResult {
+    pub outcome: ScanOutcome,
+    /// The steps of the scan, one per line: time, then what happened.
+    pub steps: Vec<String>,
+    /// How well each enrolled face compared (cosine similarity, 1 = the
+    /// same), its best over the scan's attempts, in the order first compared.
+    /// A face compared after a match is not listed: matching stops there.
+    pub scores: Vec<FaceScore>,
+    /// The recognition threshold the scan used: a face matches above it.
+    #[specta(type = Option<specta_typescript::Number>)]
+    pub threshold: Option<f64>,
+    #[specta(type = specta_typescript::Number)]
+    pub duration_ms: u64,
+}
+
+#[derive(Debug, Serialize, Clone, PartialEq, specta::Type)]
+pub struct FaceScore {
+    /// The enrolled face image (in faces/ or faces-ir/).
+    pub path: String,
+    #[specta(type = specta_typescript::Number)]
+    pub score: f64,
+}
+
+/// The per-face lines of the helper's debug log:
+/// "FaceAuth: Recognition | face='<path>' score=0.4813 threshold=0.600 similar=0".
+fn scores_from_log(log: &str) -> (Vec<FaceScore>, Option<f64>) {
+    let mut scores: Vec<FaceScore> = Vec::new();
+    let mut threshold = None;
+    for line in log.lines() {
+        let Some((_, message)) = split_log_line(line) else {
+            continue;
+        };
+        let Some(rest) = message.strip_prefix("FaceAuth: Recognition | face='") else {
+            continue;
+        };
+        let Some((path, rest)) = rest.split_once('\'') else {
+            continue;
+        };
+        let field = |name: &str| {
+            rest.split_whitespace()
+                .find_map(|kv| kv.strip_prefix(name)?.parse::<f64>().ok())
+        };
+        let Some(score) = field("score=").filter(|s| s.is_finite()) else {
+            continue;
+        };
+        threshold = field("threshold=").or(threshold);
+        match scores.iter_mut().find(|s| s.path == path) {
+            Some(known) => known.score = known.score.max(score),
+            None => scores.push(FaceScore {
+                path: path.to_string(),
+                score,
+            }),
+        }
+    }
+    (scores, threshold)
+}
+
+fn outcome_for(code: Option<i32>) -> ScanOutcome {
+    match code {
+        Some(0) => ScanOutcome::Match,
+        Some(1) => ScanOutcome::NoMatch,
+        Some(2) => ScanOutcome::NotTried,
+        Some(3) => ScanOutcome::NoFace,
+        _ => ScanOutcome::Failed,
+    }
+}
+
+/// The steps worth showing from the helper's debug log, shortened:
+/// "[2026-11-15 14:00:01.234] [biopass] [debug] FaceAuth: Face on ..." ->
+/// "14:00:01.234 Face on ...". Enrolled faces show as faces*/<name>.
+fn steps_from_log(log: &str) -> Vec<String> {
+    const STEPS: [&str; 11] = [
+        "Face on",
+        "No face",
+        "Recognition PASSED",
+        "Recognition FAILED",
+        "Recognised on both",
+        "Could not",
+        "Both cameras must",
+        "Anti-spoofing failed",
+        "AI anti-spoofing detected spoof",
+        "AI anti-spoofing check passed",
+        "IR presence check",
+    ];
+    log.lines()
+        .filter_map(|line| {
+            let (time, message) = split_log_line(line)?;
+            let step = message.strip_prefix("FaceAuth: ");
+            let shown = match step {
+                Some(step) => {
+                    STEPS.iter().any(|s| step.starts_with(s))
+                        || (step.starts_with("The ") && step.contains(" frame came"))
+                }
+                None => false,
+            } || message.contains("camera appears covered");
+            if !shown {
+                return None;
+            }
+            let text = step.unwrap_or(message);
+            let text = text.split(" (NOTE:").next().unwrap_or(text);
+            Some(format!("{time} {}", short_face_paths(text)))
+        })
+        .collect()
+}
+
+/// (time, message) of a spdlog line "[date time] [logger] [level] message".
+fn split_log_line(line: &str) -> Option<(&str, &str)> {
+    let rest = line.strip_prefix('[')?;
+    let (stamp, rest) = rest.split_once("] [")?;
+    let time = stamp.split_once(' ').map_or(stamp, |(_, t)| t);
+    let (_logger, rest) = rest.split_once("] [")?;
+    let (_level, message) = rest.split_once("] ")?;
+    Some((time, message))
+}
+
+/// face='/home/u/.local/share/com.ticklab.biopass/faces-ir/a.jpg' -> faces-ir/a.jpg
+fn short_face_paths(text: &str) -> String {
+    let mut out = String::new();
+    let mut rest = text;
+    while let Some(start) = rest.find("face='") {
+        out.push_str(&rest[..start]);
+        let after = &rest[start + 6..];
+        let Some(end) = after.find('\'') else {
+            out.push_str(&rest[start..]);
+            return out;
+        };
+        let path = &after[..end];
+        let short = path.rfind("/faces").map_or(path, |i| &path[i + 1..]);
+        out.push_str(short);
+        rest = &after[end + 1..];
+    }
+    out.push_str(rest);
+    out
+}
+
+/// The login name of `uid` in passwd(5) text.
+fn name_for_uid(passwd: &str, uid: u32) -> Option<String> {
+    passwd.lines().find_map(|line| {
+        let mut fields = line.split(':');
+        let name = fields.next()?;
+        let uid_field = fields.nth(1)?;
+        (uid_field.parse::<u32>().ok()? == uid && !name.is_empty()).then(|| name.to_string())
+    })
+}
+
+/// This process's user: its uid's name in /etc/passwd, else $USER.
+fn current_user() -> Result<String, String> {
+    let uid = std::fs::metadata("/proc/self")
+        .map(|m| m.uid())
+        .map_err(|e| format!("Could not determine the current user: {e}"))?;
+    std::fs::read_to_string("/etc/passwd")
+        .ok()
+        .and_then(|text| name_for_uid(&text, uid))
+        .or_else(|| crate::system::get_current_username().ok())
+        .ok_or_else(|| "Could not determine the current user".to_string())
+}
+
+fn scan(helper: &str, user: &str) -> Result<ScanResult, String> {
+    let started = Instant::now();
+    let mut child = Command::new(helper)
+        .args(["auth", "--username", user, "--verbose", "--keep-looking"])
+        .arg(KEEP_LOOKING_MS.to_string())
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::piped())
+        .spawn()
+        .map_err(|e| format!("Failed to start {helper}: {e}"))?;
+    let stderr = child.stderr.take().ok_or("missing stderr")?;
+    let reader = std::thread::spawn(move || {
+        let mut bytes = Vec::new();
+        let _ = stderr.take(MAX_LOG).read_to_end(&mut bytes);
+        String::from_utf8_lossy(&bytes).into_owned()
+    });
+    let status = loop {
+        if let Some(status) = child.try_wait().map_err(|e| e.to_string())? {
+            break Some(status);
+        }
+        if started.elapsed() >= SCAN_TIMEOUT {
+            let _ = child.kill();
+            let _ = child.wait();
+            break None;
+        }
+        std::thread::sleep(Duration::from_millis(50));
+    };
+    let log = reader.join().unwrap_or_default();
+    let (scores, threshold) = scores_from_log(&log);
+    Ok(ScanResult {
+        outcome: outcome_for(status.and_then(|s| s.code())),
+        steps: steps_from_log(&log),
+        scores,
+        threshold,
+        duration_ms: started.elapsed().as_millis() as u64,
+    })
+}
+
+/// One scan with the saved settings (the camera preview stops first: the
+/// helper needs the camera). Counts nowhere: no PAM, no lockout.
+#[tauri::command]
+#[specta::specta]
+pub async fn test_face_scan(state: State<'_, PreviewState>) -> Result<ScanResult, String> {
+    stop_preview_now(&state)?;
+    run_blocking(TASK, || scan(&helper_path(), &current_user()?)).await
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn exit_codes_map_to_outcomes() {
+        assert_eq!(outcome_for(Some(0)), ScanOutcome::Match);
+        assert_eq!(outcome_for(Some(1)), ScanOutcome::NoMatch);
+        assert_eq!(outcome_for(Some(2)), ScanOutcome::NotTried);
+        assert_eq!(outcome_for(Some(3)), ScanOutcome::NoFace);
+        assert_eq!(outcome_for(Some(9)), ScanOutcome::Failed);
+        assert_eq!(outcome_for(None), ScanOutcome::Failed);
+    }
+
+    #[test]
+    fn keeps_and_shortens_the_steps() {
+        let log = "\
+[2026-11-15 14:00:01.100] [biopass] [debug] FaceAuth: Recognition model loaded | threshold=0.600
+[2026-11-15 14:00:01.234] [biopass] [debug] FaceAuth: Face on the IR camera 0.31 of the frame height (min 0.20): in front
+[2026-11-15 14:00:01.300] [biopass] [debug] FaceAuth: Recognition | face='/home/u/.local/share/com.ticklab.biopass/faces/a.jpg' score=0.71
+[2026-11-15 14:00:01.400] [biopass] [debug] FaceAuth: Recognition PASSED on the IR camera | matched face='/home/u/.local/share/com.ticklab.biopass/faces-ir/face_1.jpg' score=0.7100
+[2026-11-15 14:00:02.000] [biopass] [error] FaceAuth: No face detected on the colour camera | luma mean=3.0 stddev=1.0 (NOTE: dark)
+[2026-11-15 14:00:02.500] [biopass] [error] FaceAuth: The IR camera frame came 3000 ms after the colour camera frame (at most 2500 ms), not combined
+[2026-11-15 14:00:03.000] [biopass] [warn] Biopass: the camera appears covered
+libcamera noise without brackets
+";
+        assert_eq!(
+            steps_from_log(log),
+            vec![
+                "14:00:01.234 Face on the IR camera 0.31 of the frame height (min 0.20): in front",
+                "14:00:01.400 Recognition PASSED on the IR camera | matched faces-ir/face_1.jpg score=0.7100",
+                "14:00:02.000 No face detected on the colour camera | luma mean=3.0 stddev=1.0",
+                "14:00:02.500 The IR camera frame came 3000 ms after the colour camera frame (at most 2500 ms), not combined",
+                "14:00:03.000 Biopass: the camera appears covered",
+            ]
+        );
+    }
+
+    #[test]
+    fn scores_per_face_keep_the_best() {
+        let log = "\
+[2026-11-15 14:00:01.300] [biopass] [debug] FaceAuth: Recognition | face='/h/faces/a.jpg' score=0.4813 threshold=0.600 similar=0
+[2026-11-15 14:00:01.310] [biopass] [debug] FaceAuth: Recognition | face='/h/faces/b.jpg' score=0.5120 threshold=0.600 similar=0
+[2026-11-15 14:00:02.300] [biopass] [debug] FaceAuth: Recognition | face='/h/faces/a.jpg' score=0.6512 threshold=0.600 similar=1
+[2026-11-15 14:00:02.300] [biopass] [debug] FaceAuth: Recognition | face='/h/faces/c.jpg' score=nan threshold=0.600 similar=0
+[2026-11-15 14:00:02.310] [biopass] [debug] FaceAuth: Recognition PASSED on the colour camera | matched face='/h/faces/a.jpg' score=0.6512
+";
+        let (scores, threshold) = scores_from_log(log);
+        assert_eq!(
+            scores,
+            vec![
+                FaceScore {
+                    path: "/h/faces/a.jpg".into(),
+                    score: 0.6512
+                },
+                FaceScore {
+                    path: "/h/faces/b.jpg".into(),
+                    score: 0.512
+                },
+            ]
+        );
+        assert_eq!(threshold, Some(0.6));
+        assert_eq!(scores_from_log("nothing\n"), (vec![], None));
+    }
+
+    #[test]
+    fn face_paths_without_a_faces_dir_stay() {
+        assert_eq!(short_face_paths("face='x.jpg' a"), "x.jpg a");
+        assert_eq!(short_face_paths("face='unterminated"), "face='unterminated");
+    }
+
+    #[test]
+    fn finds_the_login_name_of_a_uid() {
+        let passwd =
+            "root:x:0:0::/root:/bin/bash\nsteamos:x:1000:1000::/home/steamos:/bin/bash\nbroken\n";
+        assert_eq!(name_for_uid(passwd, 1000).as_deref(), Some("steamos"));
+        assert_eq!(name_for_uid(passwd, 0).as_deref(), Some("root"));
+        assert_eq!(name_for_uid(passwd, 1001), None);
+    }
+
+    #[test]
+    fn a_helper_that_cannot_start_is_an_error() {
+        assert!(scan("/nonexistent/biopass-helper", "u").is_err());
+        // /bin/false ignores its arguments and exits 1: a face that did not match.
+        let result = scan("/bin/false", "u").unwrap();
+        assert_eq!(result.outcome, ScanOutcome::NoMatch);
+        assert!(result.steps.is_empty());
+    }
+}
