diff --git a/app/src/app/configuration/-components/face/ThresholdsSection.tsx b/app/src/app/configuration/-components/face/ThresholdsSection.tsx
new file mode 100644
index 0000000..3d5a4cc
--- /dev/null
+++ b/app/src/app/configuration/-components/face/ThresholdsSection.tsx
@@ -0,0 +1,119 @@
+import { useFormContext, useWatch } from "react-hook-form";
+import type { BiopassConfig } from "@/types/config";
+import { Threshold } from "../methods/shared/Threshold";
+import {
+  faceModeOf,
+  irThresholdOf,
+  RECOMMENDED_THRESHOLD,
+  thresholdsUsed,
+} from "./faceMode";
+
+const OPTIONS = { shouldDirty: true, shouldValidate: true } as const;
+
+/**
+ * The thresholds that decide a scan, side by side: each camera's recognition
+ * threshold (recognition.threshold for the colour camera,
+ * recognition.ir_threshold for the IR camera: their pictures score
+ * differently) and the AI anti-spoofing model's. Test shows the scores they
+ * are compared with.
+ */
+export function ThresholdsSection() {
+  const { setValue } = useFormContext<BiopassConfig>();
+  const face = useWatch<BiopassConfig, "methods.face">({
+    name: "methods.face",
+  });
+  const mode = faceModeOf(face);
+  const used = thresholdsUsed(mode);
+  const ownIr = face.recognition.ir_threshold !== null;
+  const antiSpoofing = face.anti_spoofing.enable && mode !== "ir";
+  const low = [
+    used.colour && face.recognition.threshold < RECOMMENDED_THRESHOLD,
+    used.ir && irThresholdOf(face) < RECOMMENDED_THRESHOLD,
+  ].some(Boolean);
+  const note = (on: boolean) =>
+    on ? "used in this mode" : "not used in this mode";
+
+  return (
+    <div className="p-4 rounded-lg bg-muted/50 border border-border/50 space-y-3">
+      <div>
+        <h4 className="font-medium text-sm">Thresholds</h4>
+        <p className="text-xs text-muted-foreground">
+          A face matches when it scores above its camera's threshold against one
+          enrolled face (1 = the same picture); the two cameras' pictures score
+          differently. Test shows each score.
+        </p>
+      </div>
+      <div className="grid grid-cols-3 gap-6">
+        <div className="grid gap-1">
+          <Threshold
+            label="Colour camera"
+            step={0.01}
+            value={face.recognition.threshold}
+            onChange={(v) =>
+              setValue("methods.face.recognition.threshold", v, OPTIONS)
+            }
+          />
+          <p className="text-[11px] text-muted-foreground">
+            {note(used.colour)}
+          </p>
+        </div>
+        <div className="grid gap-1">
+          <Threshold
+            label="IR camera"
+            step={0.01}
+            value={irThresholdOf(face)}
+            onChange={(v) =>
+              setValue("methods.face.recognition.ir_threshold", v, OPTIONS)
+            }
+          />
+          <p className="text-[11px] text-muted-foreground">
+            {note(used.ir)}
+            {ownIr ? (
+              <>
+                {" · "}
+                <button
+                  type="button"
+                  className="underline cursor-pointer"
+                  onClick={() =>
+                    setValue(
+                      "methods.face.recognition.ir_threshold",
+                      null,
+                      OPTIONS,
+                    )
+                  }
+                >
+                  same as colour
+                </button>
+              </>
+            ) : (
+              " · same as colour"
+            )}
+          </p>
+        </div>
+        <div className="grid gap-1">
+          <Threshold
+            label="Anti-spoofing"
+            step={0.01}
+            disabled={!antiSpoofing}
+            value={face.anti_spoofing.model.threshold}
+            onChange={(v) =>
+              setValue("methods.face.anti_spoofing.model.threshold", v, OPTIONS)
+            }
+          />
+          <p className="text-[11px] text-muted-foreground">
+            {antiSpoofing
+              ? "a spoof when the model's score reaches it"
+              : "anti-spoofing is off"}
+          </p>
+        </div>
+      </div>
+      <p
+        className={`text-xs ${low ? "text-amber-600 dark:text-amber-400" : "text-muted-foreground"}`}
+      >
+        {low
+          ? `Below ${RECOMMENDED_THRESHOLD} a stranger matches far more often (about 4% of strangers over 5 scans at 0.5, 0.3% at 0.6).`
+          : "If your own face scores close to a threshold, replace the faces that score low rather than lowering it. If anti-spoofing flags you, Test shows its score: raise its threshold above it."}
+      </p>
+    </div>
+  );
+}
