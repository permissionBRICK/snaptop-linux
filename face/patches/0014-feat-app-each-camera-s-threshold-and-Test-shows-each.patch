+/// The number after `name` among the whitespace-separated words of `text`
+/// ("score=0.4813", "x=0.12").
+fn field(text: &str, name: &str) -> Option<f64> {
+    text.split_whitespace()
+        .find_map(|kv| {
+            kv.trim_end_matches([',', ')'])
+                .strip_prefix(name)?
+                .parse::<f64>()
+                .ok()
+        })
+        .filter(|v| v.is_finite())
+}
+
+/// The two limits of "(at most 0.50, 1.50)".
+fn at_most(text: &str) -> (Option<f64>, Option<f64>) {
+    let Some(rest) = text.split("(at most ").nth(1) else {
+        return (None, None);
+    };
+    let mut nums = rest
+        .split([',', ')'])
+        .map(|n| n.trim().parse::<f64>().ok().filter(|v| v.is_finite()));
+    (nums.next().flatten(), nums.next().flatten())
+}
