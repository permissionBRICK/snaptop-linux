+// Logged in every attempt while the mode is on, so a scan (s15-face check,
+// the app's Test) shows the light against the limit.
+LightPath FaceAuth::lightOnColour(const Sighting* colour, std::optional<double> faceless_luma,
+                                  bool ir_faces) const {
+  const float limit = face_config_.anti_spoofing.low_light_luma;
+  const std::optional<double> luma =
+      colour ? std::optional<double>(measureLuma(colour->face.image).mean) : faceless_luma;
+  const LightPath path = chooseLightPath(colour != nullptr, luma, limit, ir_faces);
+  if (!luma) {
+    return path;
+  }
+  const std::string what = colour ? fmt::format("face luma {:.0f}", *luma)
+                                  : fmt::format("no face, picture luma {:.0f}", *luma);
+  if (path == LightPath::IrSameFace || path == LightPath::IrAlone) {
+    spdlog::debug(
