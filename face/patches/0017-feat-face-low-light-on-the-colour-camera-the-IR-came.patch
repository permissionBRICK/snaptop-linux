+  lit.isAvailable();
+  expect(lit.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Failure,
+         "enough light, a face: anti-spoofing runs (no model in this test: fails closed)");
+  expect(bright.matched_sets.empty() || joined(bright.matched_sets) == "rgb",
+         "enough light: the colour face, never the IR camera alone");
+
+  // Not recognised by the IR camera at the low-light threshold: a retry.
+  Rig miss;
+  miss.light[kRgbWidth] = {48};
+  miss.matches[FaceAuth::FaceSet::Ir] = {false};
+  FaceAuth missed(bothConfig(), kUser, opener(miss), seams(miss));
+  missed.isAvailable();
+  expect(missed.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Retry,
+         "low light, IR not recognised: retry");
+  expect(joined(miss.matched_sets) == "ir", "low light, IR not recognised: colour not matched");
+}
+
+// Low light and a face in front of the colour camera: the IR camera's face
+// must be that face (a dark photo held up for the colour camera next to
+// someone else), at that moment.
+void checkLowLightOneFace() {
+  Rig rig;
+  rig.light[kRgbWidth] = {48};
+  rig.seen[kIrWidth] = {Seen::Beside};
+  FaceAuth face(bothConfig(), kUser, opener(rig), seams(rig));
+  face.isAvailable();
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Failure,
+         "low light, two faces: failure (counts as a false face)");
+  expect(rig.matched_sets.empty(), "low light, two faces: nothing matched");
+  expect(rig.live == 0, "low light, two faces: the cameras are closed");
+
+  Rig late;
+  late.light[kRgbWidth] = {48};
+  late.capture_time[kIrWidth] = biopass::kBothCamerasMaxGap + milliseconds(1);
+  FaceAuth slow(bothConfig(), kUser, opener(late), seams(late));
+  slow.isAvailable();
+  expect(slow.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::NoFace,
+         "low light, IR frame after the gap: nothing compared");
+  expect(late.matched_sets.empty(), "low light, IR frame after the gap: not matched");
+}
+
+// Pitch black, or the colour lens covered: no face in a dark colour picture.
+// The IR camera decides alone (as Windows Hello does); without a face there
+// either, nothing is compared.
+void checkLowLightNoColourFace() {
+  Rig rig;
+  rig.seen[kRgbWidth] = {Seen::NoFace};
+  rig.light[kRgbWidth] = {5};
+  FaceAuth face(bothConfig(), kUser, opener(rig), seams(rig));
+  face.isAvailable();
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Success,
+         "dark, no colour face: recognised by the IR camera alone");
+  expect(joined(rig.opens) == "rgb,ir" && joined(rig.matched_sets) == "ir",
+         "dark, no colour face: IR only (" + joined(rig.matched_sets) + ")");
+  expect(joined(rig.thresholds) == "0.70", "dark, no colour face: at the low-light threshold");
+
+  Rig nobody;
+  nobody.seen[kRgbWidth] = {Seen::NoFace};
+  nobody.seen[kIrWidth] = {Seen::NoFace};
+  nobody.light[kRgbWidth] = {5};
+  FaceAuth empty(bothConfig(), kUser, opener(nobody), seams(nobody));
+  empty.isAvailable();
+  expect(empty.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::NoFace,
+         "dark, no face on either camera: nothing compared");
+  expect(nobody.matched_sets.empty(), "dark, no face on either camera: nothing matched");
+
+  // A colour face too small (across the room) in the dark: no colour face in
+  // front of it, but not "no face" either: nothing compared, IR not opened.
+  Rig far;
+  far.seen[kRgbWidth] = {Seen::Small};
+  far.light[kRgbWidth] = {5};
+  FaceAuth distant(bothConfig(), kUser, opener(far), seams(far));
+  distant.isAvailable();
+  expect(distant.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::NoFace,
+         "dark, a small colour face: nothing compared");
+  expect(joined(far.opens) == "rgb", "dark, a small colour face: the IR camera is not opened");
+}
+
+// An attempt that starts on the IR camera (left open by the last one): its
+// face matched the IR camera's threshold while the colour camera opened; a
+// dark colour picture then asks for the low-light threshold, compared again.
+void checkLowLightIrFirst() {
+  Rig rig;
+  rig.matches[FaceAuth::FaceSet::Ir] = {false};
+  rig.light[kRgbWidth] = {128, 48};
+  biopass::FaceMethodConfig config = bothConfig();
+  config.recognition.ir_threshold = 0.6f;
+  FaceAuth face(config, kUser, opener(rig), seams(rig));
+  face.isAvailable();
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Retry,
+         "IR first: the first attempt (enough light) is not recognised in IR");
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Success,
+         "IR first, then a dark colour face: recognised by the IR camera alone");
+  expect(joined(rig.opens) == "rgb,ir,rgb",
+         "IR first: one switch to colour (" + joined(rig.opens) + ")");
+  expect(joined(rig.matched_sets) == "rgb,ir,ir,ir",
+         "IR first: the IR face again, not the colour one (" + joined(rig.matched_sets) + ")");
+  expect(joined(rig.thresholds) == "0.50,0.60,0.60,0.70",
+         "IR first: its threshold, then the low-light one (" + joined(rig.thresholds) + ")");
+
+  // Its face scores between the IR and the low-light threshold: a retry.
+  Rig between;
+  between.matches[FaceAuth::FaceSet::Ir] = {false, true, false};
+  between.light[kRgbWidth] = {128, 48};
+  FaceAuth face2(config, kUser, opener(between), seams(between));
+  face2.isAvailable();
+  face2.authenticate(kUser, biopass::AuthConfig{});
+  expect(face2.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Retry,
+         "IR first, dark: above the IR threshold but not the low-light one: retry");
+
+  // A low-light threshold no higher than the IR camera's: no second compare.
+  Rig same;
+  same.matches[FaceAuth::FaceSet::Ir] = {false};
+  same.seen[kRgbWidth] = {Seen::Face, Seen::NoFace};
+  same.light[kRgbWidth] = {128, 5};
+  config.recognition.ir_low_light_threshold = 0.6f;
+  FaceAuth face3(config, kUser, opener(same), seams(same));
+  face3.isAvailable();
+  face3.authenticate(kUser, biopass::AuthConfig{});
+  expect(face3.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Success,
+         "IR first, then a black colour picture without a face: the IR camera alone");
+  expect(joined(same.thresholds) == "0.50,0.60,0.60",
+         "low-light threshold = IR threshold: the IR face is not compared again (" +
+             joined(same.thresholds) + ")");
+}
+
+// The low-light threshold is never below the IR camera's own.
+void checkLowLightThreshold() {
+  biopass::FaceMethodConfig config = bothConfig();
+  {
+    FaceAuth face(config, kUser);
+    expect(face.lowLightIrThreshold() == 0.7f, "low-light threshold: 0.7 by default");
+  }
+  config.recognition.ir_threshold = 0.75f;
+  {
+    FaceAuth face(config, kUser);
+    expect(face.lowLightIrThreshold() == 0.75f, "low-light threshold: the IR one when higher");
+  }
+  config.recognition.ir_threshold.reset();
+  config.recognition.threshold = 0.8f;
+  {
+    FaceAuth face(config, kUser);
+    expect(face.lowLightIrThreshold() == 0.8f,
+           "low-light threshold: the colour one when the IR camera takes it");
+  }
+  // Only with a colour main camera and a separate IR camera.
+  biopass::FaceMethodConfig ir = bothConfig();
+  ir.camera = kIr;
+  {
+    FaceAuth face(ir, kUser);
+    expect(!face.lowLightMode(), "low light: not with the IR camera as the main camera");
+  }
+  biopass::FaceMethodConfig no_ir = bothConfig();
+  no_ir.anti_spoofing.ir_camera.reset();
+  no_ir.anti_spoofing.ir_recognition = false;
+  {
+    FaceAuth face(no_ir, kUser);
+    expect(!face.lowLightMode(), "low light: not without an IR camera");
+  }
+}
+
+// The colour camera with the IR presence check (ir_recognition off) and faces
+// enrolled for the IR camera: low light hands the decision to the IR
+// camera's recognition, which replaces the presence check. Without IR faces
+// nothing changes (here: a dark picture without a face compares nothing).
+void checkLowLightPresenceMode() {
+  Rig rig;
+  rig.seen[kRgbWidth] = {Seen::Face, Seen::NoFace};
+  rig.light[kRgbWidth] = {48, 128};
+  biopass::FaceMethodConfig rgb = bothConfig();
+  rgb.anti_spoofing.ir_recognition = false;
+  FaceAuth face(rgb, kUser, opener(rig), seams(rig));
+  expect(face.lowLightMode(), "presence check: low light possible");
+  face.isAvailable();
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Success,
+         "presence check, low light: recognised by the IR camera alone");
+  expect(joined(rig.opens) == "rgb,ir" && joined(rig.matched_sets) == "ir" &&
+             joined(rig.thresholds) == "0.70",
+         "presence check, low light: IR faces at the low-light threshold (" +
+             joined(rig.matched_sets) + " " + joined(rig.thresholds) + ")");
+  // (Nobody there in enough light: the presence check would need the real
+  // detector.)
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::NoFace,
+         "presence check: the next attempt, nobody in a bright picture: nothing compared");
+  expect(joined(rig.opens) == "rgb,ir,rgb",
+         "presence check: the colour camera again (" + joined(rig.opens) + ")");
+
+  Rig none;
+  none.enrolled[FaceAuth::FaceSet::Ir].clear();
+  none.seen[kRgbWidth] = {Seen::NoFace};
+  none.light[kRgbWidth] = {5};
+  FaceAuth face2(rgb, kUser, opener(none), seams(none));
+  face2.isAvailable();
+  expect(face2.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::NoFace,
+         "presence check, dark, no IR faces: nothing compared");
+  expect(joined(none.opens) == "rgb", "presence check, no IR faces: the IR camera stays closed");
+}
+
 int main() {
+  checkLowLightFace();
+  checkLowLightOneFace();
+  checkLowLightNoColourFace();
+  checkLowLightIrFirst();
+  checkLowLightThreshold();
+  checkLowLightPresenceMode();
   checkTwoFacesFail();
   checkThresholdPerCamera();
   checkBothMatch();
