diff --git a/auth/face/common/low_light.cc b/auth/face/common/low_light.cc
new file mode 100644
index 0000000..0ada0bb
--- /dev/null
+++ b/auth/face/common/low_light.cc
@@ -0,0 +1,25 @@
+#include "low_light.h"
+
+#include <algorithm>
+
+namespace biopass {
+
+bool isLowLight(double luma, float limit) {
+  // NaN fails every comparison: never low.
+  return limit > 0.0f && luma < static_cast<double>(limit);
+}
+
+LightPath chooseLightPath(bool colour_face, std::optional<double> luma, float limit,
+                          bool ir_faces) {
+  const bool low = luma && isLowLight(*luma, limit) && ir_faces;
+  if (colour_face) {
+    return low ? LightPath::IrSameFace : LightPath::Colour;
+  }
+  return low ? LightPath::IrAlone : LightPath::NoFace;
+}
+
+float lowLightThreshold(float low_light_threshold, float ir_threshold) {
+  return std::max(low_light_threshold, ir_threshold);
+}
+
+}  // namespace biopass
diff --git a/auth/face/common/low_light.h b/auth/face/common/low_light.h
new file mode 100644
index 0000000..af36f6a
--- /dev/null
+++ b/auth/face/common/low_light.h
@@ -0,0 +1,51 @@
+#pragma once
+
+// Low light on the colour camera (anti_spoofing.low_light_luma): with a colour
+// and an IR camera (both-cameras mode, or the IR presence check with faces
+// enrolled for the IR camera), a colour picture too dark for the colour
+// checks hands the decision to the IR camera, which lights the face itself:
+// it recognises alone, at a stricter threshold, as Windows Hello does. The AI
+// anti-spoofing models and the colour recognition need light: in an ordinary
+// evening room they took real faces for spoofs (scores 0.86-0.99 at a
+// threshold of 0.8, the face's mean luma about 48 of 255) and scored the user
+// far lower, while the IR camera recognised as well as in daylight. Pure, so
+// the decision can be tested without a camera.
+
+#include <optional>
+
+namespace biopass {
+
+// True when the low-light mode is on (limit above 0) and `luma` is below
+// `limit`. A NaN luma or limit never is.
+bool isLowLight(double luma, float limit);
+
+// Which camera decides an attempt, from the colour picture's light.
+enum class LightPath {
+  // Enough light, the low-light mode off, or no faces enrolled for the IR
+  // camera: anti-spoofing and the recognitions, as without the mode.
+  Colour,
+  // Low light, a face in front of the colour camera: the IR camera
+  // recognises alone, at the low-light threshold, and its face must be the
+  // colour camera's (the one-face check, face_pair.h).
+  IrSameFace,
+  // Low light and no face at all in the colour picture (a dark room, or the
+  // lens covered): the IR camera recognises alone, at the low-light threshold.
+  IrAlone,
+  // No face in front of the colour camera and not low light, or a face that is
+  // too small or cut off: nothing to compare (as without the mode).
+  NoFace,
+};
+
+// colour_face: the colour camera found a face in front of it; `luma` is then
+// its box's mean luma, else the whole picture's when it showed no face at all
+// (nullopt: neither, i.e. a face too small or cut off, or no picture).
+// limit: anti_spoofing.low_light_luma. ir_faces: faces are enrolled for the IR
+// camera, so it can recognise.
+LightPath chooseLightPath(bool colour_face, std::optional<double> luma, float limit, bool ir_faces);
+
+// The IR camera's threshold when it decides alone: the configured low-light
+// threshold, never below the IR camera's own threshold (low light never
+// loosens recognition).
+float lowLightThreshold(float low_light_threshold, float ir_threshold);
+
+}  // namespace biopass
