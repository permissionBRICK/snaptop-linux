+++ b/auth/test/low_light/main.cpp
@@ -0,0 +1,85 @@
+// Checks face/common/low_light.h: when the colour picture is too dark for the
+// colour checks, the IR camera decides alone, at a threshold never below its
+// own. Exits non-zero on any failure.
+
+#include <cstdio>
+#include <limits>
+#include <optional>
+
+#include "low_light.h"
+
+namespace {
+
+using biopass::chooseLightPath;
+using biopass::isLowLight;
+using biopass::LightPath;
+using biopass::lowLightThreshold;
+
+int g_failures = 0;
+
+void expect(bool cond, const char* what) {
+  std::printf("[%s] %s\n", cond ? "PASS" : "FAIL", what);
+  if (!cond) {
+    g_failures++;
+  }
+}
+
+constexpr double kNaN = std::numeric_limits<double>::quiet_NaN();
+constexpr float kLimit = 70.0f;
+
+}  // namespace
+
+int main() {
+  // Measured on the laptop's colour camera (the face box's mean luma): an
+  // evening room 47-48, daylight 86.
+  expect(isLowLight(48.0, kLimit), "luma 48 against 70: low light");
+  expect(!isLowLight(86.0, kLimit), "luma 86 against 70: enough light");
+  expect(!isLowLight(70.0, kLimit), "luma at the limit: enough light (below it is low)");
+  expect(isLowLight(69.9, kLimit), "just below the limit: low light");
+  expect(!isLowLight(0.0, 0.0f), "limit 0: the mode is off, even for a black picture");
+  expect(!isLowLight(10.0, -1.0f), "a negative limit: off");
+  expect(!isLowLight(kNaN, kLimit), "a NaN luma: never low");
+  expect(!isLowLight(10.0, std::numeric_limits<float>::quiet_NaN()), "a NaN limit: never low");
+  expect(isLowLight(254.0, 255.0f), "limit 255: nearly every picture is low");
+
+  // A face in front of the colour camera.
+  expect(chooseLightPath(true, 86.0, kLimit, true) == LightPath::Colour,
+         "a face in enough light: the colour checks");
+  expect(chooseLightPath(true, 48.0, kLimit, true) == LightPath::IrSameFace,
+         "a face in low light: the IR camera decides, on the same face");
+  expect(chooseLightPath(true, 48.0, kLimit, false) == LightPath::Colour,
+         "a face in low light, no IR faces: the colour checks (nothing else can decide)");
+  expect(chooseLightPath(true, 48.0, 0.0f, true) == LightPath::Colour,
+         "a face in low light, mode off: the colour checks");
+
+  // No face at all in the colour picture: its whole luma.
+  expect(chooseLightPath(false, 30.0, kLimit, true) == LightPath::IrAlone,
+         "no face, a dark picture: the IR camera decides alone");
+  expect(chooseLightPath(false, 2.0, kLimit, true) == LightPath::IrAlone,
+         "no face, pitch black or the lens covered: the IR camera decides alone");
+  expect(chooseLightPath(false, 100.0, kLimit, true) == LightPath::NoFace,
+         "no face in a bright picture: nobody there, nothing to compare");
+  expect(chooseLightPath(false, 30.0, kLimit, false) == LightPath::NoFace,
+         "no face, dark, no IR faces: nothing to compare");
+  expect(chooseLightPath(false, 30.0, 0.0f, true) == LightPath::NoFace,
+         "no face, dark, mode off: nothing to compare (as without the mode)");
+
+  // A face too small or cut off (or no picture): no luma, never the IR camera.
+  expect(chooseLightPath(false, std::nullopt, kLimit, true) == LightPath::NoFace,
+         "a face too small or cut off: nothing to compare, also in the dark");
+  expect(chooseLightPath(true, kNaN, kLimit, true) == LightPath::Colour,
+         "a face with a NaN luma: the colour checks");
+
+  // The IR camera's threshold when it decides alone.
+  expect(lowLightThreshold(0.7f, 0.6f) == 0.7f, "low-light 0.70 above the IR 0.60: 0.70");
+  expect(lowLightThreshold(0.55f, 0.6f) == 0.6f,
+         "low-light 0.55 below the IR 0.60: the IR camera's own (never looser)");
+  expect(lowLightThreshold(0.7f, 0.75f) == 0.75f, "an IR threshold above it: the IR one");
+
+  if (g_failures != 0) {
+    std::printf("%d FAILED\n", g_failures);
+    return 1;
+  }
+  std::printf("ALL PASS\n");
+  return 0;
+}
