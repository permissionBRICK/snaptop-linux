diff --git a/auth/test/auth_manager/main.cpp b/auth/test/auth_manager/main.cpp
index c3e6373..6c1312f 100644
--- a/auth/test/auth_manager/main.cpp
+++ b/auth/test/auth_manager/main.cpp
@@ -332,6 +332,73 @@ void checkLogLevel() {
   spdlog::set_level(spdlog::level::off);
 }
 
+// biopass-helper auth --keep-looking: attempts with nothing to compare
+// (NoFace) use up no try, the first comparison decides, and a run that never
+// compared anything ends as NoFace (exit 3), not as a failure. Without it a
+// NoFace attempt is a try like Retry.
+void checkKeepLooking(ExecutionMode mode, const char* label) {
+  auto name = [label](const std::string& what) { return std::string(label) + ": " + what; };
+  auto runLooking = [mode](const std::vector<Spec>& specs, uint32_t look_ms,
+                           std::vector<Calls>* calls = nullptr,
+                           std::chrono::milliseconds budget = std::chrono::milliseconds(0)) {
+    std::vector<Calls> local;
+    AuthManager manager;
+    setUp(manager, mode, specs, calls ? *calls : local);
+    biopass::AuthConfig config;
+    config.keep_looking_ms = look_ms;
+    manager.setConfig(config);
+    if (budget.count() > 0) {
+      manager.setDeadline(std::chrono::steady_clock::now() + budget);
+    }
+    return manager.authenticate("someone");
+  };
+  using R = AuthResult;
+  std::vector<Calls> calls;
+
+  expect(runLooking({Spec{{R::NoFace, R::NoFace, R::NoFace, R::NoFace, R::Success}, true, 1}},
+                    5000, &calls) == Outcome::Success,
+         name("keep looking: no face 4 times, then a match -> success"));
+  expect(calls[0].authenticate == 5, name("keep looking: no-face attempts use up no try (5 with 1 try)"));
+
+  expect(runLooking({Spec{{R::NoFace, R::Retry, R::Success}, true, 5}}, 5000, &calls) ==
+             Outcome::Failure,
+         name("keep looking: the first face compared decides, a mismatch -> failure"));
+  expect(calls[0].authenticate == 2, name("keep looking: a mismatch is not retried"));
+
+  expect(runLooking({Spec{{R::NoFace, R::Failure}, true, 5}}, 5000) == Outcome::Failure,
+         name("keep looking: anti-spoofing failure -> failure"));
+
+  const auto start = std::chrono::steady_clock::now();
+  expect(runLooking({Spec{{R::NoFace}, true, 1, 20}}, 150, &calls) == Outcome::NoFace,
+         name("keep looking: nothing compared within the time -> no face"));
+  const long long took = msSince(start);
+  expect(took >= 150 && took < kQuickMs,
+         name("keep looking: stops after the look time (" + std::to_string(took) + " ms)"));
+  expect(calls[0].authenticate > 2, name("keep looking: retry_delay apart, not one attempt"));
+
+  expect(runLooking({Spec{{R::NoFace}, true, 1, 20}}, 5000, nullptr,
+                    std::chrono::milliseconds(200)) == Outcome::NoFace,
+         name("keep looking: the time budget ends the look -> no face, not failure"));
+
+  expect(runLooking({Spec{{R::NoFace, R::Unavailable}, true, 1}}, 5000) == Outcome::NoFace,
+         name("keep looking: camera gone after looking -> no face"));
+  expect(runLooking({Spec{{R::Unavailable}}}, 5000) == Outcome::Ignore,
+         name("keep looking: unavailable at once -> ignore"));
+  expect(runLooking({Spec{{R::NoFace}, true, 1, 0}, Spec{{R::Retry}, true, 1}}, 50) ==
+             Outcome::Failure,
+         name("keep looking: no face + a mismatch elsewhere -> failure"));
+  expect(runLooking({Spec{{R::NoFace}, true, 1, 0}, Spec{{R::Success}, true, 1, 0, 100}}, 5000) ==
+             Outcome::Success,
+         name("keep looking: no face + a success elsewhere -> success"));
+
+  // Without keep_looking: Biopass's own behaviour, NoFace uses up a try.
+  expect(run(mode, {Spec{{R::NoFace}, true, 3}}, &calls) == Outcome::Failure,
+         name("no keep looking: no face 3 times with 3 tries -> failure"));
+  expect(calls[0].authenticate == 3, name("no keep looking: each no-face attempt is a try"));
+  expect(run(mode, {Spec{{R::NoFace, R::Retry, R::Success}, true, 3}}) == Outcome::Success,
+         name("no keep looking: no face, mismatch, match within 3 tries -> success"));
+}
+
 }  // namespace
 
