diff --git a/auth/core/auth_manager.cc b/auth/core/auth_manager.cc
index 3b9c023..809289e 100644
--- a/auth/core/auth_manager.cc
+++ b/auth/core/auth_manager.cc
@@ -90,11 +90,53 @@ class DeadlineWatch {
   std::thread thread_;
 };
 
+// keep_looking (see AuthConfig): attempts with nothing to compare (NoFace)
+// use up no try; the method keeps looking, retry_delay apart, until an
+// attempt compared something, keep_looking_ms passed or `cancel` is set. The
+// first comparison decides: a mismatch (Retry) is a Failure, never retried.
+// Nothing compared (looked until the end, cancelled, or the method went away
+// after looking) = NoFace.
+AuthResult runUntilCompared(IAuthMethod& method, const std::string& username,
+                            const AuthConfig& config, std::atomic<bool>& cancel) {
+  const auto look_until =
+      std::chrono::steady_clock::now() + std::chrono::milliseconds(config.keep_looking_ms);
+  bool looked = false;
+  for (;;) {
+    if (cancel.load()) {
+      return looked ? AuthResult::NoFace : AuthResult::Failure;
+    }
+    if (!looked) {
+      spdlog::debug("AuthManager: Trying {} authentication, looking for up to {} ms",
+                    method.name(), config.keep_looking_ms);
+    }
+    const AuthResult result = method.authenticate(username, config, &cancel);
+    if (result == AuthResult::Unavailable && looked) {
+      return AuthResult::NoFace;
+    }
+    if (result != AuthResult::NoFace) {
+      return result == AuthResult::Retry ? AuthResult::Failure : result;
+    }
+    looked = true;
+    if (std::chrono::steady_clock::now() >= look_until) {
+      spdlog::debug("AuthManager: {} saw nothing to compare in {} ms", method.name(),
+                    config.keep_looking_ms);
+      return AuthResult::NoFace;
+    }
+    if (!sleepUnlessCancelled(std::chrono::milliseconds(method.getRetryDelayMs()), &cancel)) {
+      return AuthResult::NoFace;
+    }
+  }
+}
+
 // Runs `method`'s attempts until one is final, its retries run out or
 // `cancel` is set (retry sleeps wake for it too). Cancelled before the first
-// attempt = Failure.
+// attempt = Failure. Without keep_looking an attempt with nothing to compare
+// (NoFace) is a try like any other (Retry).
 AuthResult runAttempts(IAuthMethod& method, const std::string& username, const AuthConfig& config,
                        std::atomic<bool>& cancel) {
+  if (config.keep_looking_ms > 0) {
+    return runUntilCompared(method, username, config, cancel);
+  }
   RetryStrategy retry_strategy(method.getRetries());
   uint32_t attempts = 0;
   AuthResult result = AuthResult::Failure;
@@ -113,6 +155,9 @@ AuthResult runAttempts(IAuthMethod& method, const std::string& username, const A
     }
 
     result = method.authenticate(username, config, &cancel);
+    if (result == AuthResult::NoFace) {
+      result = AuthResult::Retry;
+    }
     attempts++;
   } while (retry_strategy.shouldRetry(result, attempts) && !cancel.load());
 
@@ -199,6 +244,7 @@ AuthOutcome AuthManager::authenticate(const std::string& username) {
 
 AuthOutcome AuthManager::runSequential(const std::string& username, std::atomic<bool>& cancel) {
   bool any_attempted = false;
+  bool any_looked = false;
 
   for (auto& method : this->methods_) {
     if (cancel.load()) {
@@ -227,9 +273,16 @@ AuthOutcome AuthManager::runSequential(const std::string& username, std::atomic<
         any_attempted = true;
         spdlog::debug("AuthManager: {} requested retry but max retries exceeded", method->name());
         break;
+      case AuthResult::NoFace:
+        any_looked = true;
+        spdlog::debug("AuthManager: {} had nothing to compare, trying next", method->name());
+        break;
     }
   }
 
+  if (!any_attempted && any_looked) {
+    return AuthOutcome::NoFace;
+  }
   if (!any_attempted) {
     spdlog::debug("AuthManager: No methods were able to run for this user, skipping module");
     return AuthOutcome::Ignore;
@@ -267,10 +320,13 @@ AuthOutcome AuthManager::runParallel(const std::string& username, std::atomic<bo
 
   bool any_success = false;
   bool any_attempted = false;
+  bool any_looked = false;
   for (auto& future : futures) {
     AuthResult result = future.get();
     if (result == AuthResult::Success) {
       any_success = true;
+    } else if (result == AuthResult::NoFace) {
+      any_looked = true;
     } else if (result != AuthResult::Unavailable) {
       any_attempted = true;
     }
@@ -280,6 +336,10 @@ AuthOutcome AuthManager::runParallel(const std::string& username, std::atomic<bo
     return AuthOutcome::Success;
   }
 
+  if (!any_attempted && any_looked) {
+    return AuthOutcome::NoFace;
+  }
+
   if (!any_attempted) {
     spdlog::debug("AuthManager: All parallel methods became unavailable, skipping module");
     return AuthOutcome::Ignore;
