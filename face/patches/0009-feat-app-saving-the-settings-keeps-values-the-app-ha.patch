+
+    /// What the helper reads and other tools (s15-face) write, but this app
+    /// has no field for, survives a save; the app's own fields take the form's
+    /// values.
+    #[test]
+    fn save_keeps_values_the_app_does_not_know() {
+        let on_disk = format!(
+            "schema_version: {CURRENT_SCHEMA_VERSION}\n\
+             added_later: 1\n\
+             methods:\n  face:\n    retries: 2\n    future_option: [a, b]\n\
+             \x20   detection:\n      model_id: yolov8n-face\n      max_faces: 3\n\
+             strategy:\n  debug: true\n"
+        );
+        let mut config = parse_config(&on_disk).unwrap();
+        config.methods.face.retries = 7;
+        config.strategy.debug = false;
+        let saved = yaml(&merged_yaml(Some(&on_disk), &config).unwrap());
+
+        assert_eq!(saved["added_later"], yaml("1"));
+        assert_eq!(saved["methods"]["face"]["future_option"], yaml("[a, b]"));
+        assert_eq!(
+            saved["methods"]["face"]["detection"]["max_faces"],
+            yaml("3")
+        );
+        assert_eq!(saved["methods"]["face"]["retries"], yaml("7"));
+        assert_eq!(saved["strategy"]["debug"], yaml("false"));
+        // Read back, it is the form's config.
+        let text = yaml_serde::to_string(&saved).unwrap();
+        assert_eq!(parse_config(&text).unwrap(), config);
+    }
+
+    #[test]
+    fn save_writes_the_face_unlock_fields() {
+        let mut config = get_default_config();
+        config.methods.face.camera = Some("/base/cam@36".to_string());
+        config.methods.face.anti_spoofing.ir_camera = Some("/base/cam@24".to_string());
+        config.methods.face.anti_spoofing.ir_recognition = true;
+        config.methods.face.detection.min_face_height = 0.2;
+        let saved = yaml(&merged_yaml(None, &config).unwrap());
+        let face = &saved["methods"]["face"];
+        assert_eq!(face["detection"]["min_face_height"], yaml("0.2"));
+        assert_eq!(face["anti_spoofing"]["ir_recognition"], yaml("true"));
+        assert_eq!(face["camera_profiles"], yaml("[]"));
+        assert_eq!(
+            parse_config(&yaml_serde::to_string(&saved).unwrap()).unwrap(),
+            config
+        );
+    }
+
+    /// Lists are the form's, whole: camera profiles the form cleared are gone.
+    #[test]
+    fn save_replaces_lists() {
+        let on_disk = format!(
+            "schema_version: {CURRENT_SCHEMA_VERSION}\nmethods:\n  face:\n    camera_profiles:\n    - camera: /dev/video0\n      extra: 1\n"
+        );
+        let saved = yaml(&merged_yaml(Some(&on_disk), &get_default_config()).unwrap());
+        assert_eq!(saved["methods"]["face"]["camera_profiles"], yaml("[]"));
+    }
+
+    #[test]
+    fn save_replaces_an_older_schema_and_refuses_bad_files() {
+        let config = custom_config();
+        let fresh = yaml(&merged_yaml(None, &config).unwrap());
+        // Older or missing schema_version: the old settings are not carried
+        // over (load showed defaults for them), as before.
+        let older = "schema_version: 1\nmodels: []\n";
+        assert_eq!(yaml(&merged_yaml(Some(older), &config).unwrap()), fresh);
+        assert_eq!(
+            yaml(&merged_yaml(Some("appearance: dark\n"), &config).unwrap()),
+            fresh
+        );
+        assert_eq!(yaml(&merged_yaml(Some(""), &config).unwrap()), fresh);
+        // Never overwritten: newer, unparseable, not a mapping.
+        let newer = format!("schema_version: {}\n", CURRENT_SCHEMA_VERSION + 1);
+        assert!(merged_yaml(Some(&newer), &config).is_err());
+        assert!(merged_yaml(Some("not: [valid"), &config).is_err());
+        assert!(merged_yaml(Some("- a list"), &config).is_err());
+    }
+
+    #[test]
+    fn new_face_unlock_fields_default_off() {
+        let face = get_default_config().methods.face;
+        assert_eq!(face.detection.min_face_height, 0.0);
+        assert!(!face.anti_spoofing.ir_recognition);
+        let yaml = format!(
+            "schema_version: {CURRENT_SCHEMA_VERSION}\nmethods:\n  face:\n    detection:\n      min_face_height: 0.25\n    anti_spoofing:\n      ir_recognition: true\n"
+        );
+        let face = parse_config(&yaml).unwrap().methods.face;
+        assert_eq!(face.detection.min_face_height, 0.25);
+        assert!(face.anti_spoofing.ir_recognition);
+    }
+
     #[test]
     fn set_appearance_changes_only_appearance() {
         let yaml = yaml_serde::to_string(&custom_config()).unwrap() + "added_later: 1\n";
