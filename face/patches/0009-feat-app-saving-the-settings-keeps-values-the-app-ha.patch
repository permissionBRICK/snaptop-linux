+/// Writes `config` into config.yaml, keeping every value of the file that
+/// `config` has no field for (settings of a newer helper, of other tools,
+/// or added by hand), see merged_yaml.
 #[tauri::command]
 #[specta::specta]
 pub fn save_config(app: AppHandle, config: BiopassConfig) -> Result<(), String> {
-    let yaml_content =
-        yaml_serde::to_string(&config).map_err(|e| format!("Failed to serialize config: {}", e))?;
+    let config_path = get_config_path(&app)?;
+    let old = read_optional(&config_path)?;
+    let yaml_content = merged_yaml(old.as_deref(), &config)
+        .map_err(|e| format!("{}: {}", config_path.display(), e))?;
     write_config_file(&app, &yaml_content)
 }
 
+/// The file's text, None when there is none.
+fn read_optional(path: &Path) -> Result<Option<String>, String> {
+    match fs::read_to_string(path) {
+        Ok(text) => Ok(Some(text)),
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Ok(None),
+        Err(e) => Err(format!("Failed to read {}: {}", path.display(), e)),
+    }
+}
+
+/// `config` as YAML, merged into `content` (the current config.yaml, None:
+/// none yet): each value `config` has replaces the file's, recursively
+/// through mappings, and every key it lacks stays as it is. Lists are
+/// replaced whole. A file of an older schema (or none) is replaced, as load
+/// showed defaults for it; one that does not parse, is not a mapping or is
+/// newer is an error, never overwritten.
+fn merged_yaml(content: Option<&str>, config: &BiopassConfig) -> Result<String, String> {
+    // Through text, not to_value: that widens the f32 thresholds to f64
+    // (0.2 -> 0.20000000298023224); the text has them as written.
+    let new: yaml_serde::Value = yaml_serde::to_string(config)
+        .and_then(|text| yaml_serde::from_str(&text))
+        .map_err(|e| format!("Failed to serialize config: {}", e))?;
+    let mut merged = match content {
+        None => yaml_serde::Value::Null,
+        Some(text) => yaml_serde::from_str::<yaml_serde::Value>(text)
+            .map_err(|e| format!("config.yaml is not valid YAML: {}", e))?,
+    };
+    if !merged.is_null() {
+        if !merged.is_mapping() {
+            return Err("config.yaml is not a YAML mapping".to_string());
+        }
+        let version = merged.get("schema_version").and_then(|v| v.as_u64());
+        match version {
+            Some(v) if v > u64::from(CURRENT_SCHEMA_VERSION) => {
+                return Err(format!(
+                    "config.yaml has schema_version {}, newer than this app's {}; update Biopass",
+                    v, CURRENT_SCHEMA_VERSION
+                ));
+            }
+            Some(v) if v == u64::from(CURRENT_SCHEMA_VERSION) => {}
+            _ => merged = yaml_serde::Value::Null,
+        }
+    }
+    merge_value(&mut merged, new);
+    yaml_serde::to_string(&merged).map_err(|e| format!("Failed to serialize config: {}", e))
+}
+
+fn merge_value(into: &mut yaml_serde::Value, from: yaml_serde::Value) {
+    match (into, from) {
+        (yaml_serde::Value::Mapping(into), yaml_serde::Value::Mapping(from)) => {
+            for (key, value) in from {
+                match into.get_mut(&key) {
+                    Some(slot) => merge_value(slot, value),
+                    None => {
+                        into.insert(key, value);
+                    }
+                }
+            }
+        }
+        (into, from) => *into = from,
+    }
+}
+
 /// Returns `content` (None: no config yet) with only `appearance` changed.
 /// Works on the raw YAML so the user's other values, including fields this
 /// app doesn't know, are kept. Errors instead of replacing a config it can't
@@ -804,6 +882,101 @@ mod tests {
