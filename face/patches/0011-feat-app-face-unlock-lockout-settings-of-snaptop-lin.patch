+import type { LockoutSetting } from "@/types/config";
+
+/** Short names of the lockout settings (s15-face lockout keys). */
+export const TITLES: Record<string, string> = {
+  run_false_faces: "False faces per run",
+  free_false_faces: "False faces before the first wait",
+  first_wait: "First wait",
+  max_wait: "Longest wait",
+  off_after: "Off after false faces",
+};
+
+/** Settings whose input differs from the value in effect. */
+export function changedValues(
+  settings: readonly LockoutSetting[],
+  inputs: Readonly<Record<string, string>>,
+): { key: string; value: number }[] {
+  return settings.flatMap((s) => {
+    const text = inputs[s.key];
+    if (text === undefined || text.trim() === "") return [];
+    const value = Number(text);
+    return value === s.value ? [] : [{ key: s.key, value }];
+  });
+}
+
+/** An input outside its whole-number range, or null when all are valid. */
+export function invalidInput(
+  settings: readonly LockoutSetting[],
+  inputs: Readonly<Record<string, string>>,
+): string | null {
+  for (const s of settings) {
+    const text = (inputs[s.key] ?? "").trim();
+    const value = Number(text);
+    if (
+      text === "" ||
+      !Number.isInteger(value) ||
+      value < s.min ||
+      value > s.max
+    ) {
+      return `${TITLES[s.key] ?? s.key}: a whole number from ${s.min} to ${s.max}`;
+    }
+  }
+  return null;
+}
