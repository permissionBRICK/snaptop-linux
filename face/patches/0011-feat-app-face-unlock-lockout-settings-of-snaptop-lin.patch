+++ b/app/src/app/configuration/-components/lockoutInputs.test.ts
@@ -0,0 +1,40 @@
+import { describe, expect, test } from "bun:test";
+import type { LockoutSetting } from "@/types/config";
+import { changedValues, invalidInput } from "./lockoutInputs";
+
+function setting(key: string, value: number, min = 0, max = 100) {
+  return {
+    key,
+    value,
+    default: value,
+    min,
+    max,
+    unit: "faces",
+    meaning: "",
+  } satisfies LockoutSetting;
+}
+
+const settings = [
+  setting("run_false_faces", 3, 1, 10),
+  setting("off_after", 15, 1, 100),
+];
+
+describe("lockout inputs", () => {
+  test("only changed values are sent", () => {
+    expect(
+      changedValues(settings, { run_false_faces: "3", off_after: "10" }),
+    ).toEqual([{ key: "off_after", value: 10 }]);
+    expect(changedValues(settings, { run_false_faces: "3" })).toEqual([]);
+  });
+
+  test("whole numbers within the range only", () => {
+    expect(
+      invalidInput(settings, { run_false_faces: "3", off_after: "15" }),
+    ).toBeNull();
+    for (const bad of ["", "0", "11", "2.5", "x"]) {
+      expect(
+        invalidInput(settings, { run_false_faces: bad, off_after: "15" }),
+      ).not.toBeNull();
+    }
+  });
+});
