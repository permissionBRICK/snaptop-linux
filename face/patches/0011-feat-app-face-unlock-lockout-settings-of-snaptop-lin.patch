new file mode 100644
index 0000000..e64f373
--- /dev/null
+++ b/app/src/commands/lockout.ts
@@ -0,0 +1,21 @@
+import { commands, type LockoutValue } from "@/bindings";
+
+/** The face unlock lockout (s15-face), null on systems without it. */
+function get() {
+  return commands.getFaceLockout();
+}
+
+/** Changes settings through pkexec (administrator password). */
+async function set(values: LockoutValue[]): Promise<void> {
+  await commands.setFaceLockout(values);
+}
+
+async function resetDefaults(): Promise<void> {
+  await commands.resetFaceLockout();
+}
+
+export const lockout = {
+  get,
+  set,
+  resetDefaults,
+};
