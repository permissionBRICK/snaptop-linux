@@ -440,6 +448,29 @@ AuthResult FaceAuth::attemptBothCameras(const std::string& username, const AuthC
   if (cancel_signal && cancel_signal->load()) {
     return AuthResult::Failure;
   }
+  // One face, not two: a photo held up for the colour camera next to a real
