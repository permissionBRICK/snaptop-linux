diff --git a/auth/face/common/face_pair.cc b/auth/face/common/face_pair.cc
new file mode 100644
index 0000000..9ea2096
--- /dev/null
+++ b/auth/face/common/face_pair.cc
@@ -0,0 +1,38 @@
+#include "face_pair.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace biopass {
+
+FrameBox frameBox(int x1, int y1, int x2, int y2, int width, int height) {
+  if (width <= 0 || height <= 0) {
+    return {};
+  }
+  const float w = static_cast<float>(width);
+  const float h = static_cast<float>(height);
+  return FrameBox{(x1 + x2) / 2.0f / w, (y1 + y2) / 2.0f / h, std::max(0, x2 - x1) / w,
+                  std::max(0, y2 - y1) / h};
+}
+
+FacePair checkFacePair(const FrameBox& a, const FrameBox& b, float max_offset,
+                       float max_size_ratio) {
+  FacePair pair;
+  const float w = std::max(a.w, b.w);
+  const float h = std::max(a.h, b.h);
+  const float low = std::min(a.h, b.h);
+  // NaN limits fail closed: every comparison with NaN is false.
+  const bool check = !(max_offset <= 0.0f);
+  if (!(w > 0.0f) || !(low > 0.0f)) {
+    pair.same_place = !check;
+    return pair;
+  }
+  pair.dx = std::fabs(a.cx - b.cx) / w;
+  pair.dy = std::fabs(a.cy - b.cy) / h;
+  pair.size_ratio = h / low;
+  pair.same_place = !check || (pair.dx <= max_offset && pair.dy <= max_offset &&
+                               pair.size_ratio <= max_size_ratio);
+  return pair;
+}
+
+}  // namespace biopass
diff --git a/auth/face/common/face_pair.h b/auth/face/common/face_pair.h
new file mode 100644
index 0000000..43d28d3
--- /dev/null
+++ b/auth/face/common/face_pair.h
@@ -0,0 +1,42 @@
+#pragma once
+
+// Whether the faces two cameras saw at (nearly) one moment are the same face:
+// in both-cameras mode (anti_spoofing.ir_recognition) the colour and the IR
+// camera must each recognise the user, and without this check they could
+// recognise two different faces, e.g. a photo on a phone held next to the
+// user's real face (a phone shows nothing in infrared, so the IR camera finds
+// the real face beside it). Pure, so it can be tested without a camera.
+//
+// The cameras sit side by side and see nearly the same field, so a face is
+// compared where it lies as fractions of each picture. On the ASUS Vivobook
+// S 15 the same face measured 0.95 of its colour width and 0.86 of its colour
+// height (as fractions of each picture) in IR over 5 enrolment pairs: well
+// inside the tolerance.
+
+namespace biopass {
+
+// A face box as fractions of its frame: centre, width and height.
+struct FrameBox {
+  float cx = 0.0f, cy = 0.0f, w = 0.0f, h = 0.0f;
+};
+
+// The box (x1, y1)-(x2, y2) in pixels of a width x height frame; all zero for
+// an empty frame.
+FrameBox frameBox(int x1, int y1, int x2, int y2, int width, int height);
+
+struct FacePair {
+  // How far apart the centres are: horizontally in widths of the wider box,
+  // vertically in heights of the taller box.
+  float dx = 0.0f, dy = 0.0f;
+  // The taller box's height over the other's (>= 1).
+  float size_ratio = 1.0f;
+  bool same_place = true;
+};
+
+// The same face: centres at most max_offset face sizes apart in each direction
+// and heights at most max_size_ratio apart. max_offset <= 0 checks nothing
+// (always the same place); a NaN limit or an empty box never is.
+FacePair checkFacePair(const FrameBox& a, const FrameBox& b, float max_offset,
+                       float max_size_ratio);
+
+}  // namespace biopass
