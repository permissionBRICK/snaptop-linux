new file mode 100644
index 0000000..d3f6637
--- /dev/null
+++ b/auth/test/face_pair/main.cpp
@@ -0,0 +1,83 @@
+// Checks face/common/face_pair.h: whether the faces the colour and the IR
+// camera saw are the same face, by place and size in their pictures. Exits
+// non-zero on any failure.
+
+#include <cmath>
+#include <cstdio>
+#include <limits>
+
+#include "face_pair.h"
+
+namespace {
+
+using biopass::checkFacePair;
+using biopass::FrameBox;
+using biopass::frameBox;
+
+int g_failures = 0;
+
+void expect(bool cond, const char* what) {
+  std::printf("[%s] %s\n", cond ? "PASS" : "FAIL", what);
+  if (!cond) {
+    g_failures++;
+  }
+}
+
+bool near(float a, float b) { return std::fabs(a - b) < 1e-4f; }
+
+// The colour camera's picture (1920x1092) and the IR camera's (560x360).
+FrameBox colour(int x1, int y1, int x2, int y2) { return frameBox(x1, y1, x2, y2, 1920, 1092); }
+FrameBox ir(int x1, int y1, int x2, int y2) { return frameBox(x1, y1, x2, y2, 560, 360); }
+
+}  // namespace
+
+int main() {
+  const FrameBox box = frameBox(100, 60, 260, 260, 640, 360);
+  expect(near(box.cx, 180.0f / 640) && near(box.cy, 160.0f / 360) && near(box.w, 0.25f) &&
+             near(box.h, 200.0f / 360),
+         "frameBox: centre and size as fractions of the frame");
+  const FrameBox none = frameBox(10, 10, 20, 20, 0, 360);
+  expect(none.w == 0.0f && none.h == 0.0f, "frameBox: an empty frame gives an empty box");
+
+  // A pair from the laptop's enrolment: the face at the centre of both
+  // pictures, 0.95 of its colour width and 0.86 of its colour height in IR.
+  const FrameBox c = colour(747, 258, 1173, 833);  // 426x575
+  const FrameBox i = ir(221, 98, 339, 263);        // 118x165
+  auto pair = checkFacePair(c, i, 0.5f, 1.5f);
+  expect(pair.same_place, "a real pair: the same place");
+  expect(pair.dx < 0.05f && pair.dy < 0.05f, "a real pair: the centres nearly agree");
+  expect(pair.size_ratio > 1.1f && pair.size_ratio < 1.25f,
+         "a real pair: the IR face a little smaller (as measured)");
+
+  // The face a little off to one side on the IR camera (the head moved in the
+  // half second between the pictures, or the cameras' small parallax).
+  pair = checkFacePair(c, ir(261, 98, 379, 263), 0.5f, 1.5f);
+  expect(pair.same_place && pair.dx > 0.2f, "a third of a face width apart: the same place");
+
+  // A phone held next to the face: the colour camera recognises the photo on
+  // it, the IR camera the real face one face width beside it.
+  pair = checkFacePair(c, ir(339, 98, 457, 263), 0.5f, 1.5f);
+  expect(!pair.same_place && pair.dx > 0.9f, "a face beside the other: not the same place");
+  pair = checkFacePair(c, ir(221, 0, 339, 165), 0.5f, 1.5f);
+  expect(!pair.same_place && pair.dy > 0.5f, "a face above the other: not the same place");
+
+  // A small photo held up in the middle of the picture against the real face.
+  pair = checkFacePair(colour(860, 400, 1060, 670), i, 0.5f, 1.5f);
+  expect(!pair.same_place && pair.size_ratio > 1.5f, "half the size: not the same face");
+
+  // Limits.
+  expect(checkFacePair(c, ir(339, 98, 457, 263), 0.0f, 1.5f).same_place, "max_offset 0: no check");
+  expect(!checkFacePair(c, i, std::numeric_limits<float>::quiet_NaN(), 1.5f).same_place,
+         "max_offset NaN: fails closed");
+  expect(!checkFacePair(c, i, 0.5f, std::numeric_limits<float>::quiet_NaN()).same_place,
+         "max_size_ratio NaN: fails closed");
+  expect(!checkFacePair(FrameBox{}, i, 0.5f, 1.5f).same_place, "an empty box: never the same face");
+  expect(checkFacePair(FrameBox{}, i, 0.0f, 1.5f).same_place, "an empty box with no check: ok");
+
+  if (g_failures != 0) {
+    std::printf("%d FAILED\n", g_failures);
+    return 1;
+  }
+  std::printf("ALL PASS\n");
+  return 0;
+}
