+  {
+    FaceAuth face(both, kUser);
+    expect(face.recognitionThreshold(FaceAuth::FaceSet::Main) == 0.6f &&
+               face.recognitionThreshold(FaceAuth::FaceSet::Ir) == 0.6f,
+           "threshold: no ir_threshold -> the threshold on both cameras");
+  }
+  both.recognition.ir_threshold = 0.7f;
+  {
+    FaceAuth face(both, kUser);
+    expect(face.recognitionThreshold(FaceAuth::FaceSet::Main) == 0.6f &&
+               face.recognitionThreshold(FaceAuth::FaceSet::Ir) == 0.7f,
+           "threshold: both -> colour 0.6, IR 0.7");
+  }
+  biopass::FaceMethodConfig ir = both;
+  ir.camera = kIr;
+  ir.anti_spoofing.ir_recognition = false;
+  {
+    FaceAuth face(ir, kUser);
+    expect(face.recognitionThreshold(FaceAuth::FaceSet::Main) == 0.7f,
+           "threshold: IR as the main camera -> the IR camera's");
+  }
+}
