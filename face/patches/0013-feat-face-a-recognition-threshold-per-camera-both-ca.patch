+// A photo on a phone held next to the face: the colour camera recognises the
+// photo, the IR camera the real face beside it. Two faces, not one: the
+// attempt fails like a spoof (a false face), and never reaches the IR match.
+void checkTwoFacesFail() {
+  Rig rig;
+  rig.seen[kIrWidth] = {Seen::Beside};
+  FaceAuth face(bothConfig(), kUser, opener(rig), seams(rig));
+  face.beginAuthenticationSession();
+  const AuthResult result = face.authenticate(kUser, biopass::AuthConfig{});
+  expect(result == AuthResult::Failure, "two faces: failure (counts as a false face)");
+  expect(joined(rig.matched_sets) == "rgb", "two faces: the IR face is not matched");
+  face.endAuthenticationSession();
+
+  // The same with the check off (pair_max_offset 0).
+  Rig off;
+  off.seen[kIrWidth] = {Seen::Beside};
+  biopass::FaceMethodConfig config = bothConfig();
+  config.anti_spoofing.pair_max_offset = 0.0f;
+  FaceAuth unchecked(config, kUser, opener(off), seams(off));
+  unchecked.beginAuthenticationSession();
+  expect(unchecked.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Success,
+         "two faces, check off: success");
+  unchecked.endAuthenticationSession();
+}
