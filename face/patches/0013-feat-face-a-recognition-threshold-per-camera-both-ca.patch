+      "most {:.2f}, {:.2f})",
+      pair.dx, pair.dy, pair.size_ratio, anti.pair_max_offset, anti.pair_max_size_ratio);
   if (second == Camera::Main && !aiAntiSpoofPasses(username, *second_seen, config, cancel_signal)) {
     spdlog::warn("FaceAuth: Anti-spoofing failed on the {} — returning Failure", name(second));
     second_slot.reset();
@@ -511,7 +542,8 @@ bool FaceAuth::matchFace(const std::string& username, const ImageRGB& face, Face
