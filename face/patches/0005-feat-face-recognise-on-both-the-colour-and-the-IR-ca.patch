+// Both cameras stream only one at a time (see irPresenceSession), so the
+// attempt is sequential: the camera that is open captures first (the last
+// attempt's second camera stays open, so a face it sees needs one switch,
+// not two); once a face is found there, that camera closes and the other
+// opens while the first face is matched; a match there too, on a frame at
+// most kBothCamerasMaxGap after the first, is a success. Nothing falls back
+// to one camera: a camera that sees no face (no light for the colour camera,
+// a covered lens) fails the attempt.
+AuthResult FaceAuth::attemptBothCameras(const std::string& username, const AuthConfig& config,
+                                        std::atomic<bool>* cancel_signal) {
+  const auto& ir_camera = face_config_.anti_spoofing.ir_camera;
+  if (!ir_camera || ir_camera->empty()) {
+    spdlog::error("FaceAuth: ir_recognition is on but no IR camera is set, face is refused");
+    return AuthResult::Unavailable;
+  }
+  const std::vector<std::string> main_faces = enrolledFaces(username, FaceSet::Main);
+  const std::vector<std::string> ir_faces = enrolledFaces(username, FaceSet::Ir);
+  if (main_faces.empty() || ir_faces.empty()) {
+    spdlog::error(
+        "FaceAuth: Both cameras must recognise user {}: {} face(s) enrolled for the colour camera "
+        "(faces/), {} for the IR camera (faces-ir/), skipping",
+        username, main_faces.size(), ir_faces.size());
+    return AuthResult::Unavailable;
+  }
+
+  if (!ensureModelsLoaded()) {
+    spdlog::error("FaceAuth: Models not available for user {}, skipping", username);
+    return AuthResult::Unavailable;
+  }
+
+  cancel_signal_ = cancel_signal;
+  if (cancel_signal && cancel_signal->load()) {
+    return AuthResult::Failure;
+  }
+
+  const Camera first =
+      ir_camera_session_ && ir_camera_session_->isOpen() ? Camera::Ir : Camera::Main;
+  const Camera second = first == Camera::Ir ? Camera::Main : Camera::Ir;
+  const auto name = [](Camera which) { return cameraName(true, which == Camera::Ir); };
+  const auto setOf = [](Camera which) {
+    return which == Camera::Ir ? FaceSet::Ir : FaceSet::Main;
+  };
+  const auto facesOf = [&](Camera which) -> const std::vector<std::string>& {
+    return which == Camera::Ir ? ir_faces : main_faces;
+  };
+
+  std::unique_ptr<ICameraCaptureSession>& first_slot = sessionSlot(first);
+  if (!first_slot || !first_slot->isOpen()) {
+    // Only the main camera gets here (the IR camera is first only when open).
+    // Never two sessions at once: free both before opening.
+    ir_camera_session_.reset();
+    camera_session_.reset();
+    first_slot = openSession(first);
+    if (!first_slot || !first_slot->isOpen()) {
+      spdlog::error("FaceAuth: Could not open the {}", name(first));
+      first_slot.reset();
+      return AuthResult::Retry;
+    }
+  }
+
+  if (!scan_announced_) {
+    scan_announced_ = true;
+    reportInfo("Biopass: looking for your face...");
+  }
+
+  const std::optional<Sighting> first_seen = lookForFace(first_slot, name(first));
+  if (!first_seen) {
+    return AuthResult::Retry;
+  }
+  if (cancel_signal && cancel_signal->load()) {
+    return AuthResult::Failure;
+  }
+
+  // Switch cameras now: the other one opens on its own thread while this one
+  // checks the first face. openSession() touches no member but the opener;
+  // the session is stored here once it is open.
+  first_slot.reset();
+  std::future<std::unique_ptr<ICameraCaptureSession>> opening =
+      std::async(std::launch::async, [this, second] { return openSession(second); });
+  const bool first_spoof =
+      first == Camera::Main && !aiAntiSpoofPasses(username, *first_seen, config, cancel_signal);
+  const bool first_match = !first_spoof && matchFace(username, first_seen->face.image,
+                                                     setOf(first), facesOf(first));
+  std::unique_ptr<ICameraCaptureSession>& second_slot = sessionSlot(second);
+  second_slot = opening.get();
+
+  if (first_spoof) {
+    spdlog::warn("FaceAuth: Anti-spoofing failed on the {} — returning Failure", name(first));
+    second_slot.reset();
+    return AuthResult::Failure;
+  }
+  if (!first_match) {
+    if (config.debug) {
+      saveFailedFace(username, first_seen->face.image, "not_similar");
+    }
+    // The other camera is open now: the next attempt starts there.
+    return AuthResult::Retry;
+  }
+  if (cancel_signal && cancel_signal->load()) {
+    return AuthResult::Failure;
+  }
+  if (!second_slot || !second_slot->isOpen()) {
+    spdlog::error("FaceAuth: Could not open the {}", name(second));
+    second_slot.reset();
+    return AuthResult::Retry;
+  }
+
+  const std::optional<Sighting> second_seen = lookForFace(second_slot, name(second));
+  if (!second_seen) {
+    return AuthResult::Retry;
+  }
+  const auto gap = second_seen->at - first_seen->at;
+  const long long gap_ms = std::chrono::duration_cast<std::chrono::milliseconds>(gap).count();
+  if (gap > kBothCamerasMaxGap) {
+    spdlog::error("FaceAuth: The {} frame came {} ms after the {} frame (at most {} ms), not "
+                  "one moment",
+                  name(second), gap_ms, name(first), kBothCamerasMaxGap.count());
+    return AuthResult::Retry;
+  }
+  if (cancel_signal && cancel_signal->load()) {
+    return AuthResult::Failure;
+  }
+  if (second == Camera::Main && !aiAntiSpoofPasses(username, *second_seen, config, cancel_signal)) {
+    spdlog::warn("FaceAuth: Anti-spoofing failed on the {} — returning Failure", name(second));
+    second_slot.reset();
+    return AuthResult::Failure;
+  }
+  if (!matchFace(username, second_seen->face.image, setOf(second), facesOf(second))) {
+    if (config.debug) {
+      saveFailedFace(username, second_seen->face.image, "not_similar");
+    }
+    return AuthResult::Retry;
+  }
+  spdlog::debug("FaceAuth: Recognised on both cameras, {} ms apart", gap_ms);
+  return AuthResult::Success;
+}
+
+std::optional<FaceAuth::Sighting> FaceAuth::lookForFace(
+    std::unique_ptr<ICameraCaptureSession>& slot, const char* camera_name) {
+  ImageRGB frame = slot->capture();
+  const auto at = now();
+  if (frame.empty()) {
+    spdlog::error("FaceAuth: Could not read frame from the {}", camera_name);
+    slot.reset();
+    return std::nullopt;
+  }
+  frames_captured_++;
+
+  std::vector<Detection> faces = seams_.detect ? seams_.detect(frame) : detector_->inference(frame);
+  if (faces.empty()) {
+    // Detection always runs first, so the darkness check can only change the
+    // failure message, never reject a frame that has a usable face.
+    const LumaStats luma = measureLuma(frame);
+    if (looksCovered(luma)) {
+      covered_frames_++;
+    }
+    spdlog::error("FaceAuth: No face detected on the {} | luma mean={:.1f} stddev={:.1f}",
+                  camera_name, luma.mean, luma.stddev);
+    return std::nullopt;
+  }
+
+  // Detections come largest first.
+  const Box& box = faces[0].box;
+  const float min_height = face_config_.detection.min_face_height;
+  const FaceFraming framing =
+      checkFaceFraming(box.x1, box.y1, box.x2, box.y2, frame.width, frame.height, min_height);
+  spdlog::debug(
+      "FaceAuth: Face on the {} | {}x{} px at ({},{}) in {}x{}, height {:.2f} of the frame (min "
+      "{:.2f}), conf {:.2f}: {}",
+      camera_name, box.x2 - box.x1, box.y2 - box.y1, box.x1, box.y1, frame.width, frame.height,
+      faceHeightFraction(box.y1, box.y2, frame.height), min_height, faces[0].conf,
+      faceFramingName(framing));
+  if (framing != FaceFraming::Ok) {
+    spdlog::error("FaceAuth: Face on the {} {}: not in front of the camera", camera_name,
+                  faceFramingName(framing));
+    return std::nullopt;
+  }
+  return Sighting{std::move(frame), faces[0], at};
+}
+
+std::vector<std::string> FaceAuth::enrolledFaces(const std::string& username, FaceSet set) const {
+  if (seams_.enrolled) {
+    return seams_.enrolled(set);
+  }
+  return set == FaceSet::Ir ? listIrFaces(username) : listFaces(username);
+}
+
+bool FaceAuth::matchFace(const std::string& username, const ImageRGB& face, FaceSet set,
+                         const std::vector<std::string>& enrolled_paths) {
+  if (seams_.match) {
+    return seams_.match(face, set, enrolled_paths);
+  }
+  return matchAgainstEnrolled(username, face, enrolled_paths,
+                              cameraName(bothCameras(), set == FaceSet::Ir));
+}
