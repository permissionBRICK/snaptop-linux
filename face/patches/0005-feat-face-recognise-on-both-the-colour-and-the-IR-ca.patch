diff --git a/auth/test/face_both_cameras/main.cpp b/auth/test/face_both_cameras/main.cpp
new file mode 100644
index 0000000..388d0ce
--- /dev/null
+++ b/auth/test/face_both_cameras/main.cpp
@@ -0,0 +1,373 @@
+// FaceAuth with anti_spoofing.ir_recognition (face/face_auth.h): the face
+// must be recognised on both the main (colour) camera and the IR camera,
+// each against its own enrolled faces, on frames at most kBothCamerasMaxGap
+// apart. Only one camera streams at a time: an attempt starts on the camera
+// that is open, switches once a face is found there, and leaves the other
+// camera open for the next attempt. Nothing falls back to one camera. And
+// detection.min_face_height: a face that is too small or cut off is never
+// matched, on either camera.
+// Fake cameras, detector, matcher and clock: no camera or model needed.
+// Exits non-zero on any failure.
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <deque>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "camera_capture.h"
+#include "face_auth.h"
+
+namespace {
+
+using biopass::AuthResult;
+using biopass::FaceAuth;
+using Clock = std::chrono::steady_clock;
+using std::chrono::milliseconds;
+
+int g_failures = 0;
+
+void expect(bool cond, const std::string& what) {
+  std::printf("[%s] %s\n", cond ? "PASS" : "FAIL", what.c_str());
+  if (!cond) {
+    g_failures++;
+  }
+}
+
+constexpr const char* kUser = "biopass-no-such-user";
+constexpr const char* kRgb = "/dev/fake-rgb";
+constexpr const char* kIr = "/dev/fake-ir";
+// Frame sizes tell the fakes which camera a frame came from.
+constexpr int kRgbWidth = 640;
+constexpr int kIrWidth = 560;
+constexpr int kHeight = 360;
+
+// What the fake detector finds in the next frame of a camera.
+enum class Seen { Face, NoFace, Small, Edge };
+
+struct Rig {
+  // Camera opens and sessions, as in test/face_camera_reuse.
+  std::vector<std::string> opens;
+  int live = 0;
+  int max_live_at_open = 0;
+  std::map<std::string, int> fail_opens;  // path -> opens left to fail
+  // Per camera: what each next frame shows (default: a face), and how long a
+  // capture takes on the fake clock.
+  std::map<int, std::deque<Seen>> seen;
+  std::map<int, milliseconds> capture_time{{kRgbWidth, milliseconds(100)},
+                                           {kIrWidth, milliseconds(100)}};
+  // Per face set: the next match results (default: match).
+  std::map<FaceAuth::FaceSet, std::deque<bool>> matches;
+  std::vector<std::string> matched_sets;  // "rgb" / "ir", in order
+  std::map<FaceAuth::FaceSet, std::vector<std::string>> enrolled{
+      {FaceAuth::FaceSet::Main, {"faces/a.jpg"}}, {FaceAuth::FaceSet::Ir, {"faces-ir/a.jpg"}}};
+  Clock::time_point now{};
+};
+
+class FakeSession : public biopass::ICameraCaptureSession {
+ public:
+  FakeSession(Rig& rig, int width) : rig_(rig), width_(width) { rig_.live++; }
+  ~FakeSession() override { rig_.live--; }
+  bool isOpen() const override { return true; }
+  ImageRGB capture() override {
+    rig_.now += rig_.capture_time[width_];
+    return ImageRGB(width_, kHeight);
+  }
+
+ private:
+  Rig& rig_;
+  int width_;
+};
+
+FaceAuth::CameraOpener opener(Rig& rig) {
+  return [&rig](const std::optional<std::string>& path, biopass::CameraCaptureFormat, int,
+                int) -> std::unique_ptr<biopass::ICameraCaptureSession> {
+    const std::string p = path.value_or("<default>");
+    rig.opens.push_back(p == kIr ? "ir" : "rgb");
+    rig.max_live_at_open = std::max(rig.max_live_at_open, rig.live);
+    if (rig.fail_opens[p] > 0) {
+      rig.fail_opens[p]--;
+      return nullptr;
+    }
+    return std::make_unique<FakeSession>(rig, p == kIr ? kIrWidth : kRgbWidth);
+  };
+}
+
+FaceAuth::Seams seams(Rig& rig) {
+  FaceAuth::Seams s;
+  s.enrolled = [&rig](FaceAuth::FaceSet set) { return rig.enrolled[set]; };
+  s.detect = [&rig](const ImageRGB& frame) -> std::vector<biopass::Detection> {
+    auto& queue = rig.seen[frame.width];
+    Seen what = Seen::Face;
+    if (!queue.empty()) {
+      what = queue.front();
+      queue.pop_front();
+    }
+    biopass::Box box(100, 60, 260, 260);  // 200 of 360 rows, inside the frame
+    if (what == Seen::NoFace) {
+      return {};
+    }
+    if (what == Seen::Small) {
+      box = biopass::Box(300, 150, 340, 200);  // 50 rows: across the room
+    } else if (what == Seen::Edge) {
+      box = biopass::Box(0, 60, 160, 260);  // touches the left edge
+    }
+    return {biopass::Detection(0, "face", 0.9f, box, frame.crop(box.x1, box.y1, box.x2, box.y2))};
+  };
+  s.match = [&rig](const ImageRGB&, FaceAuth::FaceSet set, const std::vector<std::string>&) {
+    rig.matched_sets.push_back(set == FaceAuth::FaceSet::Ir ? "ir" : "rgb");
+    auto& queue = rig.matches[set];
+    if (queue.empty()) {
+      return true;
+    }
+    const bool result = queue.front();
+    queue.pop_front();
+    return result;
+  };
+  s.now = [&rig] { return rig.now; };
+  return s;
+}
+
+biopass::FaceMethodConfig bothConfig() {
+  biopass::FaceMethodConfig config;
+  config.camera = kRgb;
+  config.anti_spoofing.ir_camera = kIr;
+  config.anti_spoofing.ir_recognition = true;
+  config.detection.min_face_height = 0.3f;
+  return config;
+}
+
+std::string joined(const std::vector<std::string>& v) {
+  std::string out;
+  for (const auto& s : v) {
+    out += (out.empty() ? "" : ",") + s;
+  }
+  return out;
+}
+
+// The face on both cameras: colour first (opened by the availability check),
+// then the IR camera, which opens while the colour face is matched.
+void checkBothMatch() {
+  Rig rig;
+  FaceAuth face(bothConfig(), kUser, opener(rig), seams(rig));
+  expect(face.bothCameras(), "both: ir_recognition with a separate IR camera");
+  expect(face.isAvailable(), "both: available");
+  face.beginAuthenticationSession();
+  const AuthResult result = face.authenticate(kUser, biopass::AuthConfig{});
+  expect(result == AuthResult::Success, "both match: success");
+  expect(joined(rig.opens) == "rgb,ir", "both match: colour, then IR (" + joined(rig.opens) + ")");
+  expect(joined(rig.matched_sets) == "rgb,ir",
+         "both match: colour face against faces/, IR face against faces-ir/");
+  expect(rig.max_live_at_open == 0, "both match: never two sessions at once");
+  face.endAuthenticationSession();
+  expect(rig.live == 0, "both match: session end closes the camera");
+}
+
+// Too little light for the colour camera (or its lens covered): no face
+// there, so the IR camera never decides alone.
+void checkNoFallbackToIr() {
+  Rig rig;
+  rig.seen[kRgbWidth] = {Seen::NoFace, Seen::NoFace, Seen::NoFace};
+  FaceAuth face(bothConfig(), kUser, opener(rig), seams(rig));
+  face.isAvailable();
+  for (int i = 0; i < 3; ++i) {
+    expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Retry,
+           "no colour face: attempt " + std::to_string(i + 1) + " retries");
+  }
+  expect(joined(rig.opens) == "rgb", "no colour face: the IR camera is never opened (" +
+                                         joined(rig.opens) + ")");
+  expect(rig.matched_sets.empty(), "no colour face: nothing is matched");
+}
+
+// A face across the room or at the frame's edge is not matched.
+void checkFraming() {
+  Rig rig;
+  rig.seen[kRgbWidth] = {Seen::Small, Seen::Edge};
+  FaceAuth face(bothConfig(), kUser, opener(rig), seams(rig));
+  face.isAvailable();
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Retry,
+         "small colour face: retry");
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Retry,
+         "colour face at the edge: retry");
+  expect(rig.matched_sets.empty() && joined(rig.opens) == "rgb",
+         "small or cut-off colour face: neither matched nor switched");
+
+  // The same on the IR camera: matched on colour, too small in IR.
+  Rig rig2;
+  rig2.seen[kIrWidth] = {Seen::Small};
+  FaceAuth face2(bothConfig(), kUser, opener(rig2), seams(rig2));
+  face2.isAvailable();
+  expect(face2.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Retry,
+         "small IR face: retry");
+  expect(joined(rig2.matched_sets) == "rgb", "small IR face: not matched");
+}
+
+// Colour matches, IR doesn't: the IR camera stays open, the next attempt
+// starts there and switches back to colour.
+void checkStartsOnOpenCamera() {
+  Rig rig;
+  rig.matches[FaceAuth::FaceSet::Ir] = {false};
+  FaceAuth face(bothConfig(), kUser, opener(rig), seams(rig));
+  face.isAvailable();
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Retry,
+         "IR not recognised: retry");
+  expect(rig.live == 1 && joined(rig.opens) == "rgb,ir", "IR not recognised: the IR camera stays open");
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Success,
+         "next attempt: success");
+  expect(joined(rig.opens) == "rgb,ir,rgb",
+         "next attempt: starts on the open IR camera, one switch to colour (" +
+             joined(rig.opens) + ")");
+  expect(joined(rig.matched_sets) == "rgb,ir,ir,rgb",
+         "next attempt: IR matched first, then colour (" + joined(rig.matched_sets) + ")");
+  expect(rig.max_live_at_open == 0, "starts on open camera: never two sessions at once");
+}
+
+// The first camera doesn't recognise: the other one is open anyway (it was
+// opened while matching), and the next attempt starts there.
+void checkFirstNotRecognised() {
+  Rig rig;
+  rig.matches[FaceAuth::FaceSet::Main] = {false};
+  FaceAuth face(bothConfig(), kUser, opener(rig), seams(rig));
+  face.isAvailable();
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Retry,
+         "colour not recognised: retry");
+  expect(joined(rig.matched_sets) == "rgb", "colour not recognised: IR not matched in that attempt");
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Success,
+         "next attempt, from the IR camera: success");
+  expect(joined(rig.opens) == "rgb,ir,rgb", "colour not recognised: then IR, then colour (" +
+                                                joined(rig.opens) + ")");
+}
+
+// Two frames too far apart are not one moment.
+void checkGap() {
+  Rig rig;
+  rig.capture_time[kIrWidth] = biopass::kBothCamerasMaxGap + milliseconds(1);
+  FaceAuth face(bothConfig(), kUser, opener(rig), seams(rig));
+  face.isAvailable();
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Retry,
+         "IR frame after the gap: retry although both would match");
+  expect(joined(rig.matched_sets) == "rgb", "IR frame after the gap: not matched");
+
+  Rig rig2;
+  rig2.capture_time[kIrWidth] = biopass::kBothCamerasMaxGap;
+  FaceAuth face2(bothConfig(), kUser, opener(rig2), seams(rig2));
+  face2.isAvailable();
+  expect(face2.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Success,
+         "IR frame exactly at the gap: success");
+}
+
+// Faces must be enrolled for both cameras.
+void checkEnrolment() {
+  Rig rig;
+  rig.enrolled[FaceAuth::FaceSet::Ir].clear();
+  FaceAuth face(bothConfig(), kUser, opener(rig), seams(rig));
+  face.isAvailable();
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Unavailable,
+         "no IR faces enrolled: unavailable");
+  expect(rig.matched_sets.empty(), "no IR faces enrolled: nothing matched");
+
+  Rig rig2;
+  rig2.enrolled[FaceAuth::FaceSet::Main].clear();
+  FaceAuth face2(bothConfig(), kUser, opener(rig2), seams(rig2));
+  face2.isAvailable();
+  expect(face2.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Unavailable,
+         "no colour faces enrolled: unavailable");
+}
+
+// ir_recognition without an IR camera fails closed; with the IR camera as
+// the main camera it recognises already (one camera, faces/), and off it is
+// the IR presence check as before.
+void checkConfigs() {
+  Rig rig;
+  biopass::FaceMethodConfig no_ir = bothConfig();
+  no_ir.anti_spoofing.ir_camera.reset();
+  FaceAuth face(no_ir, kUser, opener(rig), seams(rig));
+  face.isAvailable();
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Unavailable,
+         "ir_recognition without an IR camera: unavailable");
+  expect(rig.matched_sets.empty(), "ir_recognition without an IR camera: nothing matched");
+
+  biopass::FaceMethodConfig ir_main = bothConfig();
+  ir_main.camera = kIr;
+  FaceAuth face2(ir_main, kUser, opener(rig), seams(rig));
+  expect(!face2.bothCameras(), "IR camera as the main camera: one camera, faces/");
+
+  Rig rig3;
+  biopass::FaceMethodConfig off = bothConfig();
+  off.anti_spoofing.ir_recognition = false;
+  FaceAuth face3(off, kUser, opener(rig3), seams(rig3));
+  expect(!face3.bothCameras(), "ir_recognition off: one camera (with the IR presence check)");
+}
+
+// One camera: min_face_height applies there too. (No IR camera set: the
+// IR presence check would need the real detector.)
+void checkSingleCameraFraming() {
+  Rig rig;
+  rig.seen[kRgbWidth] = {Seen::Small, Seen::Edge, Seen::Face};
+  biopass::FaceMethodConfig one = bothConfig();
+  one.anti_spoofing.ir_camera.reset();
+  one.anti_spoofing.ir_recognition = false;
+  FaceAuth face(one, kUser, opener(rig), seams(rig));
+  face.isAvailable();
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Retry,
+         "one camera, small face: retry");
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Retry,
+         "one camera, face at the edge: retry");
+  expect(rig.matched_sets.empty(), "one camera: small or cut-off faces not matched");
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Success,
+         "one camera, face in front: success");
+  expect(joined(rig.opens) == "rgb", "one camera: opened once");
+}
+
+// The second camera does not open: retry, and the next attempt opens the
+// colour camera again (nothing is left open).
+void checkSecondOpenFails() {
+  Rig rig;
+  rig.fail_opens[kIr] = 1;
+  FaceAuth face(bothConfig(), kUser, opener(rig), seams(rig));
+  face.isAvailable();
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Retry,
+         "IR camera does not open: retry");
+  expect(rig.live == 0, "IR camera does not open: no session left");
+  expect(face.authenticate(kUser, biopass::AuthConfig{}) == AuthResult::Success,
+         "next attempt: success");
+  expect(joined(rig.opens) == "rgb,ir,rgb,ir", "IR camera does not open: colour opened again (" +
+                                                   joined(rig.opens) + ")");
+  expect(rig.max_live_at_open == 0, "IR camera does not open: never two sessions at once");
+}
+
+// A cancelled run (another method won, or the time budget is spent) does not
+// switch cameras or match.
+void checkCancel() {
+  Rig rig;
+  std::atomic<bool> cancel{true};
+  FaceAuth face(bothConfig(), kUser, opener(rig), seams(rig));
+  face.isAvailable();
+  expect(face.authenticate(kUser, biopass::AuthConfig{}, &cancel) == AuthResult::Failure,
+         "cancelled: failure");
+  expect(rig.matched_sets.empty() && joined(rig.opens) == "rgb", "cancelled: nothing matched");
+}
+
+}  // namespace
+
+int main() {
+  checkBothMatch();
+  checkNoFallbackToIr();
+  checkFraming();
+  checkStartsOnOpenCamera();
+  checkFirstNotRecognised();
+  checkGap();
+  checkEnrolment();
+  checkConfigs();
+  checkSingleCameraFraming();
+  checkSecondOpenFails();
+  checkCancel();
+
+  std::printf("%s\n", g_failures == 0 ? "All checks passed" : "Some checks FAILED");
+  return g_failures == 0 ? 0 : 1;
+}
