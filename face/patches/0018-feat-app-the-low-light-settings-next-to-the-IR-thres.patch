+    #[test]
+    fn light_on_the_colour_camera() {
+        let low = "\
+[2026-11-16 20:00:01.100] [biopass] [debug] FaceAuth: Enough light on the colour camera | face luma 86 (low light below 70)
+[2026-11-16 20:00:02.100] [biopass] [debug] FaceAuth: Low light on the colour camera | face luma 48 < 70: the IR camera decides alone (threshold 0.70)
+[2026-11-16 20:00:02.900] [biopass] [debug] FaceAuth: Recognition on the IR camera | threshold=0.700 enrolled_count=5
+[2026-11-16 20:00:03.000] [biopass] [debug] FaceAuth: Recognition PASSED on the IR camera | matched face='/h/faces-ir/a.jpg' score=0.8012
+[2026-11-16 20:00:03.010] [biopass] [debug] FaceAuth: Recognised on the IR camera alone (low light), above 0.70
+";
+        let d = details_from_log(low);
+        assert_eq!(
+            d.light,
+            Some(LightResult {
+                luma: 48.0,
+                face: true,
+                limit: Some(70.0),
+                low: true,
+                ir_alone_threshold: Some(0.7)
+            })
+        );
+        assert_eq!(
+            d.cameras,
+            vec![CameraResult {
+                camera: "IR camera".into(),
+                best: 0.8012,
+                threshold: Some(0.7),
+                matched: true
+            }]
+        );
+        assert_eq!(
+            steps_from_log(low),
+            vec![
+                "20:00:01.100 Enough light on the colour camera | face luma 86 (low light below 70)",
+                "20:00:02.100 Low light on the colour camera | face luma 48 < 70: the IR camera decides alone (threshold 0.70)",
+                "20:00:03.000 Recognition PASSED on the IR camera | matched faces-ir/a.jpg score=0.8012",
+                "20:00:03.010 Recognised on the IR camera alone (low light), above 0.70",
+            ]
+        );
+
+        let dark = "[2026-11-16 20:00:02.100] [biopass] [debug] FaceAuth: Low light on the colour camera | no face, picture luma 5 < 70: the IR camera decides alone (threshold 0.75)\n";
+        let light = details_from_log(dark).light.unwrap();
+        assert!(!light.face && light.luma == 5.0 && light.ir_alone_threshold == Some(0.75));
+
+        let no_ir = "[2026-11-16 20:00:02.100] [biopass] [debug] FaceAuth: Low light on the colour camera | face luma 48 < 70, but no faces are enrolled for the IR camera (faces-ir/): the colour camera decides\n";
+        let light = details_from_log(no_ir).light.unwrap();
+        assert!(
+            light.low
+                && light.face
+                && light.limit == Some(70.0)
+                && light.ir_alone_threshold.is_none()
+        );
+
+        let bright = "[2026-11-16 20:00:01.100] [biopass] [debug] FaceAuth: Enough light on the colour camera | face luma 86 (low light below 70)\n";
+        assert_eq!(
+            details_from_log(bright).light,
+            Some(LightResult {
+                luma: 86.0,
+                face: true,
+                limit: Some(70.0),
+                low: false,
+                ir_alone_threshold: None
+            })
+        );
+    }
