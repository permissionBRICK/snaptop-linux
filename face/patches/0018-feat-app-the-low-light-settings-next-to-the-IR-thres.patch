+/// The number in `text` right after `before` ("luma 48 < 70": "luma " -> 48).
+fn number_after(text: &str, before: &str) -> Option<f64> {
+    text.split(before)
+        .nth(1)?
+        .split_whitespace()
+        .next()?
+        .trim_end_matches([',', ')', ':'])
+        .parse::<f64>()
+        .ok()
+        .filter(|v| v.is_finite())
+}
+
+/// "Low light on the colour camera | face luma 48 < 70: the IR camera decides
+/// alone (threshold 0.70)", "... | no face, picture luma 5 < 70: ...",
+/// "Enough light on the colour camera | face luma 86 (low light below 70)".
+fn light_from(rest: &str, low: bool) -> Option<LightResult> {
+    let luma = number_after(rest, "luma ")?;
+    Some(LightResult {
+        luma,
+        face: !rest.starts_with("no face"),
+        limit: number_after(rest, "< ").or_else(|| number_after(rest, "below ")),
+        low,
+        ir_alone_threshold: if rest.contains("the IR camera decides alone") {
+            number_after(rest, "(threshold ")
+        } else {
+            None
+        },
+    })
+}
