+bool unpackRawMono(const uint8_t* src, size_t size, int width, int height, int stride,
+                   int bit_depth, RawMonoPacking packing, std::vector<uint16_t>& out) {
+  out.clear();
+  if (!src || (bit_depth != 10 && bit_depth != 12) || ImageRGB::byteSize(width, height) == 0) {
+    return false;
+  }
+  const size_t w = static_cast<size_t>(width);
+  size_t row_bytes = 0;
+  if (packing == RawMonoPacking::kLe16) {
+    row_bytes = w * 2;
+  } else if (bit_depth == 10) {
+    row_bytes = (w + 3) / 4 * 5;
+  } else {
+    row_bytes = (w + 1) / 2 * 3;
+  }
+  const size_t row_stride = std::max(static_cast<size_t>(std::max(stride, 0)), row_bytes);
+  if (size < row_stride * static_cast<size_t>(height - 1) + row_bytes) {
+    return false;
+  }
+
+  const uint16_t max_value = static_cast<uint16_t>((1u << bit_depth) - 1);
+  out.resize(w * static_cast<size_t>(height));
+  for (int y = 0; y < height; ++y) {
+    const uint8_t* row = src + static_cast<size_t>(y) * row_stride;
+    uint16_t* dst = out.data() + static_cast<size_t>(y) * w;
+    for (size_t x = 0; x < w; ++x) {
+      if (packing == RawMonoPacking::kLe16) {
+        dst[x] = std::min<uint16_t>(static_cast<uint16_t>(row[x * 2] | (row[x * 2 + 1] << 8)),
+                                    max_value);
+      } else if (bit_depth == 10) {
+        // Bytes 0-3: the high 8 bits of pixels 0-3; byte 4: their low 2 bits.
+        const uint8_t* group = row + x / 4 * 5;
+        const unsigned shift = static_cast<unsigned>(x % 4) * 2;
+        dst[x] = static_cast<uint16_t>((group[x % 4] << 2) | ((group[4] >> shift) & 0x3));
+      } else {
+        // Bytes 0-1: the high 8 bits of pixels 0-1; byte 2: their low 4 bits.
+        const uint8_t* group = row + x / 2 * 3;
+        const unsigned shift = static_cast<unsigned>(x % 2) * 4;
+        dst[x] = static_cast<uint16_t>((group[x % 2] << 4) | ((group[2] >> shift) & 0xF));
+      }
+    }
+  }
+  return true;
+}
+
+bool monoToRgb(const std::vector<uint16_t>& pixels, int width, int height, int black, int white,
+               ImageRGB& out) {
+  const size_t count =
+      static_cast<size_t>(std::max(width, 0)) * static_cast<size_t>(std::max(height, 0));
+  if (ImageRGB::byteSize(width, height) == 0 || pixels.size() < count) {
+    return false;
+  }
+  const int span = std::max(1, white - black);
+  out = ImageRGB(width, height);
+  uint8_t* dst = out.ptr();
+  for (size_t i = 0; i < count; ++i) {
+    const uint8_t v = clamp_u8(((static_cast<int>(pixels[i]) - black) * 255 + span / 2) / span);
+    dst[i * 3 + 0] = v;
+    dst[i * 3 + 1] = v;
+    dst[i * 3 + 2] = v;
+  }
+  return true;
+}
+
+ImageRGB transformImage(const ImageRGB& in, bool hflip, bool vflip, bool transpose) {
+  if (in.empty() || (!hflip && !vflip && !transpose)) {
+    return in.clone();
+  }
+  const int out_w = transpose ? in.height : in.width;
+  const int out_h = transpose ? in.width : in.height;
+  ImageRGB out(out_w, out_h);
+  for (int y = 0; y < out_h; ++y) {
+    for (int x = 0; x < out_w; ++x) {
+      // The flipped image's (fx, fy) lands at (x, y), transposed or not.
+      const int fx = transpose ? y : x;
+      const int fy = transpose ? x : y;
+      const int sx = hflip ? in.width - 1 - fx : fx;
+      const int sy = vflip ? in.height - 1 - fy : fy;
+      std::memcpy(&out.at(y, x, 0), &in.at(sy, sx, 0), 3);
+    }
+  }
+  return out;
+}
+
 }  // namespace biopass
