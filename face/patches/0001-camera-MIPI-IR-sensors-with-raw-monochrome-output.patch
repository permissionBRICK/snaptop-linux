+bool isRawMono(const libcamera::PixelFormat& format) { return rawMonoBitDepth(format) != 0; }
+
+int rawMonoBitDepth(const libcamera::PixelFormat& format) {
+  if (format == libcamera::formats::R10_CSI2P || format == libcamera::formats::R10) {
+    return 10;
+  }
+  if (format == libcamera::formats::R12_CSI2P || format == libcamera::formats::R12) {
+    return 12;
+  }
+  return 0;
+}
+
+bool isCsi2Packed(const libcamera::PixelFormat& format) {
+  return format == libcamera::formats::R10_CSI2P || format == libcamera::formats::R12_CSI2P;
+}
+
+MonoLevels monoLevels(const std::vector<uint32_t>& histogram, int bit_depth) {
+  MonoLevels levels;
+  const size_t bins = bit_depth > 0 && bit_depth <= 16 ? size_t{1} << bit_depth : 0;
+  if (bins == 0 || histogram.size() < bins) {
+    levels.dark = true;
+    return levels;
+  }
+  uint64_t total = 0;
+  double sum = 0.0;
+  for (size_t v = 0; v < bins; ++v) {
+    total += histogram[v];
+    sum += static_cast<double>(v) * histogram[v];
+  }
+  const int max_value = static_cast<int>(bins - 1);
+  if (total == 0) {
+    levels.dark = true;
+    levels.white = max_value;
+    return levels;
+  }
+  // Smallest value with more than `fraction` of the pixels at or below it.
+  const auto percentile = [&](double fraction) {
+    const double want = fraction * static_cast<double>(total);
+    uint64_t seen = 0;
+    for (size_t v = 0; v < bins; ++v) {
+      seen += histogram[v];
+      if (static_cast<double>(seen) > want) {
+        return static_cast<int>(v);
+      }
+    }
+    return max_value;
+  };
+  const int low = percentile(0.005);
+  const int high = percentile(0.995);
+  // The darkest pixels are the black level (a scene without any unlit area is
+  // rare in front of an IR emitter); capped so a bright scene keeps its shadows.
+  levels.black = std::min(low, (max_value + 1) / 16);
+  levels.white = std::min(max_value, std::max(high, levels.black + (max_value + 1) / 16));
+  levels.dark = high - levels.black < (max_value + 1) / 32;
+  const double mean = sum / static_cast<double>(total);
+  levels.signal = std::max(0.0, mean - levels.black) * 255.0 / (max_value - levels.black);
+  return levels;
+}
+
 }  // namespace biopass
