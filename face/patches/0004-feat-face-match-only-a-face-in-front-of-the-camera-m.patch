diff --git a/auth/test/face_framing/main.cpp b/auth/test/face_framing/main.cpp
new file mode 100644
index 0000000..b9f1673
--- /dev/null
+++ b/auth/test/face_framing/main.cpp
@@ -0,0 +1,102 @@
+// When a detected face counts as someone sitting in front of the camera
+// (face/common/face_framing.h): its box at least min_height of the frame
+// height, and not touching the frame's edge. min_height 0 checks nothing.
+// Pure, no camera or model needed. Exits non-zero on any failure.
+
+#include <cmath>
+#include <cstdio>
+#include <limits>
+#include <string_view>
+
+#include "face_framing.h"
+
+namespace {
+
+using biopass::checkFaceFraming;
+using biopass::FaceFraming;
+
+int g_failures = 0;
+
+void expect(bool cond, const char* what) {
+  std::printf("[%s] %s\n", cond ? "PASS" : "FAIL", what);
+  if (!cond) {
+    g_failures++;
+  }
+}
+
+// A 560x360 IR frame, as the HM1092 delivers it.
+constexpr int kW = 560;
+constexpr int kH = 360;
+
+void checkFraction() {
+  using biopass::faceHeightFraction;
+  expect(std::fabs(faceHeightFraction(90, 270, kH) - 0.5f) < 1e-6f, "180 of 360 rows: 0.5");
+  expect(faceHeightFraction(0, kH, kH) == 1.0f, "full height: 1");
+  expect(faceHeightFraction(10, 10, kH) == 0.0f, "empty box: 0");
+  expect(faceHeightFraction(20, 10, kH) == 0.0f, "inverted box: 0");
+  expect(faceHeightFraction(0, 10, 0) == 0.0f, "empty frame: 0");
+}
+
+void checkNoMinimum() {
+  expect(checkFaceFraming(270, 170, 290, 190, kW, kH, 0.0f) == FaceFraming::Ok,
+         "no minimum: a tiny face passes");
+  expect(checkFaceFraming(0, 0, 100, 120, kW, kH, 0.0f) == FaceFraming::Ok,
+         "no minimum: a face at the edge passes (edge checked only with a minimum)");
+  expect(checkFaceFraming(270, 170, 290, 190, kW, kH, -0.5f) == FaceFraming::Ok,
+         "negative minimum: no check");
+  expect(checkFaceFraming(270, 170, 290, 190, kW, kH, std::numeric_limits<float>::quiet_NaN()) ==
+             FaceFraming::Ok,
+         "NaN minimum: no check");
+}
+
+void checkSize() {
+  // 0.30 of 360 rows = 108 rows.
+  expect(checkFaceFraming(200, 100, 300, 208, kW, kH, 0.30f) == FaceFraming::Ok,
+         "108 of 360 rows, minimum 0.30: ok (the minimum itself passes)");
+  expect(checkFaceFraming(200, 100, 300, 207, kW, kH, 0.30f) == FaceFraming::TooSmall,
+         "107 of 360 rows, minimum 0.30: too small");
+  expect(checkFaceFraming(260, 160, 290, 196, kW, kH, 0.30f) == FaceFraming::TooSmall,
+         "a face across the room (36 rows): too small");
+  expect(checkFaceFraming(150, 40, 400, 330, kW, kH, 0.30f) == FaceFraming::Ok,
+         "a face filling most of the frame, inside it: ok");
+  expect(checkFaceFraming(0, 0, 0, 0, kW, kH, 0.30f) == FaceFraming::TooSmall,
+         "empty box with a minimum: too small");
+  expect(checkFaceFraming(200, 100, 300, 250, 0, 0, 0.30f) == FaceFraming::TooSmall,
+         "empty frame with a minimum: too small");
+}
+
+void checkEdges() {
+  expect(checkFaceFraming(1, 1, kW - 1, kH - 1, kW, kH, 0.30f) == FaceFraming::Ok,
+         "one pixel inside every edge: ok");
+  expect(checkFaceFraming(0, 100, 150, 250, kW, kH, 0.30f) == FaceFraming::CutOff,
+         "touching the left edge: cut off");
+  expect(checkFaceFraming(200, 0, 350, 150, kW, kH, 0.30f) == FaceFraming::CutOff,
+         "touching the top edge: cut off");
+  expect(checkFaceFraming(410, 100, kW, 250, kW, kH, 0.30f) == FaceFraming::CutOff,
+         "touching the right edge: cut off");
+  expect(checkFaceFraming(200, 210, 350, kH, kW, kH, 0.30f) == FaceFraming::CutOff,
+         "touching the bottom edge: cut off");
+  expect(checkFaceFraming(0, 340, 20, kH, kW, kH, 0.30f) == FaceFraming::TooSmall,
+         "small and at the edge: reported as too small");
+}
+
+void checkNames() {
+  expect(std::string_view(biopass::faceFramingName(FaceFraming::Ok)) == "ok", "name: ok");
+  expect(std::string_view(biopass::faceFramingName(FaceFraming::TooSmall)) == "too small",
+         "name: too small");
+  expect(std::string_view(biopass::faceFramingName(FaceFraming::CutOff)) == "cut off",
+         "name: cut off");
+}
+
+}  // namespace
+
+int main() {
+  checkFraction();
+  checkNoMinimum();
+  checkSize();
+  checkEdges();
+  checkNames();
+
+  std::printf("%s\n", g_failures == 0 ? "All checks passed" : "Some checks FAILED");
+  return g_failures == 0 ? 0 : 1;
+}
