diff --git a/auth/face/common/face_framing.cc b/auth/face/common/face_framing.cc
new file mode 100644
index 0000000..f4a21b3
--- /dev/null
+++ b/auth/face/common/face_framing.cc
@@ -0,0 +1,40 @@
+#include "face_framing.h"
+
+namespace biopass {
+
+float faceHeightFraction(int y1, int y2, int height) {
+  if (height <= 0 || y2 <= y1) {
+    return 0.0f;
+  }
+  return static_cast<float>(y2 - y1) / static_cast<float>(height);
+}
+
+FaceFraming checkFaceFraming(int x1, int y1, int x2, int y2, int width, int height,
+                             float min_height) {
+  // NaN fails the comparison too: no minimum.
+  if (!(min_height > 0.0f)) {
+    return FaceFraming::Ok;
+  }
+  if (width <= 0 || height <= 0 || x2 <= x1 || y2 <= y1 ||
+      faceHeightFraction(y1, y2, height) < min_height) {
+    return FaceFraming::TooSmall;
+  }
+  if (x1 <= 0 || y1 <= 0 || x2 >= width || y2 >= height) {
+    return FaceFraming::CutOff;
+  }
+  return FaceFraming::Ok;
+}
+
+const char* faceFramingName(FaceFraming framing) {
+  switch (framing) {
+    case FaceFraming::Ok:
+      return "ok";
+    case FaceFraming::TooSmall:
+      return "too small";
+    case FaceFraming::CutOff:
+      return "cut off";
+  }
+  return "?";
+}
+
+}  // namespace biopass
diff --git a/auth/face/common/face_framing.h b/auth/face/common/face_framing.h
new file mode 100644
index 0000000..bb364c7
--- /dev/null
+++ b/auth/face/common/face_framing.h
@@ -0,0 +1,30 @@
+#pragma once
+
+// Whether a detected face is framed as someone sitting in front of the
+// camera: tall enough and not cut off by the frame's edge. A face across the
+// room, or one barely in the frame, gives a small or partial crop whose
+// embedding says little about who it is. Pure, so it can be tested without a
+// camera or a model.
+
+namespace biopass {
+
+enum class FaceFraming {
+  Ok,
+  TooSmall,  // the face box is lower than min_height of the frame
+  CutOff,    // the face box touches the frame's edge: part of the face is outside
+};
+
+// The face box (x1, y1)-(x2, y2) in pixels, clamped to the width x height
+// frame as detection returns it. min_height: the box's minimum height as a
+// fraction of the frame height; 0 (or less, or NaN) checks nothing, neither
+// size nor edge. An empty frame or box is TooSmall when there is a minimum.
+FaceFraming checkFaceFraming(int x1, int y1, int x2, int y2, int width, int height,
+                             float min_height);
+
+// The box height as a fraction of the frame height; 0 for an empty frame.
+float faceHeightFraction(int y1, int y2, int height);
+
+// "ok", "too small" or "cut off", for logs.
+const char* faceFramingName(FaceFraming framing);
+
+}  // namespace biopass
