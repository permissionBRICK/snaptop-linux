From bf695b743bab056f327be8986e11b77f98e192fc Mon Sep 17 00:00:00 2001
From: justririll <justririll@users.noreply.github.com>
Date: Sun, 1 Nov 2026 13:36:52 +0000
Subject: [PATCH 6/7] arm64: dts: hamoa: add the platform.SS1 system idle state

ACPI _LPI of \_SB.SYSM lists platform.SS1 (EntryMethod 0x100), SS2 (0x200)
and DRIPS (0xc300). Windows keeps DRIPS vetoed while the screen is on and only
uses it in Modern Standby; add SS1 so runtime idle has a shallower system state
while DRIPS (domain_ss3) is marked system-sleep-only and used only in s2idle.

Source: https://github.com/justririll/x1e-sleep (sleep/dts-hamoa-add-ss1-idle-state.patch, commit 4e84b60)
---
 arch/arm64/boot/dts/qcom/hamoa.dtsi | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/hamoa.dtsi b/arch/arm64/boot/dts/qcom/hamoa.dtsi
index 8a96ea1bd..c6f704b1b 100644
--- a/arch/arm64/boot/dts/qcom/hamoa.dtsi
+++ b/arch/arm64/boot/dts/qcom/hamoa.dtsi
@@ -305,12 +305,23 @@ cluster_cl5: cluster-sleep-1 {
 				min-residency-us = <7000>;
 			};
 
+			/* ACPI \_SB.SYSM _LPI "platform.SS1": 7.5 ms residency, 0.5 ms latency */
+			domain_ss1: domain-sleep-1 {
+				compatible = "domain-idle-state";
+				arm,psci-suspend-param = <0x02000154>;
+				entry-latency-us = <250>;
+				exit-latency-us = <250>;
+				min-residency-us = <7500>;
+			};
+
 			domain_ss3: domain-sleep-0 {
 				compatible = "domain-idle-state";
 				arm,psci-suspend-param = <0x0200c354>;
 				entry-latency-us = <2500>;
 				exit-latency-us = <2500>;
 				min-residency-us = <9000>;
+				/* DRIPS from runtime idle hangs the SoC after the first s2idle */
+				system-sleep-only;
 			};
 		};
 	};
@@ -470,7 +481,7 @@ cluster_pd2: power-domain-cpu-cluster2 {
 
 		system_pd: power-domain-system {
 			#power-domain-cells = <0>;
-			domain-idle-states = <&domain_ss3>;
+			domain-idle-states = <&domain_ss1>, <&domain_ss3>;
 		};
 	};
 
