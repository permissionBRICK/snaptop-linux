From fb832ec6275ccdbd95cb6cb209d3924697541899 Mon Sep 17 00:00:00 2001
From: permissionBRICK <40219477+permissionBRICK@users.noreply.github.com>
Date: Sat, 14 Nov 2026 21:27:32 +0000
Subject: [PATCH] irqchip/gic-v3: save and restore the SPI trigger types across
 hibernation

The kernel that loads a hibernation image sets the distributor up afresh: gic_dist_init() -> gic_dist_config()
makes every SPI level-triggered and disables it, and only the interrupts that kernel's own drivers request get
their type set again. The restored kernel wrote the type of an interrupt once, when it was requested
(__setup_irq() / irq_create_fwspec_mapping()), and resume_irq() only unmasks it. So an edge-triggered SPI whose
driver the loading kernel does not bind stays level-triggered after the restore, and a short pulse on it is lost.

On the X1E80100 every CAMSS interrupt (CSID, CSIPHY, VFE) is an edge-triggered SPI and qcom-camss is not in the
initramfs: after a restore the first CSID reset waits for its reset-done interrupt in vain ("CSID reset timeout",
"Failed to power up pipeline: -5"), while the CCI, whose driver the loading kernel does bind, keeps working.

During a hibernation (PM notifier) save GICD_ICFGR and GICD_ISENABLER of all SPIs and extended SPIs in a syscore
suspend callback, right before the snapshot, and write them back in syscore resume, which runs in the restored
kernel right after the jump, before any device is restored. The SPIs are disabled while their configuration is
written. Suspend to RAM is left alone.

Not upstream.
---
 drivers/irqchip/irq-gic-v3.c | 105 +++++++++++++++++++++++++++++++++++
 1 file changed, 105 insertions(+)

diff --git a/drivers/irqchip/irq-gic-v3.c b/drivers/irqchip/irq-gic-v3.c
index 6e1fa5b24..19965c8b7 100644
--- a/drivers/irqchip/irq-gic-v3.c
+++ b/drivers/irqchip/irq-gic-v3.c
@@ -21,6 +21,8 @@
 #include <linux/refcount.h>
 #include <linux/slab.h>
 #include <linux/iopoll.h>
+#include <linux/suspend.h>
+#include <linux/syscore_ops.h>
 
 #include <linux/irqchip.h>
 #include <linux/irqchip/arm-gic-common.h>
@@ -1504,6 +1506,108 @@ static void gic_cpu_pm_init(void)
 static inline void gic_cpu_pm_init(void) { }
 #endif /* CONFIG_CPU_PM */
 
+#ifdef CONFIG_HIBERNATION
+/*
+ * Hibernation: the kernel that loads the image sets the distributor up afresh
+ * (gic_dist_init(): every SPI disabled and level-triggered) and configures only
+ * the interrupts its own drivers request. The restored kernel wrote the trigger
+ * type of an interrupt once, when it was requested, and never writes it again:
+ * an edge-triggered SPI whose driver the loading kernel does not bind stays
+ * level-triggered after the restore, and a short pulse on it is lost (CAMSS:
+ * "CSID reset timeout"). Save the trigger configuration and the enable bits of
+ * all SPIs right before the snapshot and write them back in syscore_resume(),
+ * which in the restored kernel runs right after the jump, before any device is
+ * restored. Only during a hibernation (PM notifier); suspend is left alone.
+ */
+#define GIC_HIB_NR_IRQS		1024
+
+static bool gic_hibernating;
+static u32 gic_hib_cfg[GIC_HIB_NR_IRQS / 16];
+static u32 gic_hib_en[GIC_HIB_NR_IRQS / 32];
+static u32 gic_hib_cfg_e[GIC_HIB_NR_IRQS / 16];
+static u32 gic_hib_en_e[GIC_HIB_NR_IRQS / 32];
+
+static int gic_hib_pm_notify(struct notifier_block *nb, unsigned long action,
+			     void *data)
+{
+	if (action == PM_HIBERNATION_PREPARE)
+		gic_hibernating = true;
+	else if (action == PM_POST_HIBERNATION)
+		gic_hibernating = false;
+
+	return NOTIFY_OK;
+}
+
+static struct notifier_block gic_hib_pm_nb = {
+	.notifier_call = gic_hib_pm_notify,
+};
+
+static int gic_hib_syscore_suspend(void *data)
+{
+	void __iomem *base = gic_data.dist_base;
+	unsigned int i;
+
+	if (!gic_hibernating)
+		return 0;
+
+	for (i = 32; i < GIC_LINE_NR; i += 16)
+		gic_hib_cfg[i / 16] = readl_relaxed(base + GICD_ICFGR + i / 4);
+	for (i = 32; i < GIC_LINE_NR; i += 32)
+		gic_hib_en[i / 32] = readl_relaxed(base + GICD_ISENABLER + i / 8);
+
+	for (i = 0; i < GIC_ESPI_NR; i += 16)
+		gic_hib_cfg_e[i / 16] = readl_relaxed(base + GICD_ICFGRnE + i / 4);
+	for (i = 0; i < GIC_ESPI_NR; i += 32)
+		gic_hib_en_e[i / 32] = readl_relaxed(base + GICD_ISENABLERnE + i / 8);
+
+	return 0;
+}
+
+static void gic_hib_syscore_resume(void *data)
+{
+	void __iomem *base = gic_data.dist_base;
+	unsigned int i;
+
+	if (!gic_hibernating)
+		return;
+
+	/* The trigger type of an enabled interrupt must not change */
+	for (i = 32; i < GIC_LINE_NR; i += 32)
+		writel_relaxed(~0U, base + GICD_ICENABLER + i / 8);
+	for (i = 0; i < GIC_ESPI_NR; i += 32)
+		writel_relaxed(~0U, base + GICD_ICENABLERnE + i / 8);
+	gic_dist_wait_for_rwp();
+
+	for (i = 32; i < GIC_LINE_NR; i += 16)
+		writel_relaxed(gic_hib_cfg[i / 16], base + GICD_ICFGR + i / 4);
+	for (i = 0; i < GIC_ESPI_NR; i += 16)
+		writel_relaxed(gic_hib_cfg_e[i / 16], base + GICD_ICFGRnE + i / 4);
+
+	for (i = 32; i < GIC_LINE_NR; i += 32)
+		writel_relaxed(gic_hib_en[i / 32], base + GICD_ISENABLER + i / 8);
+	for (i = 0; i < GIC_ESPI_NR; i += 32)
+		writel_relaxed(gic_hib_en_e[i / 32], base + GICD_ISENABLERnE + i / 8);
+	gic_dist_wait_for_rwp();
+}
+
+static const struct syscore_ops gic_hib_syscore_ops = {
+	.suspend = gic_hib_syscore_suspend,
+	.resume = gic_hib_syscore_resume,
+};
+
+static struct syscore gic_hib_syscore = {
+	.ops = &gic_hib_syscore_ops,
+};
+
+static void __init gic_hibernation_init(void)
+{
+	register_syscore(&gic_hib_syscore);
+	register_pm_notifier(&gic_hib_pm_nb);
+}
+#else
+static inline void gic_hibernation_init(void) { }
+#endif /* CONFIG_HIBERNATION */
+
 static struct irq_chip gic_chip = {
 	.name			= "GICv3",
 	.irq_mask		= gic_mask_irq,
@@ -2050,6 +2154,7 @@ static int __init gic_init_bases(phys_addr_t dist_phys_base,
 	gic_enable_nmi_support();
 	gic_smp_init();
 	gic_cpu_pm_init();
+	gic_hibernation_init();
 
 	if (gic_dist_supports_lpis()) {
 		its_init(handle, &gic_data.rdists, gic_data.domain, dist_prio_irq);
-- 
2.43.0

