From bcbbb89dbacda7727946b6f222147b0c91cc6086 Mon Sep 17 00:00:00 2001
From: permissionBRICK <40219477+permissionBRICK@users.noreply.github.com>
Date: Sat, 14 Nov 2026 16:49:36 +0000
Subject: [PATCH] pinctrl: qcom: save and restore the GPIO registers across
 hibernation

The SoC is powered off for hibernation, and the kernel that loads the image configures only the pins its own drivers
use. On the ASUS Vivobook S 15 (X1E80100) the EC's interrupt line (GPIO 66, bias-pull-up in its pin state) was left
at the firmware default after the restore, and its interrupt fired without end ("Unknown EC event: 0", over a
thousand per second). Save ctl, io, intr_cfg and intr_target of every valid GPIO in .freeze_noirq and write them
back in .restore_noirq, before the consumers are restored. X1E80100 gets PM ops with only these two callbacks, so
suspend is unchanged; the SoCs that already use msm_pinctrl_dev_pm_ops get them too.

Not upstream.
---
 drivers/pinctrl/qcom/pinctrl-msm.c      | 79 ++++++++++++++++++++++++-
 drivers/pinctrl/qcom/pinctrl-msm.h      |  1 +
 drivers/pinctrl/qcom/pinctrl-x1e80100.c |  1 +
 3 files changed, 79 insertions(+), 2 deletions(-)

diff --git a/drivers/pinctrl/qcom/pinctrl-msm.c b/drivers/pinctrl/qcom/pinctrl-msm.c
index 27f06bbc1..8297777d3 100644
--- a/drivers/pinctrl/qcom/pinctrl-msm.c
+++ b/drivers/pinctrl/qcom/pinctrl-msm.c
@@ -80,6 +80,9 @@ struct msm_pinctrl {
 	const struct msm_pinctrl_soc_data *soc;
 	void __iomem *regs[MAX_NR_TILES];
 	u32 phys_base[MAX_NR_TILES];
+
+	/* GPIO registers saved before a hibernation snapshot: ctl, io, intr_cfg, intr_target per GPIO */
+	u32 *hib_regs;
 };
 
 #define MSM_ACCESSOR(name) \
@@ -1583,8 +1586,78 @@ static __maybe_unused int msm_pinctrl_resume(struct device *dev)
 	return pinctrl_force_default(pctrl->pctrl);
 }
 
-SIMPLE_DEV_PM_OPS(msm_pinctrl_dev_pm_ops, msm_pinctrl_suspend,
-		  msm_pinctrl_resume);
+/*
+ * Hibernation: the SoC is powered off, and the kernel that loads the image configures only the pins its own drivers
+ * use (an interrupt line with its pull-up left at the firmware default fired without end afterwards). Save every
+ * GPIO's registers right before the snapshot and write them back on restore, before the devices are restored.
+ */
+static __maybe_unused int msm_pinctrl_freeze_noirq(struct device *dev)
+{
+	struct msm_pinctrl *pctrl = dev_get_drvdata(dev);
+	const struct msm_pingroup *g;
+	u32 *r = pctrl->hib_regs;
+	unsigned int i;
+
+	if (!r)
+		return 0;
+
+	for (i = 0; i < pctrl->soc->ngpios; i++, r += 4) {
+		if (!gpiochip_line_is_valid(&pctrl->chip, i))
+			continue;
+		g = &pctrl->soc->groups[i];
+		r[0] = msm_readl_ctl(pctrl, g);
+		r[1] = msm_readl_io(pctrl, g);
+		r[2] = msm_readl_intr_cfg(pctrl, g);
+		r[3] = msm_readl_intr_target(pctrl, g);
+	}
+
+	return 0;
+}
+
+static __maybe_unused int msm_pinctrl_restore_noirq(struct device *dev)
+{
+	struct msm_pinctrl *pctrl = dev_get_drvdata(dev);
+	const struct msm_pingroup *g;
+	u32 *r = pctrl->hib_regs;
+	unsigned long flags;
+	unsigned int i;
+
+	if (!r)
+		return 0;
+
+	raw_spin_lock_irqsave(&pctrl->lock, flags);
+	for (i = 0; i < pctrl->soc->ngpios; i++, r += 4) {
+		if (!gpiochip_line_is_valid(&pctrl->chip, i))
+			continue;
+		g = &pctrl->soc->groups[i];
+		/* output level before output enable, interrupt routing before its configuration */
+		msm_writel_io(r[1], pctrl, g);
+		msm_writel_ctl(r[0], pctrl, g);
+		if (g->intr_target_reg)
+			msm_writel_intr_target(r[3], pctrl, g);
+		msm_writel_intr_cfg(r[2], pctrl, g);
+	}
+	raw_spin_unlock_irqrestore(&pctrl->lock, flags);
+
+	return 0;
+}
+
+const struct dev_pm_ops msm_pinctrl_dev_pm_ops = {
+	SET_SYSTEM_SLEEP_PM_OPS(msm_pinctrl_suspend, msm_pinctrl_resume)
+#ifdef CONFIG_PM_SLEEP
+	.freeze_noirq = msm_pinctrl_freeze_noirq,
+	.restore_noirq = msm_pinctrl_restore_noirq,
+#endif
+};
+
+/* Only the hibernation save/restore, for SoCs that need nothing at suspend */
+const struct dev_pm_ops msm_pinctrl_hibernate_pm_ops = {
+#ifdef CONFIG_PM_SLEEP
+	.freeze_noirq = msm_pinctrl_freeze_noirq,
+	.restore_noirq = msm_pinctrl_restore_noirq,
+#endif
+};
+EXPORT_SYMBOL(msm_pinctrl_hibernate_pm_ops);
 
 EXPORT_SYMBOL(msm_pinctrl_dev_pm_ops);
 
@@ -1603,6 +1676,8 @@ int msm_pinctrl_probe(struct platform_device *pdev,
 
 	pctrl->dev = &pdev->dev;
 	pctrl->soc = soc_data;
+	/* not fatal: without it a restore from hibernation keeps the TLMM state of the kernel that loaded the image */
+	pctrl->hib_regs = devm_kcalloc(&pdev->dev, soc_data->ngpios * 4, sizeof(u32), GFP_KERNEL);
 	pctrl->chip = msm_gpio_template;
 	pctrl->intr_target_use_scm = of_device_is_compatible(
 					pctrl->dev->of_node,
diff --git a/drivers/pinctrl/qcom/pinctrl-msm.h b/drivers/pinctrl/qcom/pinctrl-msm.h
index b94ba1a41..a34a4c28a 100644
--- a/drivers/pinctrl/qcom/pinctrl-msm.h
+++ b/drivers/pinctrl/qcom/pinctrl-msm.h
@@ -187,6 +187,7 @@ struct msm_pinctrl_soc_data {
 };
 
 extern const struct dev_pm_ops msm_pinctrl_dev_pm_ops;
+extern const struct dev_pm_ops msm_pinctrl_hibernate_pm_ops;
 
 int msm_pinctrl_probe(struct platform_device *pdev,
 		      const struct msm_pinctrl_soc_data *soc_data);
diff --git a/drivers/pinctrl/qcom/pinctrl-x1e80100.c b/drivers/pinctrl/qcom/pinctrl-x1e80100.c
index e4c0abcd9..f6f891d55 100644
--- a/drivers/pinctrl/qcom/pinctrl-x1e80100.c
+++ b/drivers/pinctrl/qcom/pinctrl-x1e80100.c
@@ -1853,6 +1853,7 @@ MODULE_DEVICE_TABLE(of, x1e80100_pinctrl_of_match);
 
 static struct platform_driver x1e80100_pinctrl_driver = {
 	.driver = {
+		.pm = &msm_pinctrl_hibernate_pm_ops,
 		.name = "x1e80100-tlmm",
 		.of_match_table = x1e80100_pinctrl_of_match,
 	},
-- 
2.43.0

