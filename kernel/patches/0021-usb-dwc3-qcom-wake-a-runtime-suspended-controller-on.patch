+#include <linux/pm_runtime.h>
 #include <linux/usb/of.h>
 #include <linux/reset.h>
 #include <linux/iopoll.h>
@@ -27,6 +30,15 @@
 #define UTMI_OTG_VBUS_VALID			BIT(20)
 #define SW_SESSVLD_SEL				BIT(28)
 
+/*
+ * Written by the Windows xHCI filter of X1E80100 laptops before the controller
+ * leaves D0 (status cleared, bit 12 + port index set) and undone in D0 entry.
+ * Older downstream kernels call these ALT_INTERRUPT_EN / HS_PHY_IRQ_STAT; the
+ * meaning of bits 12/13 is not documented.
+ */
+#define QSCRATCH_ALT_INTERRUPT_EN		0x20
+#define QSCRATCH_HS_PHY_IRQ_STAT		0x24
+
 #define QSCRATCH_SS_PHY_CTRL			0x30
 #define LANE0_PWR_PRESENT			BIT(24)
 
@@ -35,8 +47,42 @@
 #define PIPE3_PHYSTATUS_SW			BIT(3)
 #define PIPE_UTMI_CLK_DIS			BIT(8)
 
+#define PWR_EVNT_POWERDOWN_OUT_P3_MASK		BIT(3)
 #define PWR_EVNT_LPM_IN_L2_MASK			BIT(4)
 #define PWR_EVNT_LPM_OUT_L2_MASK		BIT(5)
+#define PWR_EVNT_LPM_OUT_RX_ELECIDLE_MASK	BIT(12)
+
+/* The interrupt enable ("mask", 1 = enabled) register follows each status register */
+#define PWR_EVNT_IRQ_MASK_OFFSET		0x4
+
+/*
+ * Runtime suspend options (read at every runtime suspend, so they can be
+ * changed through /sys/module/dwc3_qcom/parameters/ for A/B tests).
+ */
+static bool runtime_sleep_clk = true;
+module_param(runtime_sleep_clk, bool, 0644);
+MODULE_PARM_DESC(runtime_sleep_clk,
+		 "Keep the controller sleep (suspend) clock running in runtime suspend");
+
+static bool runtime_pwr_event;
+module_param(runtime_pwr_event, bool, 0644);
+MODULE_PARM_DESC(runtime_pwr_event,
+		 "Use the pwr_event interrupt (PHY L2/P3 exit) as runtime wakeup source");
+
+static bool runtime_alt_irq;
+module_param(runtime_alt_irq, bool, 0644);
+MODULE_PARM_DESC(runtime_alt_irq,
+		 "Set QSCRATCH 0x20 bit 12+port in runtime suspend like the Windows driver (experimental)");
+
+static unsigned int wake_hold_ms = 500;
+module_param(wake_hold_ms, uint, 0644);
+MODULE_PARM_DESC(wake_hold_ms,
+		 "Keep the xHCI host running this long after a wakeup interrupt (0 = off)");
+
+static int eusb2_wake = -1;
+module_param(eusb2_wake, int, 0644);
+MODULE_PARM_DESC(eusb2_wake,
+		 "eUSB2 wakeup line selection for connected devices: -1 auto (PHY compatible), 0 off, 1 on");
 
 #define SDM845_QSCRATCH_BASE_OFFSET		0xf8800
 #define SDM845_QSCRATCH_SIZE			0x400
@@ -65,7 +111,10 @@ struct dwc3_qcom_port {
 	int			dp_hs_phy_irq;
 	int			dm_hs_phy_irq;
 	int			ss_phy_irq;
+	int			pwr_event_irq;
 	enum usb_device_speed	usb2_speed;
+	bool			dp_armed;
+	bool			dm_armed;
 };
 
 struct dwc3_qcom {
@@ -85,6 +134,13 @@ struct dwc3_qcom {
 	struct icc_path		*icc_path_apps;
 
 	enum usb_role		current_role;
+
+	bool			has_eusb2_phy;
+	struct clk		*sleep_clk;	/* "sleep" entry of clks, may be NULL */
+	bool			sleep_clk_on;	/* left running across runtime suspend */
+	bool			pwr_event_armed;	/* QSCRATCH enable bits written */
+	bool			pwr_event_irq_on;	/* pwr_event IRQs enabled */
+	bool			alt_irq_armed;
 };
 
 #define to_dwc3_qcom(d) container_of((d), struct dwc3_qcom, dwc)
@@ -128,10 +184,44 @@ static void dwc3_qcom_vbus_override_enable(struct dwc3_qcom *qcom, bool enable)
 	}
 }
 
+/*
+ * usb-ddr vote. The defaults stay (1000/2500 MBps SS, 240/700 MBps HS); with
+ * icc_windows_bw the values the Windows power plugin of X1E80100 laptops votes
+ * in D0 are used instead (0x28000000 B/s SS, 0x3938700 B/s HS, avg = peak).
+ * Read when the vote is (re)enabled, i.e. at probe and every runtime resume.
+ */
+static bool icc_windows_bw;
+module_param(icc_windows_bw, bool, 0644);
+MODULE_PARM_DESC(icc_windows_bw,
+		 "Vote the DDR bandwidth the Windows driver votes (671/60 MB/s) instead of 1000-2500/240-700 MBps");
+
+static int dwc3_qcom_set_ddr_bw(struct dwc3_qcom *qcom)
+{
+	enum usb_device_speed max_speed = usb_get_maximum_speed(qcom->dwc.dev);
+	bool ss = max_speed >= USB_SPEED_SUPER || max_speed == USB_SPEED_UNKNOWN;
+
+	if (icc_windows_bw) {
+		u32 bw = ss ? Bps_to_icc(0x28000000) : Bps_to_icc(0x3938700);
+
+		return icc_set_bw(qcom->icc_path_ddr, bw, bw);
+	}
+
+	if (ss)
+		return icc_set_bw(qcom->icc_path_ddr,
+				  USB_MEMORY_AVG_SS_BW, USB_MEMORY_PEAK_SS_BW);
+
+	return icc_set_bw(qcom->icc_path_ddr,
+			  USB_MEMORY_AVG_HS_BW, USB_MEMORY_PEAK_HS_BW);
+}
+
 static int dwc3_qcom_interconnect_enable(struct dwc3_qcom *qcom)
 {
 	int ret;
 
+	ret = dwc3_qcom_set_ddr_bw(qcom);
+	if (ret)
+		dev_warn(qcom->dev, "failed to set usb-ddr bandwidth: %d\n", ret);
+
 	ret = icc_enable(qcom->icc_path_ddr);
 	if (ret)
 		return ret;
@@ -166,7 +256,6 @@ static int dwc3_qcom_interconnect_disable(struct dwc3_qcom *qcom)
  */
 static int dwc3_qcom_interconnect_init(struct dwc3_qcom *qcom)
 {
-	enum usb_device_speed max_speed;
 	struct device *dev = qcom->dev;
 	int ret;
 
@@ -183,14 +272,7 @@ static int dwc3_qcom_interconnect_init(struct dwc3_qcom *qcom)
 		goto put_path_ddr;
 	}
 
-	max_speed = usb_get_maximum_speed(qcom->dwc.dev);
-	if (max_speed >= USB_SPEED_SUPER || max_speed == USB_SPEED_UNKNOWN) {
-		ret = icc_set_bw(qcom->icc_path_ddr,
-				USB_MEMORY_AVG_SS_BW, USB_MEMORY_PEAK_SS_BW);
-	} else {
-		ret = icc_set_bw(qcom->icc_path_ddr,
-				USB_MEMORY_AVG_HS_BW, USB_MEMORY_PEAK_HS_BW);
-	}
+	ret = dwc3_qcom_set_ddr_bw(qcom);
 	if (ret) {
 		dev_err(dev, "failed to set bandwidth for usb-ddr path: %d\n", ret);
 		goto put_path_apps;
@@ -272,49 +354,79 @@ static void dwc3_qcom_disable_wakeup_irq(int irq)
 	disable_irq_nosync(irq);
 }
 
-static void dwc3_qcom_disable_port_interrupts(struct dwc3_qcom_port *port)
+static bool dwc3_qcom_eusb2(struct dwc3_qcom *qcom)
 {
-	dwc3_qcom_disable_wakeup_irq(port->qusb2_phy_irq);
+	if (eusb2_wake >= 0)
+		return eusb2_wake;
+
+	return qcom->has_eusb2_phy;
+}
+
+/*
+ * Which DP/DM wakeup line to arm for a port. Without a device both lines
+ * (rising edge) to catch a connect. With a device attached, a classic USB2
+ * PHY sees disconnect and remote wakeup as a falling edge on DP (HS/FS) or DM
+ * (LS). Behind an eUSB2 repeater the repeater drives eD- high on a K state of
+ * a HS/FS device and eD+ high for a LS device (eUSB2 spec 5.5.14/5.5.15), so
+ * it is the other line, rising. The Windows driver of X1E80100 laptops arms
+ * the same lines (DP only for LS, DM only for HS/FS, both without a device).
+ */
+static void dwc3_qcom_port_wake_lines(struct dwc3_qcom *qcom,
+				      struct dwc3_qcom_port *port,
+				      int *dp_type, int *dm_type)
+{
+	bool eusb2 = dwc3_qcom_eusb2(qcom);
+
+	*dp_type = 0;
+	*dm_type = 0;
 
 	if (port->usb2_speed == USB_SPEED_LOW) {
-		dwc3_qcom_disable_wakeup_irq(port->dm_hs_phy_irq);
+		if (eusb2)
+			*dp_type = IRQ_TYPE_EDGE_RISING;
+		else
+			*dm_type = IRQ_TYPE_EDGE_FALLING;
 	} else if ((port->usb2_speed == USB_SPEED_HIGH) ||
 			(port->usb2_speed == USB_SPEED_FULL)) {
-		dwc3_qcom_disable_wakeup_irq(port->dp_hs_phy_irq);
+		if (eusb2)
+			*dm_type = IRQ_TYPE_EDGE_RISING;
+		else
+			*dp_type = IRQ_TYPE_EDGE_FALLING;
 	} else {
+		*dp_type = IRQ_TYPE_EDGE_RISING;
+		*dm_type = IRQ_TYPE_EDGE_RISING;
+	}
+}
+
+static void dwc3_qcom_disable_port_interrupts(struct dwc3_qcom *qcom,
+					      struct dwc3_qcom_port *port)
+{
+	dwc3_qcom_disable_wakeup_irq(port->qusb2_phy_irq);
+
+	/* exactly the lines dwc3_qcom_enable_port_interrupts() armed */
+	if (port->dp_armed)
 		dwc3_qcom_disable_wakeup_irq(port->dp_hs_phy_irq);
+	if (port->dm_armed)
 		dwc3_qcom_disable_wakeup_irq(port->dm_hs_phy_irq);
-	}
+	port->dp_armed = false;
+	port->dm_armed = false;
 
 	dwc3_qcom_disable_wakeup_irq(port->ss_phy_irq);
 }
 
-static void dwc3_qcom_enable_port_interrupts(struct dwc3_qcom_port *port)
+static void dwc3_qcom_enable_port_interrupts(struct dwc3_qcom *qcom,
+					     struct dwc3_qcom_port *port)
 {
-	dwc3_qcom_enable_wakeup_irq(port->qusb2_phy_irq, 0);
+	int dp_type, dm_type;
 
-	/*
-	 * Configure DP/DM line interrupts based on the USB2 device attached to
-	 * the root hub port. When HS/FS device is connected, configure the DP line
-	 * as falling edge to detect both disconnect and remote wakeup scenarios. When
-	 * LS device is connected, configure DM line as falling edge to detect both
-	 * disconnect and remote wakeup. When no device is connected, configure both
-	 * DP and DM lines as rising edge to detect HS/HS/LS device connect scenario.
-	 */
+	dwc3_qcom_enable_wakeup_irq(port->qusb2_phy_irq, 0);
 
-	if (port->usb2_speed == USB_SPEED_LOW) {
-		dwc3_qcom_enable_wakeup_irq(port->dm_hs_phy_irq,
-					    IRQ_TYPE_EDGE_FALLING);
-	} else if ((port->usb2_speed == USB_SPEED_HIGH) ||
-			(port->usb2_speed == USB_SPEED_FULL)) {
-		dwc3_qcom_enable_wakeup_irq(port->dp_hs_phy_irq,
-					    IRQ_TYPE_EDGE_FALLING);
-	} else {
-		dwc3_qcom_enable_wakeup_irq(port->dp_hs_phy_irq,
-					    IRQ_TYPE_EDGE_RISING);
-		dwc3_qcom_enable_wakeup_irq(port->dm_hs_phy_irq,
-					    IRQ_TYPE_EDGE_RISING);
-	}
+	dwc3_qcom_port_wake_lines(qcom, port, &dp_type, &dm_type);
+	if (dp_type)
+		dwc3_qcom_enable_wakeup_irq(port->dp_hs_phy_irq, dp_type);
+	if (dm_type)
+		dwc3_qcom_enable_wakeup_irq(port->dm_hs_phy_irq, dm_type);
+	port->dp_armed = dp_type;
+	port->dm_armed = dm_type;
 
 	dwc3_qcom_enable_wakeup_irq(port->ss_phy_irq, 0);
 }
@@ -324,7 +436,7 @@ static void dwc3_qcom_disable_interrupts(struct dwc3_qcom *qcom)
 	int i;
 
 	for (i = 0; i < qcom->num_ports; i++)
-		dwc3_qcom_disable_port_interrupts(&qcom->ports[i]);
+		dwc3_qcom_disable_port_interrupts(qcom, &qcom->ports[i]);
 }
 
 static void dwc3_qcom_enable_interrupts(struct dwc3_qcom *qcom)
@@ -332,11 +444,140 @@ static void dwc3_qcom_enable_interrupts(struct dwc3_qcom *qcom)
 	int i;
 
 	for (i = 0; i < qcom->num_ports; i++)
-		dwc3_qcom_enable_port_interrupts(&qcom->ports[i]);
+		dwc3_qcom_enable_port_interrupts(qcom, &qcom->ports[i]);
 }
 
-static int dwc3_qcom_suspend(struct dwc3_qcom *qcom, bool wakeup)
+/*
+ * pwr_event is a plain GIC interrupt (no PDC), so it can only end a runtime
+ * suspend, not a system suspend; it is never armed as a system wakeup source.
+ */
+static void dwc3_qcom_pwr_event_irqs(struct dwc3_qcom *qcom, bool on)
 {
+	int i;
+
+	if (qcom->pwr_event_irq_on == on)
+		return;
+
+	for (i = 0; i < qcom->num_ports; i++) {
+		if (!qcom->ports[i].pwr_event_irq)
+			continue;
+		if (on)
+			enable_irq(qcom->ports[i].pwr_event_irq);
+		else
+			disable_irq_nosync(qcom->ports[i].pwr_event_irq);
+	}
+
+	qcom->pwr_event_irq_on = on;
+}
+
+/* Called with the clocks still on, before a runtime suspend */
+static void dwc3_qcom_arm_pwr_event(struct dwc3_qcom *qcom)
+{
+	struct dwc3 *dwc = &qcom->dwc;
+	u32 reg, val;
+	int i;
+
+	for (i = 0; i < qcom->num_ports; i++) {
+		if (!qcom->ports[i].pwr_event_irq)
+			continue;
+
+		reg = pwr_evnt_irq_stat_reg[i];
+		/* write-1-to-clear whatever is pending (the L2 entry bit at least) */
+		writel(readl(qcom->qscratch_base + reg), qcom->qscratch_base + reg);
+
+		val = PWR_EVNT_LPM_OUT_L2_MASK;
+		if (i < dwc->num_usb3_ports && dwc->usb3_generic_phy[i])
+			val |= PWR_EVNT_POWERDOWN_OUT_P3_MASK |
+			       PWR_EVNT_LPM_OUT_RX_ELECIDLE_MASK;
+		writel(val, qcom->qscratch_base + reg + PWR_EVNT_IRQ_MASK_OFFSET);
+		qcom->pwr_event_armed = true;
+	}
+}
+
+/* Called with the clocks on again */
+static void dwc3_qcom_disarm_pwr_event(struct dwc3_qcom *qcom)
+{
+	u32 reg;
+	int i;
+
+	if (!qcom->pwr_event_armed)
+		return;
+
+	for (i = 0; i < qcom->num_ports; i++) {
+		if (!qcom->ports[i].pwr_event_irq)
+			continue;
+		reg = pwr_evnt_irq_stat_reg[i];
+		writel(0, qcom->qscratch_base + reg + PWR_EVNT_IRQ_MASK_OFFSET);
+		writel(readl(qcom->qscratch_base + reg), qcom->qscratch_base + reg);
+	}
+
+	qcom->pwr_event_armed = false;
+}
+
+static u32 dwc3_qcom_alt_irq_bits(struct dwc3_qcom *qcom)
+{
+	return GENMASK(12 + min_t(int, qcom->num_ports, 2) - 1, 12);
+}
+
+static void dwc3_qcom_arm_alt_irq(struct dwc3_qcom *qcom)
+{
+	void __iomem *base = qcom->qscratch_base;
+
+	writel(readl(base + QSCRATCH_HS_PHY_IRQ_STAT), base + QSCRATCH_HS_PHY_IRQ_STAT);
+	dwc3_qcom_setbits(base, QSCRATCH_ALT_INTERRUPT_EN, dwc3_qcom_alt_irq_bits(qcom));
+	qcom->alt_irq_armed = true;
+}
+
+static void dwc3_qcom_disarm_alt_irq(struct dwc3_qcom *qcom)
+{
+	void __iomem *base = qcom->qscratch_base;
+
+	if (!qcom->alt_irq_armed)
+		return;
+
+	writel(readl(base + QSCRATCH_HS_PHY_IRQ_STAT), base + QSCRATCH_HS_PHY_IRQ_STAT);
+	dwc3_qcom_clrbits(base, QSCRATCH_ALT_INTERRUPT_EN, dwc3_qcom_alt_irq_bits(qcom));
+	qcom->alt_irq_armed = false;
+}
+
+static void dwc3_qcom_clks_disable(struct dwc3_qcom *qcom, bool keep_sleep)
+{
+	int i;
+
+	for (i = qcom->num_clocks - 1; i >= 0; i--) {
+		if (keep_sleep && qcom->clks[i].clk == qcom->sleep_clk)
+			continue;
+		clk_disable_unprepare(qcom->clks[i].clk);
+	}
+}
+
+static int dwc3_qcom_clks_enable(struct dwc3_qcom *qcom, bool skip_sleep)
+{
+	int i, ret;
+
+	for (i = 0; i < qcom->num_clocks; i++) {
+		if (skip_sleep && qcom->clks[i].clk == qcom->sleep_clk)
+			continue;
+		ret = clk_prepare_enable(qcom->clks[i].clk);
+		if (ret)
+			goto err;
+	}
+
+	return 0;
+
+err:
+	while (--i >= 0) {
+		if (skip_sleep && qcom->clks[i].clk == qcom->sleep_clk)
+			continue;
+		clk_disable_unprepare(qcom->clks[i].clk);
+	}
+
+	return ret;
+}
+
+static int dwc3_qcom_suspend(struct dwc3_qcom *qcom, bool wakeup, bool runtime)
+{
+	bool runtime_wake;
 	u32 val;
 	int i, ret;
 
@@ -348,7 +589,25 @@ static int dwc3_qcom_suspend(struct dwc3_qcom *qcom, bool wakeup)
 		if (!(val & PWR_EVNT_LPM_IN_L2_MASK))
 			dev_err(qcom->dev, "port-%d HS-PHY not in L2\n", i + 1);
 	}
-	clk_bulk_disable_unprepare(qcom->num_clocks, qcom->clks);
+
+	/*
+	 * Extra runtime wakeup sources, as the Windows driver of X1E80100
+	 * laptops sets them up before the controller leaves D0. They need the
+	 * clocks, so they are set before the clocks go off.
+	 */
+	runtime_wake = runtime && wakeup && dwc3_qcom_is_host(qcom);
+	if (runtime_wake && runtime_pwr_event)
+		dwc3_qcom_arm_pwr_event(qcom);
+	if (runtime_wake && runtime_alt_irq)
+		dwc3_qcom_arm_alt_irq(qcom);
+
+	/*
+	 * The Windows power plugin keeps the GDSC and the sleep clock on in the
+	 * idle states it uses with wakeup (D1/D2) and switches the sleep clock
+	 * off only for D3 (power collapse).
+	 */
+	qcom->sleep_clk_on = runtime_wake && runtime_sleep_clk && qcom->sleep_clk;
+	dwc3_qcom_clks_disable(qcom, qcom->sleep_clk_on);
 
 	ret = dwc3_qcom_interconnect_disable(qcom);
 	if (ret)
@@ -364,6 +623,9 @@ static int dwc3_qcom_suspend(struct dwc3_qcom *qcom, bool wakeup)
 		dwc3_qcom_enable_interrupts(qcom);
 	}
 
+	if (qcom->pwr_event_armed)
+		dwc3_qcom_pwr_event_irqs(qcom, true);
+
 	qcom->is_suspended = true;
 
 	return 0;
@@ -377,17 +639,23 @@ static int dwc3_qcom_resume(struct dwc3_qcom *qcom, bool wakeup)
 	if (!qcom->is_suspended)
 		return 0;
 
