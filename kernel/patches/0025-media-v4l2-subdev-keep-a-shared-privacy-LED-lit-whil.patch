From 0231d0373def6755952c10fbf18b01ca53a072d7 Mon Sep 17 00:00:00 2001
From: permissionBRICK <40219477+permissionBRICK@users.noreply.github.com>
Date: Sat, 14 Nov 2026 18:22:48 +0000
Subject: [PATCH] media: v4l2-subdev: keep a shared privacy LED lit while any
 of its sensors streams

On the ASUS Vivobook S 15 (X1E80100) one camera indicator LED serves the RGB and the IR sensor, as on Windows,
where the camera platform driver counts its users. The v4l2 core switched the LED off whenever one sensor stopped,
even with the other sensor still streaming, and the first sensor to unregister gave the LED back to sysfs.

Track every sub-device that holds a privacy LED and whether it has the LED on. Switch the LED off only when no other
holder has it on. Only the first holder takes the LED away from sysfs and triggers, and only the last one gives it
back. A sensor that has its own LED behaves as before.

Not upstream.
---
 drivers/media/v4l2-core/v4l2-subdev.c | 145 ++++++++++++++++++++++----
 1 file changed, 124 insertions(+), 21 deletions(-)

diff --git a/drivers/media/v4l2-core/v4l2-subdev.c b/drivers/media/v4l2-core/v4l2-subdev.c
index e9f81b9be..993df69db 100644
--- a/drivers/media/v4l2-core/v4l2-subdev.c
+++ b/drivers/media/v4l2-core/v4l2-subdev.c
@@ -11,8 +11,10 @@
 #include <linux/export.h>
 #include <linux/ioctl.h>
 #include <linux/leds.h>
+#include <linux/list.h>
 #include <linux/mm.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/overflow.h>
 #include <linux/slab.h>
 #include <linux/string.h>
@@ -170,20 +172,85 @@ static int subdev_close(struct file *file)
 }
 #endif /* CONFIG_VIDEO_V4L2_SUBDEV_API */
 
+#if IS_REACHABLE(CONFIG_LEDS_CLASS)
+/*
+ * Several sensors can share one privacy LED, e.g. the RGB and the IR camera of
+ * a laptop. Each sub-device that holds a privacy LED has an entry here, and the
+ * LED stays lit while any of its holders streams.
+ */
+struct v4l2_privacy_led_holder {
+	struct list_head list;
+	struct v4l2_subdev *sd;
+	struct led_classdev *led;
+	bool on;
+};
+
+static DEFINE_MUTEX(v4l2_privacy_led_lock);
+static LIST_HEAD(v4l2_privacy_led_holders);
+
+/* Called with v4l2_privacy_led_lock held. */
+static struct v4l2_privacy_led_holder *
+v4l2_privacy_led_find(struct v4l2_subdev *sd)
+{
+	struct v4l2_privacy_led_holder *h;
+
+	list_for_each_entry(h, &v4l2_privacy_led_holders, list)
+		if (h->sd == sd)
+			return h;
+
+	return NULL;
+}
+
+/*
+ * Called with v4l2_privacy_led_lock held. Returns whether a sub-device other
+ * than @sd holds @led, or with @lit set, whether one has it switched on.
+ */
+static bool v4l2_privacy_led_other_holder(struct led_classdev *led,
+					  struct v4l2_subdev *sd, bool lit)
+{
+	struct v4l2_privacy_led_holder *h;
+
+	list_for_each_entry(h, &v4l2_privacy_led_holders, list)
+		if (h->led == led && h->sd != sd && (!lit || h->on))
+			return true;
+
+	return false;
+}
+
+static void v4l2_subdev_set_privacy_led(struct v4l2_subdev *sd, bool on)
+{
+	struct led_classdev *led = sd->privacy_led;
+	struct v4l2_privacy_led_holder *h;
+
+	if (IS_ERR_OR_NULL(led))
+		return;
+
+	mutex_lock(&v4l2_privacy_led_lock);
+	h = v4l2_privacy_led_find(sd);
+	if (h && h->on == on)
+		goto unlock;
+	if (h)
+		h->on = on;
+	if (on)
+		led_set_brightness(led, led->max_brightness);
+	else if (!v4l2_privacy_led_other_holder(led, sd, true))
+		led_set_brightness(led, 0);
+unlock:
+	mutex_unlock(&v4l2_privacy_led_lock);
+}
+#endif
+
 static void v4l2_subdev_enable_privacy_led(struct v4l2_subdev *sd)
 {
 #if IS_REACHABLE(CONFIG_LEDS_CLASS)
-	if (!IS_ERR_OR_NULL(sd->privacy_led))
-		led_set_brightness(sd->privacy_led,
-				   sd->privacy_led->max_brightness);
+	v4l2_subdev_set_privacy_led(sd, true);
 #endif
 }
 
 static void v4l2_subdev_disable_privacy_led(struct v4l2_subdev *sd)
 {
 #if IS_REACHABLE(CONFIG_LEDS_CLASS)
-	if (!IS_ERR_OR_NULL(sd->privacy_led))
-		led_set_brightness(sd->privacy_led, 0);
+	v4l2_subdev_set_privacy_led(sd, false);
 #endif
 }
 
@@ -2732,18 +2799,39 @@ EXPORT_SYMBOL_GPL(v4l2_subdev_is_streaming);
 int v4l2_subdev_get_privacy_led(struct v4l2_subdev *sd)
 {
 #if IS_REACHABLE(CONFIG_LEDS_CLASS)
-	sd->privacy_led = led_get(sd->dev, "privacy");
-	if (IS_ERR(sd->privacy_led) && PTR_ERR(sd->privacy_led) != -ENOENT)
-		return dev_err_probe(sd->dev, PTR_ERR(sd->privacy_led),
-				     "getting privacy LED\n");
-
-	if (!IS_ERR_OR_NULL(sd->privacy_led)) {
-		mutex_lock(&sd->privacy_led->led_access);
-		led_sysfs_disable(sd->privacy_led);
-		led_trigger_remove(sd->privacy_led);
-		led_set_brightness(sd->privacy_led, 0);
-		mutex_unlock(&sd->privacy_led->led_access);
+	struct v4l2_privacy_led_holder *h;
+	struct led_classdev *led;
+
+	led = led_get(sd->dev, "privacy");
+	if (IS_ERR_OR_NULL(led)) {
+		sd->privacy_led = led;
+		if (IS_ERR(led) && PTR_ERR(led) != -ENOENT)
+			return dev_err_probe(sd->dev, PTR_ERR(led),
+					     "getting privacy LED\n");
+		return 0;
 	}
+
+	h = kzalloc_obj(*h);
+	if (!h) {
+		led_put(led);
+		sd->privacy_led = NULL;
+		return -ENOMEM;
+	}
+	h->sd = sd;
+	h->led = led;
+
+	mutex_lock(&v4l2_privacy_led_lock);
+	/* The first holder takes the LED away from sysfs and triggers. */
+	if (!v4l2_privacy_led_other_holder(led, sd, false)) {
+		mutex_lock(&led->led_access);
+		led_sysfs_disable(led);
+		led_trigger_remove(led);
+		led_set_brightness(led, 0);
+		mutex_unlock(&led->led_access);
+	}
+	list_add_tail(&h->list, &v4l2_privacy_led_holders);
+	sd->privacy_led = led;
+	mutex_unlock(&v4l2_privacy_led_lock);
 #endif
 	return 0;
 }
@@ -2752,12 +2840,27 @@ EXPORT_SYMBOL_GPL(v4l2_subdev_get_privacy_led);
 void v4l2_subdev_put_privacy_led(struct v4l2_subdev *sd)
 {
 #if IS_REACHABLE(CONFIG_LEDS_CLASS)
-	if (!IS_ERR_OR_NULL(sd->privacy_led)) {
-		mutex_lock(&sd->privacy_led->led_access);
-		led_sysfs_enable(sd->privacy_led);
-		mutex_unlock(&sd->privacy_led->led_access);
-		led_put(sd->privacy_led);
+	struct led_classdev *led = sd->privacy_led;
+	struct v4l2_privacy_led_holder *h;
+
+	if (IS_ERR_OR_NULL(led))
+		return;
+
+	mutex_lock(&v4l2_privacy_led_lock);
+	h = v4l2_privacy_led_find(sd);
+	if (h) {
+		list_del(&h->list);
+		kfree(h);
 	}
+	/* The last holder gives the LED back to sysfs. */
+	if (!v4l2_privacy_led_other_holder(led, sd, false)) {
+		mutex_lock(&led->led_access);
+		led_sysfs_enable(led);
+		mutex_unlock(&led->led_access);
+	}
+	sd->privacy_led = NULL;
+	mutex_unlock(&v4l2_privacy_led_lock);
+	led_put(led);
 #endif
 }
 EXPORT_SYMBOL_GPL(v4l2_subdev_put_privacy_led);
-- 
